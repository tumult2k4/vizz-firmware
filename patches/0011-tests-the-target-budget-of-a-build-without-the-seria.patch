From f7fea0f01588ae27f644e55dbf25b2cf9568a88d Mon Sep 17 00:00:00 2001
From: Stefan <kloterstefan@gmail.com>
Date: Wed, 28 Oct 2026 21:05:34 +0000
Subject: [PATCH 11/11] tests: the target budget of a build without the serial
 console (Vizz 2.0's own)

Without the console (FELUCCA_CDC=0: a release, and the FM-1's development build since the producer) the
compiler lays the audio ISR out differently: target_budget.py's static measure sees its loops nest a level
deeper, fm1_alnk0_irq 24 542 against 7 598 with the console, for Vizz 2.0's own code alike.
tests/target_budget_cdc0.txt is Vizz 2.0's cost so built (patch 0005, FELUCCA_CDC=0 ./build.sh);
tests/run_tests.sh holds a build to the budget of its own configuration. Skiff's file stays as it was.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01R1rawnvCsrvDZVbc37ZFUY
---
 tests/run_tests.sh           |  6 ++-
 tests/target_budget_cdc0.txt | 85 ++++++++++++++++++++++++++++++++++++
 2 files changed, 89 insertions(+), 2 deletions(-)
 create mode 100644 tests/target_budget_cdc0.txt

diff --git a/tests/run_tests.sh b/tests/run_tests.sh
index ea9ceb8..e2cc4e3 100755
--- a/tests/run_tests.sh
+++ b/tests/run_tests.sh
@@ -479,8 +479,10 @@ else
     run "ASan/UBSan fuzz: user sample slot headers -> scan -> SAMPLE / GRAIN / SLICE (1000, seed 17)" "$A/fuzz_smp" 1000 17
 fi
 
-run "regression: target cost of the render loops (pi32v2 disassembly)" python3 tests/target_budget.py \
-    build/felucca.dis tests/target_budget.txt
+TB=tests/target_budget.txt                          # ((Vizzbox) a build without the serial console: Vizz 2.0's own
+grep -q '^con_puts:$' build/felucca.dis 2>/dev/null || TB=tests/target_budget_cdc0.txt   # cost so built)
+run "regression: target cost of the render loops (pi32v2 disassembly; $TB)" python3 tests/target_budget.py \
+    build/felucca.dis "$TB"
 
 run "installer CLI (fm1_install.py) against a simulated FM-1" python3 tests/install_test.py
 run "(#21) sample upload CLI: mix (a sound's LEVEL REV DLY) against a fake device" python3 tests/sample_upload_test.py
diff --git a/tests/target_budget_cdc0.txt b/tests/target_budget_cdc0.txt
new file mode 100644
index 0000000..8be7322
--- /dev/null
+++ b/tests/target_budget_cdc0.txt
@@ -0,0 +1,85 @@
