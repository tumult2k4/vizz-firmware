 static uint32_t beat_blocks(void) { return beat_samples() / CTL; }
+static uint32_t cc103(uint32_t ti, uint32_t v)       /* (Vizz) the packet: track ti's mute v on its channel */
+{
+    return 0x0Bu | (0xB0u | trk_midi_ch(ti)) << 8 | SEQ_MUTE_CC << 16 | v << 24;
+}
+static void settle(void) { blocks(1); reset_log(); }  /* a block (what changed while set up sent), the log emptied */
+static void glo_mute(uint32_t ti)                    /* GLO + its black key tapped: a track's MUTE turned (latched) */
