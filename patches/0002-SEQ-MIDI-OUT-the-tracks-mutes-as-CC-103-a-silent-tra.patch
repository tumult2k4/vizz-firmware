+    lay_combo(B_GLO, black(ti));
+    key_up(black(ti));
+    btn_up(B_GLO);
+    frame();
+}
+static void run_ms(uint32_t ms)                      /* the UI's frames (16 ms) and the audio's blocks between them */
+{
+    uint32_t i;
+    for (i = 0; i < ms / 16u; i++) {
+        frame();
+        blocks(16u * 44100u / 1000u / CTL);
+    }
+}
