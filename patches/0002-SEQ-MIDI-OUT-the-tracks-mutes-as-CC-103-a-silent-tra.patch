diff --git a/firmware/src/seq.c b/firmware/src/seq.c
index 4df71dd..fdd3821 100644
--- a/firmware/src/seq.c
+++ b/firmware/src/seq.c
@@ -95,8 +95,24 @@ static uint32_t trk_midi_ch(uint32_t i)            /* MIDI channel 0..15 of trac
 #define SKIFF_SEQ_MIDI 1
 #endif
 #define SEQ_STEP_CC 102u                            /* an undefined controller: harmless to a synth that hears it */
+/* (Vizz, SEQ MIDI OUT) a track's mute as CC SEQ_MUTE_CC on its channel: 127 silent, 0 sounding. Silent is what silences
+ * its sound, as the audio side has it (perform.c perf_begin, perf_mute; ui_layer.c glo_sounding the LEDs): its MUTE
+ * (P_MUTE: GLO's, FX's, PERFORM's black key tapped, the MIXER's; trk_note_on plays nothing), or, unless perf_kill turns
+ * the layers' effects off (the menu, a dialog), a black key held (2.0: the MUTE held, cut only while it is: FX's
+ * perf_held, GLO's and PERFORM's perf_cut) or GLO's SOLO held on another track (perf_solo).
+ * A silent track sends no note-on (its note-offs and its step CC go on); turning silent with notes sent sounding, CC 123
+ * first. Sent when it changes (seq_mute_block compares every block: any source, the keys, a solo, a launch, a load), for
+ * all six at PLAY (after Start), on every bar while playing, when SEQ MIDI OUT turns ON and when USB comes up */
+#define SEQ_MUTE_CC 103u                            /* undefined too (102..119) */
 static volatile uint8_t seq_midi_on = 1;
 #if SKIFF_SEQ_MIDI
+static uint8_t seq_mute_sent[NTRK] __attribute__((section(".pool")));   /* what was sent last: bit 0 silent, bits 1..4
+                                                     * the channel; 0xFF not yet: send it (.pool, zeroed at boot) */
+static int trk_silent(uint32_t ti)
+{
+    uint32_t cut = (perf_held | perf_latched) >> PF_M1 | perf_cut | (perf_solo ? ~(uint32_t)perf_solo : 0u);
+    return trk[ti].p[P_MUTE] != 0 || (!perf_kill && ((cut >> ti) & 1u));
+}
 static uint8_t seq_mo[NTRK][16] __attribute__((section(".pool")));   /* (.pool, zeroed at boot: a new .bss global moves
                                                                         * the others and their code with them) */
 static int seq_mo_any(uint32_t ti)                  /* track ti has notes sent sounding */
@@ -107,6 +123,36 @@ static int seq_mo_any(uint32_t ti)                  /* track ti has notes sent s
     return m != 0u;
 }
 static int seq_mo_has(uint32_t ti, uint32_t note) { return (seq_mo[ti][(note & 0x7Fu) >> 3] >> (note & 7u)) & 1u; }
+static void seq_midi_alloff(uint32_t ti)            /* CC 123 All Notes Off: a panic dropped notes without their offs */
+{
+    if (seq_midi_on)
+        midi_out_event(0x0Bu | (0xB0u | trk_midi_ch(ti)) << 8 | 123u << 16);
+}
+static __attribute__((noinline)) void seq_midi_mute(uint32_t ti, int force)   /* CC SEQ_MUTE_CC when it changed (or
+                                                                                * its channel), or force */
+{
+    uint32_t mc = trk_midi_ch(ti), m = trk_silent(ti) ? 1u : 0u, s = m | mc << 1, was = seq_mute_sent[ti];
+    if (!seq_midi_on) {
+        seq_mute_sent[ti] = 0xFFu;                  /* (OFF: all six again when it turns ON) */
+        return;
+    }
+    if (!force && was == s)
+        return;
+    if (was != 0xFFu && (was >> 1) != mc && seq_mo_any(ti)) {   /* (its channel changed, notes sent sounding: they end
+                                                                 * on the one they sound on) */
+        midi_out_event(0x0Bu | (0xB0u | (was >> 1)) << 8 | 123u << 16);
+        memset(seq_mo[ti], 0, sizeof seq_mo[ti]);
+    } else if (m && was == (s & ~1u) && seq_mo_any(ti))
+        seq_midi_alloff(ti);                        /* sounding until now, notes sent sounding: they end first */
+    midi_out_event(0x0Bu | (0xB0u | mc) << 8 | SEQ_MUTE_CC << 16 | (m ? 127u : 0u) << 24);
+    seq_mute_sent[ti] = (uint8_t)s;
+}
+static void seq_midi_mutes(void)                    /* all six, as they are now */
+{
+    uint32_t i;
+    for (i = 0; i < NTRK; i++)
+        seq_midi_mute(i, 1);
+}
 static __attribute__((noinline)) void seq_midi_note(uint32_t ti, uint32_t note, uint32_t vel)
 {
     uint32_t mc = trk_midi_ch(ti), b = 1u << (note & 7u);
@@ -120,8 +166,10 @@ static __attribute__((noinline)) void seq_midi_note(uint32_t ti, uint32_t note,
         }
         return;
     }
-    if (!seq_midi_on)
+    if (!seq_midi_on || trk_silent(ti))             /* ((Vizz) a silent track: no note-on; its note-offs always) */
         return;
+    seq_midi_mute(ti, 0);                           /* ((Vizz) sounding again within this block, a launch's MUTE: CC 0
+                                                     * first) */
     if (*m & b)                                     /* (still sounding on its channel: ended first) */
         midi_out_event(0x08u | (0x80u | mc) << 8 | note << 16);
     midi_out_event(0x09u | (0x90u | mc) << 8 | note << 16 | (vel & 0x7Fu) << 24);
@@ -132,11 +180,6 @@ static __attribute__((noinline)) void seq_midi_step(uint32_t ti, uint32_t idx)
     if (seq_midi_on)
         midi_out_event(0x0Bu | (0xB0u | trk_midi_ch(ti)) << 8 | SEQ_STEP_CC << 16 | (idx & 0x7Fu) << 24);
 }
-static void seq_midi_alloff(uint32_t ti)            /* CC 123 All Notes Off: a panic dropped notes without their offs */
-{
-    if (seq_midi_on)
-        midi_out_event(0x0Bu | (0xB0u | trk_midi_ch(ti)) << 8 | 123u << 16);
-}
 static __attribute__((noinline)) void seq_midi_drop(uint32_t ti)   /* .. for the notes sent sounding, which are gone */
 {
     if (seq_mo_any(ti))
@@ -158,6 +201,7 @@ static void seq_midi_rt(uint32_t st)                /* a realtime byte: Clock F8
 #define seq_midi_rt(st) ((void)0)
 #define seq_midi_drop(ti) ((void)0)
 #define seq_mo_has(ti, note) 0
+#define seq_midi_mutes() ((void)0)
 #endif
 
 static int drum_track(const track_t *t) { return drum_engine(eng_idx(t->eng_req)); }   /* ((Skiff) DRUM or DRUM-X) */
@@ -1147,6 +1191,31 @@ static __attribute__((noinline)) void seq_clk_block(uint32_t n)
 #define seq_clk_block(n) ((void)0)
 #endif
 
+/* (Vizz, SEQ MIDI OUT) each block, before the tracks tick: CC SEQ_MUTE_CC for a track whose mute changed since what was
+ * sent (whatever changed it), all six on each bar while playing (launch_steps: 16 of a 1/16 track's steps, either clock)
+ * and when USB comes up (a host connected after PLAY knows within a bar) */
+static uint32_t seq_mute_bar __attribute__((section(".pool")));   /* the bar the last ones were sent in (launch_steps
+                                                                   * / 16) */
+#if SKIFF_SEQ_MIDI
+static uint8_t seq_mute_usb __attribute__((section(".pool")));    /* usb.config as last seen */
+static __attribute__((noinline)) void seq_mute_block(void)
+{
+    uint32_t i, force = 0;
+    if (seq_mute_usb != usb.config) {
+        seq_mute_usb = usb.config;
+        memset(seq_mute_sent, 0xFF, sizeof seq_mute_sent);
+    }
+    if (song.playing && launch_steps / 16u != seq_mute_bar) {
+        seq_mute_bar = launch_steps / 16u;
+        force = 1;
+    }
+    for (i = 0; i < NTRK; i++)
+        seq_midi_mute(i, (int)force);
+}
+#else
+#define seq_mute_block() ((void)0)
+#endif
+
 static void seq_start(void)
 {
     uint32_t i;
@@ -1160,6 +1229,8 @@ static void seq_start(void)
         seq_midi_rt(0xFAu);
         seq_clk_acc = beat_samples();
     }
+    seq_midi_mutes();                              /* (Vizz) every track's mute after Start (CC SEQ_MUTE_CC) */
+    seq_mute_bar = 0;
     motion_begin();
     take_clear();                                  /* (Skiff) TAKES: a new log from PLAY */
     for (i = 0; i < NTRK; i++) {                   /* every track from its step 0, together */
@@ -1853,6 +1924,7 @@ static void events_block(uint32_t n)
     }
     if (song.playing)
         launch_clock(seq_n);                          /* (Skiff) the steps a BAR / BEAT launch waits for */
+    seq_mute_block();                                 /* (Vizz, SEQ MIDI OUT) the mutes as they changed, each bar */
     if (aud_req)
         seq_audition();                               /* ((1.3) STEP PREVIEW: a step sounds, stopped) */
     for (i = 0; i < NTRK; i++)
