+        blocks(1);
+        bad += check("6 T2 CHANNEL 10: T2's CC 103 on channel 10 (sent as the channel changes; 127 muted)",
+                     ok && mlog_n == 1u && mlog[0] == (0x0Bu | 0xB9u << 8 | SEQ_MUTE_CC << 16 | 127u << 24));
+    }
+    glo_mute(1);
+    trk[1].step[0] = (step_t){{50}, 1, ST_NOTE, 0, 100};
+    trk[1].p[P_SGATE] = 120;
+    settle();
+    transport_req = 1;
+    blocks(4);                                       /* (its note sounding on channel 10) */
+    reset_log();
+    menu_put(MI_TCH1 + 1, 1);                        /* back on channel 2 */
+    blocks(step_blocks(1));
+    bad += check("  a channel changed while its note sounds: CC 123 on the old one (10) first, CC 103 = 0 on the new",
+                 mlog_n >= 2u && mlog[0] == (0x0Bu | 0xB9u << 8 | 123u << 16) && mlog[1] == cc103(1, 0) &&
+                 lcount(0, K_OFF, ANY_CH, -1) == 0u);
+    transport_req = 2;
+    blocks(2);
+
+    /* (Vizz) 7 SOLO: every track a note on each beat, T4 muted; GLO + F3 held: T1 solo; then let go */
+    {
+        uint32_t k;
+        int ok;
+        setup();
+        for (i = 0; i < NTRK; i++)
+            for (k = 0; k < 16u; k += 4u)
+                trk[i].step[k] = (step_t){{60}, 1, ST_NOTE, 0, 100};
+        trk[3].p[P_MUTE] = 1;
+        settle();
+        transport_req = 1;
+        blocks(1u + step_blocks(2));                 /* on step 2 */
+        reset_log();
+        lay_combo(B_GLO, white(0));                  /* SOLO T1, held */
+        blocks(1);
+        ok = perf_solo == 1u && !perf_kill && lcount(0, SEQ_MUTE_CC, ANY_CH, -1) == 4u;
+        for (i = 1; i < NTRK; i++)
+            ok &= lcount(0, SEQ_MUTE_CC, trk_midi_ch(i), 127) == (i == 3u ? 0u : 1u);
+        bad += check("7 SOLO T1 (GLO + F3 held): at once CC 103 = 127 for T2 T3 T5 T6 (T4 muted before), none for T1", ok);
+        blocks(step_blocks(16));                     /* a bar line: every track's again */
+        ok = llast_val(0, SEQ_MUTE_CC, trk_midi_ch(0)) == 0 && lcount(0, K_ON, trk_midi_ch(0), -1) >= 3u;
+        for (i = 1; i < NTRK; i++)
+            ok &= llast_val(0, SEQ_MUTE_CC, trk_midi_ch(i)) == 127 && lcount(0, K_ON, trk_midi_ch(i), -1) == 0u;
+        bad += check("  held a bar: T1 0, T2..T6 127; only T1's notes", ok);
+        reset_log();
+        key_up(white(0));
+        btn_up(B_GLO);
+        frame();
+        blocks(1);
+        ok = !perf_solo && lcount(0, SEQ_MUTE_CC, ANY_CH, -1) == 4u;
+        for (i = 1; i < NTRK; i++)
+            ok &= lcount(0, SEQ_MUTE_CC, trk_midi_ch(i), 0) == (i == 3u ? 0u : 1u);
+        bad += check("  let go: at once CC 103 = 0 for T2 T3 T5 T6 (T4 muted: no change, T1 as it was)", ok);
+        blocks(step_blocks(8));
+        ok = 1;
+        for (i = 0; i < NTRK; i++)
+            ok &= i == 3u ? lcount(0, K_ON, trk_midi_ch(i), -1) == 0u : lcount(0, K_ON, trk_midi_ch(i), -1) >= 1u;
+        bad += check("  their notes again (T4's not)", ok);
+        transport_req = 2;
+        blocks(2);
+    }
+
+    /* (2.0) HELD: the one MUTE held (2.0's black keys in GLO, FX and PERFORM: a hold cuts the track while it is held,
+     * ui_layer.c mute_keys, perform.c perf_begin). T2 a note on every step (GATE 100), T3 and T4 too; each held past
+     * MENU's HOLD (0.6 s) while playing, then let go */
+    {
+        static const uint32_t BTN[3] = {B_GLO, B_FX, B_ARP};
+        static const char *const NAME[3] = {"GLO", "FX", "PERFORM"};
+        uint32_t l, ti;
+        int a, b, ok;
+        for (l = 0; l < 3u; l++) {
+            ti = 1u + l;
+            setup();
+            for (i = 0; i < 16u; i++)
+                trk[ti].step[i] = (step_t){{(uint8_t)(50u + ti)}, 1, ST_NOTE, 0, 100};
+            trk[ti].p[P_SGATE] = 100;
+            settle();
+            transport_req = 1;
+            blocks(4);                               /* (its note sounding) */
+            reset_log();
+            btn_down(BTN[l]);
+            frame();                                 /* (the button a frame first: its keys the layer's) */
+            key_down(black(ti));
+            run_ms(640);                             /* held past HOLD */
+            a = lfirst(0, 123u, ti, -1);
+            b = lfirst(0, SEQ_MUTE_CC, ti, 127);
+            ok = trk_silent(ti) && !trk[ti].p[P_MUTE] && a >= 0 && b > a && lcount(0, SEQ_MUTE_CC, ti, -1) == 1u &&
+                 lfirst((uint32_t)b, K_ON, ti, -1) < 0 && lcount(0, SEQ_STEP_CC, ti, -1) >= 4u &&   /* (0.64 s: 5 steps) */
+                 (l != 2u || lat(b) >= (int)(HOLD_MS[settings_hold % 4u] * 441u / 10u) - (int)(32u * CTL));
+            bad += check(l == 0u ? "(2.0) HELD: GLO's black key 2 held: T2 cut, CC 123 then one CC 103 = 127, no note-on "
+                                   "while held, its CC 102 on" :
+                         l == 1u ? "  FX's black key 3 held: T3 cut from the press, the same" :
+                                   "  PERFORM's black key 4 held: T4 cut once it is a hold (MENU's HOLD), the same", ok);
+            if (!ok)
+                printf("ui:   %s: silent %d mute %d, CC 123 at %d, CC 103 at %d (t %d), %u CC 103\n", NAME[l],
+                       trk_silent(ti), trk[ti].p[P_MUTE], a, b, lat(b), lcount(0, SEQ_MUTE_CC, ti, -1));
+            reset_log();
+            key_up(black(ti));
+            btn_up(BTN[l]);
+            frame();
+            blocks(step_blocks(3));
+            a = lfirst(0, SEQ_MUTE_CC, ti, 0);
+            b = lfirst(0, K_ON, ti, -1);
+            ok = !trk_silent(ti) && !trk[ti].p[P_MUTE] && !mute_arm[ti] && a >= 0 && b > a &&
+                 lcount(0, SEQ_MUTE_CC, ANY_CH, -1) == 1u && lcount(0, K_ON, ti, -1) >= 2u && lpaired(0);
+            bad += check("  let go: one CC 103 = 0, then its notes again; its MUTE as it was (none)", ok);
+            transport_req = 2;
+            blocks(2);
+        }
+        setup();                                     /* FX's tap: the MUTE, latched */
+        settle();
+        btn_down(B_FX);
+        frame();
+        key_down(black(4));
+        frame();
+        key_up(black(4));
+        frame();
+        btn_up(B_FX);
+        frame();
+        blocks(1);
+        ok = trk[4].p[P_MUTE] == 1 && lcount(0, SEQ_MUTE_CC, ANY_CH, 127) == 1u && lcount(0, SEQ_MUTE_CC, 4, 127) == 1u;
+        run_ms(320);
+        ok &= lcount(0, SEQ_MUTE_CC, ANY_CH, -1) == 1u;
+        bad += check("  FX's black key 5 tapped: T5's MUTE, one CC 103 = 127, and it stays", ok);
+    }
+
     printf("seqmidi: %s\n", bad ? "FAILED" : "all ok");
     return bad != 0;
 }
