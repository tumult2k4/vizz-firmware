+    for (i = 0; i < 4u; i++)
+        ok(vb_live.id[i] == (i < 2u ? ENGINES[TSEL->eng_req % NENGINES]->knob[i] : i == 2u ? P_REL : P_DIST),
+           "LIVE KNOB %u: parameter %u", i + 1u, vb_live.id[i]);
+    id = vb_live.id[0];
+    web_enc(EN_K1, 4);
+    run_s(0.1);
+    ok(vb_mine(R_L, id), "LIVE KNOB 1: not the user's");
+    for (i = 0; i < 40u; i++) {                       /* SELECT to KLANG's end */
+        web_enc(EN_SELECT, 1);
+        run_s(0.03);
+        if (!page_over) {
+            uint32_t f = PAGES[ui.page].fam;
+            seen |= 1u << f;
+            fam_ok &= f == FAM_EDIT || f == FAM_ENV || f == FAM_FX || f == FAM_TRK;
+        }
