+/* the white keys play the focus track (3.2): LEAD in the song's scale; DRUMS a lane a key; CHORDS a chord a key, in the
+ * key; the black keys never a note; out over USB on the focus track's channel */
+static void case_keys(void)
+{
+    uint32_t i, k, n, notes, inkey, lane_ok = 1, chord_ok = 1;
+    snprintf(tag, sizeof tag, "keys");
+    boot();
+    knobs(0, 0, 0x1111u, 70, 40, 1);
