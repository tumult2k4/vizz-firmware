+/* ---------------------------------------------------------------- (1.1) the VIZZBOX's pages, keys and layers (3) */
+static uint32_t key_at(int black, uint32_t place)
+{
+    uint32_t k;
+    for (k = 0; k < 27u && !(key_black(k) == black && key_place(k) == place); k++)
+        ;
