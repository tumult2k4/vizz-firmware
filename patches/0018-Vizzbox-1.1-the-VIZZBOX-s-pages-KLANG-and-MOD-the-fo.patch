+        web_enc(EN_SELECT, -1);
+        run_s(0.03);
+    }
+    ok(page_over == &vb_live, "SELECT back: not LIVE first");
+    web_enc(EN_ALGO, -1);
+    run_s(0.05);
+    ok(song.sel == R_C, "ALGORITHM on KLANG: the focus T%u", song.sel + 1u);
+    press(1u << B_LFO);
+    ok(vb_pg == VP_MOD && PAGES[ui.page].fam == FAM_LFO, "LFO: not MOD");
+    for (i = 0; i < 10u; i++) {
+        web_enc(EN_SELECT, 1);
+        run_s(0.03);
+        ok(PAGES[ui.page].fam == FAM_LFO, "MOD: page %u not LFO's", ui.page);
+    }
