+        nev = 0;
+        tap_key(key_at(0, i));
+        for (k = 0, n = 0; k < nev; k++)
+            if (ev[k].st == (0x90u | R_C) && ev[k].d2) {
+                n++;
+                chord_ok &= key_has(ev[k].d1);
+            }
