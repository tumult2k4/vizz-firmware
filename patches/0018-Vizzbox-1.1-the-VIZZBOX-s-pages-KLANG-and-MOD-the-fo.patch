+}
+static void tap_key(uint32_t k)
+{
+    web_keys(1u << k);
+    run_s(0.08);
+    web_keys(0);
+    run_s(0.05);
+}
+static void focus(uint32_t k)                       /* SEL + track k's black key */
+{
+    black_with(1u << B_SCL, k);
+}
+/* EDIT KLANG, LFO MOD, again SONG; SELECT through KLANG (LIVE, EDIT's, ENV's, FX's pages, the MIXER) and MOD (LFO's);
+ * ALGORITHM and SEL + a black key the focus track; LIVE's four the role's, a turn the user's */
+static void case_pages(void)
+{
+    uint32_t i, seen = 0, fam_ok = 1, id;
+    snprintf(tag, sizeof tag, "pages");
+    boot();
+    ok(vb_mode && !vb_pg && song.sel == R_L, "a new unit: not the VIZZBOX's SONG, LEAD in focus");
+    press(1u << B_EDIT);
