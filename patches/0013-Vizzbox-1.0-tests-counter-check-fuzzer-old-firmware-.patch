@@ -0,0 +1,232 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox) The cost of the heaviest drop (BRIEF-VIZZBOX.md 7: "im Budget, auch im schwersten Genre-Drop mit allen
+ * Effekten (dafür einen Messfall anlegen)"). tests/target_budget.py holds every render loop to its budget, statically;
+ * what plays decides how many of them run. Here, on the browser emulator's device built natively (VIZZBOX=1): every
+ * subgenre's first DROP at ENERGY 100 and VARIATION 100 (three seeds), its CPU time for 8 s of audio, against the
+ * same for Skiff's heavy song (web/emu/felucca_web.c web_test_heavy: three POLY tracks holding four-note chords over
+ * the budget of 8 voices, drums; what emu_test.mjs holds to real time in the browser) on the same host; a form without
+ * a DROP (A: AMBIENT, DUB, DUB TECHNO) its first GROOVE. Each case on a fresh device (fork), its CPU time the
+ * thread's. The five heaviest again, each beside the heavy song (in turn, three times each, the least of each: the
+ * host's speed drifts, so a ratio comes from measurements side by side); the heaviest of them then with every effect
+ * at once (each track's DRIVE, CHORUS, DELAY and REVERB sends all the way up, the FX layer's REPEAT 1/32, GATE, DUB
+ * and FLANGE held) beside the heavy song with the same. In every drop at most 8 voices and none stolen.
+ *   cc -O2 -ffp-contract=off -w -Ibuild/gen -Ifirmware/src -o OUT tests/vizzbox_budget.c -lm
+ *   OUT [LIMIT]       fails if the heaviest drop costs more than LIMIT (default 1.10: the host's timing, as
+ *                     target_budget.py's +10 %) x the heavy song, or with every effect x the heavy song with them */
+#define VIZZBOX 1
+#include "../web/emu/felucca_web.c"
+#include <stdlib.h>
+#include <sys/wait.h>
+#include <time.h>
+#include <unistd.h>
+
+static uint32_t last104, maxv;
+static uint32_t genre_of(int ri)                    /* subgenre ri (VB_SUB's order) -> its genre */
+{
+    uint32_t g = 0;
+    while (g < 9u && (uint32_t)ri >= vb_sub0(g + 1u))
+        g++;
+    return g;
+}
+static double cpu_s(void)
+{
+    struct timespec t;
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &t);
+    return (double)t.tv_sec + (double)t.tv_nsec * 1e-9;
+}
+static void drain(void)
+{
+    while (mo_r != mo_w) {
+        uint32_t pkt = midi_out_q[mo_r % MQ];
+        mo_r++;
+        if (((pkt >> 8) & 0xFFu) == 0xBFu && ((pkt >> 16) & 0x7Fu) == 104u)
+            last104 = (pkt >> 24) & 0x7Fu;
+    }
+}
+static uint32_t voices(void)
+{
+    uint32_t k, i, n = 0;
+    for (k = 0; k < NTRK; k++)
+        for (i = 0; i < NVOICE; i++)
+            n += trk[k].v[i].active && trk[k].v[i].stage != 4u;
+    return n;
+}
+static void run_frames(uint32_t n)
+{
+    uint32_t k, v;
+    for (k = 0; k < n; k += 128u) {
+        web_render(n - k < 128u ? n - k : 128u);
+        drain();
+        if ((v = voices()) > maxv)
+            maxv = v;
+    }
+}
+static void press(uint32_t b)
+{
+    web_buttons(1u << b);
+    run_frames(1764);
+    web_buttons(0);
+    run_frames(1764);
+}
+static void boot(void)
+{
+    web_nor_erase();
+    web_boot();
+    usb.config = 1;
+    web_master(1023);
+    run_frames(44100);
+}
+/* every effect at once: the sends up, the FX layer's REPEAT 1/32, GATE, DUB, FLANGE held */
+static void all_fx(void)
+{
+    static const uint32_t SENDS[] = {P_DIST, P_CHOR, P_DLY, P_REV};
+    uint32_t k, s;
+    for (k = 0; k < NTRK; k++)
+        for (s = 0; s < 4u; s++)
+            trk[k].p[SENDS[s]] = (int16_t)param_desc_of(eng_idx(trk[k].eng_req), SENDS[s])->max;
+    perf_press(PF_R32, 1);
+    perf_press(PF_GATE, 1);
+    perf_press(PF_DUB, 1);
+    perf_press(PF_FLG, 1);
+}
+
+typedef struct { int ri, seed, fx; double cost; uint32_t bpm, maxv, found, kills, want; } m_t;
+/* one case: ri < 0 the heavy song in the GROOVEBOX; else subgenre ri's first DROP. cost: CPU s per s of audio */
+static void one(m_t *m)
+{
+    double t0;
+    uint32_t i;
+    boot();
+    if (m->ri < 0) {
+        vb_mode_set(0);
+        run_frames(4410);
+        web_test_heavy();
+        press(B_PLAY);
+        run_frames(2u * 44100u);
+        m->found = 1;
+        if (m->fx)
+            all_fx();
+    } else {
+        vb.k.genre = (uint8_t)genre_of(m->ri);
+        vb.k.sub = (uint8_t)((uint32_t)m->ri - vb_sub0(vb.k.genre));
+        vb.k.seed = (uint16_t)m->seed;
+        vb.k.energy = 100;
+        vb.k.var = 100;
+        vb.k.len = VL_NORMAL;
+        vb.k.bpm = 0;
+        vb_knob_song();
+        press(B_PLAY);
+        for (i = 0, m->want = 2u; i < vb.nplan; i++)  /* (a form without a DROP, ambient's: its first GROOVE) */
+            if (vb.plan[i].type == VS_DROP)
+                m->want = 4u;
+        for (i = 0; i < 6000u && last104 != m->want; i++)   /* (to its one, at most 10 min) */
+            run_frames(4410);
+        m->found = last104 == m->want;
+        if (m->fx)
+            all_fx();
+    }
+    m->bpm = (uint32_t)song.g[G_BPM];
+    maxv = 0;
+    voice_kills = 0;
+    t0 = cpu_s();
+    run_frames(8u * 44100u);
+    m->cost = (cpu_s() - t0) / 8.0;
+    m->maxv = maxv;
+    m->kills = voice_kills;
+}
+static void measure(m_t *m, int reps);
+/* a and b measured in turn, three times each, the least of each */
+static void measure_pair(m_t *a, m_t *b)
+{
+    m_t x, y;
+    int r;
+    for (r = 0; r < 3; r++) {
+        x = *a;
+        y = *b;
+        measure(&x, 1);
+        measure(&y, 1);
+        if (!r || x.cost < a->cost)
+            *a = x;
+        if (!r || y.cost < b->cost)
+            *b = y;
+    }
+}
+static void measure(m_t *m, int reps)               /* reps times, each on a fresh device: the least */
+{
+    int p[2], r;
+    double best = 1e9;
+    m_t o;
+    for (r = 0; r < reps; r++) {
+        if (pipe(p))
+            exit(2);
+        if (!fork()) {
+            close(p[0]);
+            one(m);
+            if (write(p[1], m, sizeof *m) != (ssize_t)sizeof *m)
+                _exit(2);
+            _exit(0);
+        }
+        close(p[1]);
+        if (read(p[0], &o, sizeof o) == (ssize_t)sizeof o && o.cost < best) {
+            best = o.cost;
+            *m = o;
+        }
+        close(p[0]);
+        wait(NULL);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    static const int SEEDS[] = {0x5EED, 0x0B0B, 0x7A11};
+    static m_t all[108];
+    double limit = argc > 1 ? atof(argv[1]) : 1.10, rtop = 0;
+    m_t ref = {-1, 0, 0, 0, 0, 0, 0, 0, 0}, refx = ref, top = ref, fx;
+    int ri, s, i, j, n = 0, bad = 0;
+    refx.fx = 1;
+    measure(&ref, 3);
+    measure(&refx, 3);
+    printf("budget: Skiff's heavy song (GROOVEBOX): %.4f s CPU per s of audio (%u voices); with every effect %.4f\n",
+           ref.cost, ref.maxv, refx.cost);
+    for (ri = 0; ri < 36; ri++)
+        for (s = 0; s < 3; s++) {
+            m_t *m = &all[n++];
+            *m = (m_t){ri, SEEDS[s], 0, 0, 0, 0, 0, 0, 0};
+            measure(m, 1);
+            if (!m->found || m->maxv > 8u || m->kills) {
+                printf("budget: %-11s / %-14s seed %04X: %s  FAIL\n", VB_GNAME[genre_of(ri)], VB_SNAME[ri], m->seed,
+                       !m->found ? "no DROP (GROOVE) within 10 minutes" : m->maxv > 8u ? "more than 8 voices" : "voices stolen");
+                bad++;
+                m->cost = 0;
+                continue;
+            }
+            if (s == 0 || getenv("VERBOSE"))
+                printf("budget: %-11s / %-14s seed %04X %3u BPM: the %-6s %.2f x the heavy song, at most %u voices\n",
+                       VB_GNAME[genre_of(ri)], VB_SNAME[ri], m->seed, m->bpm, m->want == 4u ? "DROP" : "GROOVE",
+                       m->cost / ref.cost, m->maxv);
+        }
+    for (i = 0; i < 5; i++) {                       /* the five heaviest, each beside the heavy song */
+        int k = 0;
+        m_t r = ref;
+        for (j = 1; j < n; j++)
+            if (all[j].cost > all[k].cost)
+                k = j;
+        fx = all[k];
+        all[k].cost = 0;
+        measure_pair(&fx, &r);
+        if (fx.cost / r.cost > rtop) {
+            rtop = fx.cost / r.cost;
+            top = fx;
+        }
+    }
+    fx = top;
+    fx.fx = 1;
+    measure_pair(&fx, &refx);
+    printf("budget: the heaviest DROP: %s / %s seed %04X %u BPM, %.2f x the heavy song (%u voices, none stolen)  %s\n",
+           VB_GNAME[genre_of(top.ri)], VB_SNAME[top.ri], top.seed, top.bpm, rtop, top.maxv, rtop <= limit ? "ok" : "FAIL");
+    printf("budget: .. with every effect (sends up, REPEAT 1/32, GATE, DUB, FLANGE held): %.2f x the heavy song with them  %s\n",
+           fx.cost / refx.cost, fx.cost <= limit * refx.cost ? "ok" : "FAIL");
+    bad += rtop > limit;
+    bad += fx.cost > limit * refx.cost;
+    return bad ? 1 : 0;
+}
diff --git a/tests/vizzbox_compat.c b/tests/vizzbox_compat.c
new file mode 100644
index 0000000..28d4cd3
--- /dev/null
+++ b/tests/vizzbox_compat.c
@@ -0,0 +1,161 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox) A unit with the Vizzbox's favourites, read by Vizz 2.0 and Skiff 2.0.1 (BRIEF-VIZZBOX.md 9: "Vizz 2.0 /
+ * Skiff 2.0.1 lesen ein Gerät mit Favoriten-Objekt ohne Fehler"), and back. The browser emulator's device
+ * (web/emu/felucca_web.c) of each, built natively, on the same 1 MiB flash image:
+ *   make OUT      (this tree, VIZZBOX=1) a new unit: the music saved in slot 1 (COMPAT ONE), the GROOVEBOX's
+ *                autosave, sixteen favourites written and one changed again (both copies, B 0x96000 and A 0x95000)
+ *   old IN OUT   (Vizz 2.0's or Skiff 2.0.1's tree, FELUCCA_WEB its felucca_web.c) that flash booted: slot 1 there
+ *                by its name and loaded as saved, another tempo saved in slot 2 (OLD SAVE), PLAY, the autosave, a setting
+ *                saved; the favourites' two sectors byte for byte as before
+ *   back IN      (this tree) that flash: the sixteen favourites as written, slots 1 and 2 by their names, each as
+ *                saved (slot 2 as the old firmware saved it)
+ *   cc -O2 -ffp-contract=off -w -DVIZZBOX=1 -Ibuild/gen -Ifirmware/src -o OUT tests/vizzbox_compat.c -lm
+ *   cc -O2 -ffp-contract=off -w '-DFELUCCA_WEB="TREE/web/emu/felucca_web.c"' -Ibuild/gen -ITREE/firmware/src ... */
+#ifdef FELUCCA_WEB
+#include FELUCCA_WEB
+#else
+#include "../web/emu/felucca_web.c"
+#endif
+
+static int fails;
+static void check(const char *what, int c)
+{
+    printf("compat: %-96s %s\n", what, c ? "ok" : "FAIL");
+    fails += !c;
+}
+static void ms(uint32_t n)
+{
+    uint32_t f = n * 441u / 10u, k;
+    for (k = 0; k < f; k += 128u)
+        web_render(f - k < 128u ? f - k : 128u);
+}
+static int nor_io(const char *path, int write)
+{
+    FILE *f = fopen(path, write ? "wb" : "rb");
+    size_t n;
+    if (!f)
+        return 1;
+    n = write ? fwrite(nor, 1, sizeof nor, f) : fread(nor, 1, sizeof nor, f);
+    fclose(f);
+    return n != sizeof nor;
+}
+/* the music the test saves: T1 a bassline, its notes 36 + 4 * k, at `bpm` (the project's; a pattern is the pattern
+ * pool's, shared by the projects that name it: Skiff's own way) */
+static void music(uint32_t bpm)
+{
+    uint32_t i;
+    for (i = 0; i < 16u; i++)
+        memset(&trk[0].step[i], 0, sizeof trk[0].step[i]);
+    for (i = 0; i < 16u; i += 2u)
+        trk[0].step[i] = (step_t){{(uint8_t)(36u + 4u * (i / 2u % 3u))}, 1, ST_NOTE, 0, 100};
+    song.g[G_BPM] = (int16_t)bpm;
+}
+static int music_is(uint32_t bpm)
+{
+    return trk[0].step[0].n == 1u && trk[0].step[0].note[0] == 36 && trk[0].step[2].note[0] == 40 &&
+           trk[0].step[4].note[0] == 44 && trk[0].step[6].note[0] == 36 && !trk[0].step[1].n && song.g[G_BPM] == (int16_t)bpm;
+}
+static int name_is(uint32_t slot, const char *want)
+{
+    char b[PROJ_NAME_LEN + 1];
+    return project_name(slot, b) && !strcmp(b, want);
+}
+static uint32_t fav_hash(void)
+{
+    uint32_t h = 2166136261u, i;
+    for (i = 0x95000u; i < 0x97000u; i++)
+        h = (h ^ nor[i]) * 16777619u;
+    return h;
+}
+#if VIZZBOX
+static void favs_want(vb_song_t *f)
+{
+    uint32_t i;
+    for (i = 0; i < VB_NFAV; i++)
+        f[i] = (vb_song_t){(uint8_t)(i % 10u), 0, (uint8_t)(10u + 5u * i), (uint8_t)(90u - 5u * i), (uint8_t)(i % 3u),
+                           (uint8_t)(i & 1u ? 0u : 100u + i), (uint16_t)(0x1000u + i)};
+    f[3].seed = 0xBEEFu;
+}
+#endif
+
+int main(int argc, char **argv)
+{
+    const char *mode = argc > 1 ? argv[1] : "";
+    web_nor_erase();
+    if (!strcmp(mode, "old") || !strcmp(mode, "back"))
+        if (argc < 3 || nor_io(argv[2], 0)) {
+            printf("compat: no flash image %s\n", argc > 2 ? argv[2] : "");
+            return 2;
+        }
+    web_boot();
+    usb.config = 1;
+    web_master(1023);
+    ms(1500);
+#if VIZZBOX
+    if (!strcmp(mode, "make") && argc > 2) {
+        vb_song_t want[VB_NFAV];
+        favs_want(want);
+        vb_mode_set(0);                             /* the GROOVEBOX: the music saved, the autosave */
+        ms(300);
+        music(120);
+        check("make: the music saved in slot 1 (COMPAT ONE)", !project_save_as(0, "COMPAT ONE"));
+        ms(12000);
+        vb_mode_set(1);
+        ms(300);
+        memcpy(vb_fav.f, want, sizeof vb_fav.f);
+        vb_fav.f[3].seed = 0x1003u;
+        vb_fav_dirty = 1;                           /* (the first copy, A) */
+        ms(300);
+        vb_fav.f[3].seed = 0xBEEFu;
+        vb_fav_dirty = 1;                           /* (one changed again: B) */
+        ms(300);
+        check("make: both copies written (A 0x95000, B 0x96000), the second (sequence 2) the newer",
+              !memcmp(nor + 0x95000u, "VBF1", 4) && !memcmp(nor + 0x96000u, "VBF1", 4) && vb_fav.seq == 2u);
+        vb_mode_set(0);
+        ms(500);
+        printf("compat: the favourites' sectors %08x\n", fav_hash());
+        return nor_io(argv[2], 1) || fails;
+    }
+    if (!strcmp(mode, "back")) {
+        vb_song_t want[VB_NFAV];
+        favs_want(want);
+        check("back: the sixteen favourites as written (the newer copy, sequence 2)",
+              vb_fav.magic == VB_FMAGIC && !memcmp(vb_fav.f, want, sizeof want) && vb_fav.seq == 2u);
+        check("back: slot 1 COMPAT ONE and slot 2 OLD SAVE by their names", name_is(0, "COMPAT ONE") && name_is(1, "OLD SAVE"));
+        project_load(1);
+        ms(300);
+        check("back: slot 2 loaded as the old firmware saved it (133 BPM)", music_is(133));
+        project_load(0);
+        ms(300);
+        check("back: slot 1 as the Vizzbox saved it (120 BPM)", music_is(120));
+        return fails ? 1 : 0;
+    }
+#else
+    if (!strcmp(mode, "old") && argc > 3) {
+        uint8_t fav[0x2000];
+        memcpy(fav, nor + 0x95000u, sizeof fav);
+        check("old: booted on the Vizzbox's flash; slot 1 there by its name", name_is(0, "COMPAT ONE"));
+        project_load(0);
+        ms(500);
+        check("old: slot 1 loaded as the Vizzbox saved it (120 BPM)", music_is(120));
+        song.g[G_BPM] = 133;
+        check("old: a change (133 BPM) saved in slot 2 (OLD SAVE)", !project_save_as(1, "OLD SAVE"));
+        web_buttons(1u << B_PLAY);
+        ms(60);
+        web_buttons(0);
+        ms(4000);
+        web_buttons(1u << B_PLAY);
+        ms(60);
+        web_buttons(0);
+        settings.palette = (uint8_t)((settings.palette + 1u) % NPALETTES);
+        settings_save();
+        ms(15000);                                  /* (the autosave, the settings written) */
+        check("old: the favourites' two sectors byte for byte as before (none read, written or erased)",
+              !memcmp(fav, nor + 0x95000u, sizeof fav));
+        printf("compat: the favourites' sectors %08x\n", fav_hash());
+        return nor_io(argv[3], 1) || fails;
+    }
+#endif
+    printf("usage: vizzbox_compat make OUT | old IN OUT | back IN\n");
+    return 2;
+}
diff --git a/tests/vizzbox_fuzz.c b/tests/vizzbox_fuzz.c
new file mode 100644
index 0000000..7c8cb10
--- /dev/null
+++ b/tests/vizzbox_fuzz.c
@@ -0,0 +1,229 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox) Fuzz (BRIEF-VIZZBOX.md 9): the VIZZBOX's controls at random over a long time, on the browser emulator's
+ * device (web/emu/felucca_web.c, VIZZBOX=1), built with ASan / UBSan in tests/run_tests.sh. Each action, after a
+ * random 20 .. 800 ms: a knob turned (K1..K4, SELECT, ALGO, PRESET, by 1 .. 12 either way), a button (PLAY, REC,
+ * FX, ARP, SEQ, OCT-, OCT+), HOME + PLAY (VIZZBOX <-> GROOVEBOX), SAVE or GLO held with a white key (a favourite), GLO
+ * with a black key (SOLO), black keys tapped or held (MUTE, cut), white keys played, MIDI in, the MENU opened and a
+ * knob turned there, a power cycle on the same flash. After each: the knobs' song in range (genre, subgenre, energy,
+ * variation, length), the plan within its ring, the tempo in range, the mode 0 or 1. At the end: stopped, every key
+ * let go, 12 s later every voice free and no note left on on USB MIDI (each note-on its note-off); a fresh device on
+ * that flash boots and plays (with a clock from outside where the fuzzing left MENU > MIDI > CLOCK on USB or TRS).
+ *   cc -O1 -g -fsanitize=address,undefined ... -Ibuild/gen -Ifirmware/src -o OUT tests/vizzbox_fuzz.c -lm
+ *   OUT ACTIONS SEED */
+#define VIZZBOX 1
+#include "../web/emu/felucca_web.c"
+#include <stdlib.h>
+
+static uint32_t fz, fails, held_keys, held_btn;
+static uint32_t st_play, st_switch, st_boot, st_secs, st_style;   /* what it went through */
+static uint8_t on[16][128];                         /* USB MIDI: notes on (channel, pitch) */
+static uint32_t rnd(uint32_t n)
+{
+    fz = fz * 1664525u + 1013904223u;
+    return (fz >> 8) % n;
+}
+static void fail(const char *what, uint32_t a, uint32_t b)
+{
+    printf("vizzbox_fuzz: FAIL %s (%u, %u)\n", what, a, b);
+    fails++;
+}
+static void drain(void)
+{
+    while (mo_r != mo_w) {
+        uint32_t pkt = midi_out_q[mo_r % MQ], st = (pkt >> 8) & 0xFFu, d1 = (pkt >> 16) & 0x7Fu, d2 = (pkt >> 24) & 0x7Fu;
+        mo_r++;
+        if ((st & 0xF0u) == 0x90u && d2)
+            on[st & 15u][d1] = 1;
+        else if ((st & 0xF0u) == 0x80u || (st & 0xF0u) == 0x90u)
+            on[st & 15u][d1] = 0;
+        else if ((st & 0xF0u) == 0xB0u && d1 == 123u)
+            memset(on[st & 15u], 0, 128);
+    }
+}
+static void ms(uint32_t n)
+{
+    uint32_t f = n * 441u / 10u, k;
+    for (k = 0; k < f; k += 128u) {
+        web_render(f - k < 128u ? f - k : 128u);
+        drain();
+        st_play += vb.own && song.playing;
+    }
+}
+/* an external clock (MENU > MIDI > CLOCK USB or TRS, as the fuzzing may have left it): Start, then 24 a beat at 120
+ * BPM for n ms */
+static void ext_clock(uint32_t n)
+{
+    uint32_t t;
+    for (t = 0; t < n * 24u; t += 500u) {           /* (every 1/24 of a 500 ms beat) */
+        uint32_t b = t ? 0xF8u : 0xFAu;
+        if (song.g[G_CLOCK] == 1)
+            midi_enqueue(0xFu | b << 8, 1u);
+        else
+            um_byte((uint8_t)b);
+        web_render(919);                            /* (20.8 ms) */
+        drain();
+    }
+}
+static uint32_t key_of(int black, uint32_t place)
+{
+    uint32_t k;
+    for (k = 0; k < 27u; k++)
+        if (key_black(k) == black && key_place(k) == place)
+            return k;
+    return 0;
+}
+static void invariants(uint32_t i)
+{
+    static uint32_t sec, style;
+    if (vb.own && song.playing && vb.sec != sec)
+        st_secs++;
+    if (vb.own && song.playing && (uint32_t)(vb.s.genre * 8u + vb.s.sub) != style)
+        st_style++;
+    sec = vb.sec;
+    style = vb.s.genre * 8u + vb.s.sub;
+    if (vb.k.genre >= 10u || vb.k.sub >= VB_NSUB[vb.k.genre % 10u])
+        fail("the knobs' style out of range", vb.k.genre, vb.k.sub);
+    if (vb.k.energy > 100u || vb.k.var > 100u || vb.k.len > VL_ENDLESS)
+        fail("the knobs' energy, variation or length out of range", i, vb.k.energy);
+    if (vb.nplan > VB_PLAN || (vb.own && song.playing && vb.sec >= vb.nplan + VB_PLAN))
+        fail("the plan out of its ring", vb.nplan, vb.sec);
+    if (song.g[G_BPM] < 20 || song.g[G_BPM] > 300)
+        fail("the tempo out of range", i, (uint32_t)song.g[G_BPM]);
+    if (vb_mode > 1u)
+        fail("the mode", i, vb_mode);
+}
+static void boot(void)
+{
+    web_boot();
+    usb.config = 1;
+    web_master(1023);
+    memset(on, 0, sizeof on);
+    held_keys = held_btn = 0;
+    ms(1300);
+}
+
+int main(int argc, char **argv)
+{
+    static const uint32_t ENCS[] = {EN_K1, EN_K2, EN_K3, EN_K4, EN_SELECT, EN_ALGO, EN_PRESET};
+    static const uint32_t BTNS[] = {B_PLAY, B_REC, B_FX, B_ARP, B_SEQ, B_OCTDN, B_OCTUP};
+    uint32_t n = argc > 1 ? (uint32_t)atoi(argv[1]) : 2000u, i, a, k, v, ch;
+    fz = argc > 2 ? (uint32_t)atoi(argv[2]) : 1u;
+    web_nor_erase();
+    boot();
+    for (i = 0; i < n; i++) {
+        a = rnd(100);
+        if (a < 30)
+            web_enc(ENCS[rnd(7)], (int32_t)(rnd(12) + 1u) * (rnd(2) ? 1 : -1));
+        else if (a < 45) {
+            web_buttons(1u << BTNS[rnd(7)] | held_btn);
+            ms(40);
+            web_buttons(held_btn);
+        } else if (a < 49) {                        /* HOME + PLAY: the other mode */
+            web_buttons(1u << B_HOME);
+            ms(60);
+            web_buttons(1u << B_HOME | 1u << B_PLAY);
+            ms(60);
+            web_buttons(0);
+            held_btn = 0;
+            st_switch++;
+        } else if (a < 55) {                        /* SAVE or GLO held, a white key: a favourite */
+            held_btn = 1u << (rnd(2) ? B_SAVE : B_GLO);
+            web_buttons(held_btn);
+            ms(80);
+            k = key_of(0, rnd(16));
+            web_keys(1u << k | held_keys);
+            ms(60);
+            web_keys(held_keys);
+            ms(40);
+            if (rnd(2)) {
+                held_btn = 0;
+                web_buttons(0);
+            }
+        } else if (a < 70) {                        /* black keys: a tap, a hold, with GLO */
+            k = key_of(1, rnd(6));
+            if (rnd(3) == 0) {
+                held_btn = 1u << B_GLO;
+                web_buttons(held_btn);
+            }
+            held_keys ^= 1u << k;
+            web_keys(held_keys);
+            ms(rnd(2) ? 60 : 900);
+            if (rnd(2)) {
+                held_keys &= ~(1u << k);
+                web_keys(held_keys);
+            }
+        } else if (a < 82) {                        /* white keys: the lead */
+            k = key_of(0, rnd(16));
+            held_keys ^= 1u << k;
+            web_keys(held_keys);
+        } else if (a < 88) {                        /* MIDI in */
+            ch = rnd(16);
+            v = 36u + rnd(48);
+            web_midi(0x90u | ch, v, 1u + rnd(127));
+            ms(rnd(400));
+            web_midi(0x80u | ch, v, 0);
+        } else if (a < 91) {                        /* everything let go */
+            held_keys = held_btn = 0;
+            web_keys(0);
+            web_buttons(0);
+        } else if (a < 94) {                        /* the MENU: opened (HOME held), a knob there, closed */
+            web_buttons(1u << B_HOME);
+            ms(900);
+            web_buttons(0);
+            ms(100);
+            web_enc(ENCS[rnd(7)], (int32_t)rnd(5) - 2);
+            ms(200);
+            web_buttons(1u << B_HOME);
+            ms(60);
+            web_buttons(0);
+        } else if (a < 95) {                        /* a power cycle, the flash kept */
+            boot();
+            st_boot++;
+        } else
+            ms(2000 + rnd(20000));                  /* (a while: sections go by) */
+        ms(20 + rnd(780));
+        invariants(i);
+    }
+    web_keys(0);
+    web_buttons(0);
+    ms(200);
+    if (song.playing) {
+        web_buttons(1u << B_PLAY);
+        ms(40);
+        web_buttons(0);
+    }
+    ms(12000);
+    for (k = 0, v = 0; k < NTRK; k++)
+        for (i = 0; i < NVOICE; i++)
+            v += trk[k].v[i].active && trk[k].v[i].stage != 4u;
+    if (v)
+        fail("voices still sounding 12 s after STOP", v, 0);
+    for (ch = 0; ch < 16u; ch++)
+        for (k = 0; k < 128u; k++)
+            if (on[ch][k])
+                fail("a note left on on USB MIDI (channel, pitch)", ch + 1u, k);
+    boot();                                         /* a fresh device on the same flash */
+    if (vb_mode)
+        web_buttons(1u << B_PLAY);
+    else {
+        web_buttons(1u << B_HOME);
+        ms(60);
+        web_buttons(1u << B_HOME | 1u << B_PLAY);
+        ms(60);
+        web_buttons(0);
+        ms(200);
+        web_buttons(1u << B_PLAY);
+    }
+    ms(40);
+    web_buttons(0);
+    if (song.g[G_CLOCK])
+        ext_clock(6000);                            /* (the fuzzing left CLOCK on USB or TRS: a clock from outside) */
+    else
+        ms(6000);
+    if (!song.playing || !vb.own)
+        fail("a fresh device on that flash: the VIZZBOX does not play", song.playing, vb.own);
+    printf("vizzbox_fuzz: %u actions (seed %u): the producer playing %u s, %u sections, %u styles, %u mode switches, "
+           "%u power cycles, favourites written %u times; %u failed\n", n, argc > 2 ? (uint32_t)atoi(argv[2]) : 1u,
+           st_play * 128u / 44100u, st_secs, st_style, st_switch, st_boot, vb_fav.magic == VB_FMAGIC ? vb_fav.seq : 0u, fails);
+    return fails ? 1 : 0;
+}
diff --git a/tests/vizzbox_inactive.c b/tests/vizzbox_inactive.c
new file mode 100644
index 0000000..ba9bedd
--- /dev/null
+++ b/tests/vizzbox_inactive.c
@@ -0,0 +1,104 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox) The GROOVEBOX with the producer compiled in plays as Vizz 2.0 does (BRIEF-VIZZBOX.md 9: "GROOVEBOX,
+ * Produzent nicht aktiv"): the browser emulator's device (web/emu/felucca_web.c) built twice, VIZZBOX 0 (Skiff's
+ * sources as Vizz 2.0 builds them: the hooks empty) and VIZZBOX 1 (the producer and its screen in, the unit in the
+ * GROOVEBOX), each driven through the same gestures: native_check.c's heavy song played, keys, a knob, a track's
+ * MUTE on the black keys, MIDI in, STOP. Each scene's audio (16-bit, both channels), what went out on USB MIDI (notes,
+ * CC 102, CC 103, Start / Stop, the clock) and the screen hashed; tests/run_tests.sh compares the two builds' lines.
+ *   cc -O2 -ffp-contract=off -w [-DVIZZBOX=1] -Ibuild/gen -Ifirmware/src -o OUT tests/vizzbox_inactive.c -lm */
+#include "../web/emu/felucca_web.c"
+#include <math.h>
+
+static uint32_t ahash, mhash, nmidi;
+static void drain(void)
+{
+    while (mo_r != mo_w) {
+        uint32_t pkt = midi_out_q[mo_r % MQ];
+        mo_r++;
+        mhash = (mhash ^ pkt) * 16777619u;
+        nmidi++;
+    }
+}
+static void ms(uint32_t n)                          /* the device runs n ms, in 128-frame calls */
+{
+    uint32_t f = n * 441u / 10u, k, i;
+    for (k = 0; k < f; k += 128u) {
+        uint32_t m = f - k < 128u ? f - k : 128u;
+        web_render(m);
+        for (i = 0; i < m; i++) {
+            int32_t s = (int32_t)lrintf(out_l[i] * 32767.0f) * 3 + (int32_t)lrintf(out_r[i] * 32767.0f);
+            ahash = (ahash ^ (uint32_t)s) * 16777619u;
+        }
+        drain();
+    }
+}
+static void scene(const char *name)
+{
+    uint32_t h = 2166136261u, i;
+    for (i = 0; i < 240u * 240u; i++)
+        h = (h ^ web_fb[i]) * 16777619u;
+    printf("inactive: %-34s audio %08x  midi %08x (%5u)  screen %08x\n", name, ahash, mhash, nmidi, h);
+    ahash = mhash = 2166136261u;
+    nmidi = 0;
+}
+static void press(uint32_t labels)
+{
+    web_buttons(labels);
+    ms(60);
+    web_buttons(0);
+    ms(60);
+}
+static uint32_t key_of(int black, uint32_t place)
+{
+    uint32_t k;
+    for (k = 0; k < 27u; k++)
+        if (key_black(k) == black && key_place(k) == place)
+            return k;
+    return 0;
+}
+
+int main(void)
+{
+    ahash = mhash = 2166136261u;
+    web_nor_erase();
+    web_boot();
+    usb.config = 1;
+    web_master(1023);
+#if VIZZBOX
+    CPU2_BYTE |= VB_MODE_BIT;                       /* (the unit in the GROOVEBOX, as one switched there before) */
+    vb_mode = 0;
+    ui.force = 1;
+#endif
+    ms(1500);
+    scene("boot, the splash, HOME");
+    web_test_heavy();
+    press(1u << B_PLAY);
+    ms(8000);
+    scene("the heavy song, 8 s");
+    web_keys(1u << key_of(0, 3));                   /* a white key: the selected track's note */
+    ms(400);
+    web_keys(1u << key_of(0, 3) | 1u << key_of(0, 5));
+    ms(400);
+    web_keys(0);
+    ms(1200);
+    scene("white keys over it");
+    web_enc(EN_K1, 6);
+    ms(300);
+    web_enc(EN_K2, -4);
+    ms(1500);
+    scene("knobs 1 and 2 turned");
+    web_keys(1u << key_of(1, 1));                   /* a black key tapped: T2's MUTE (CC 103) */
+    ms(80);
+    web_keys(0);
+    ms(2000);
+    scene("a black key: T2 muted");
+    web_midi(0x90u, 60, 100);                       /* MIDI in on channel 1: a note into the selected track */
+    ms(500);
+    web_midi(0x80u, 60, 0);
+    ms(1500);
+    scene("MIDI in");
+    press(1u << B_PLAY);
+    ms(3000);
+    scene("STOP, the tails");
+    return 0;
+}
diff --git a/tests/vizzbox_mutants.py b/tests/vizzbox_mutants.py
