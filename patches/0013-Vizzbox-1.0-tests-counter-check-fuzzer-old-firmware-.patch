@@ -0,0 +1,212 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""(Vizzbox) The counter-check (BRIEF-VIZZBOX.md 9): each deliberate fault in the producer, its screen or its installer
+must make its tests fail, as tests/vizz_mutants.py does for Vizz 2.0's (which stays and must still catch all of
+its own). Run from the tree after ./build.sh (build/gen) and, for the installer's faults, with the installers and
+conv.wasm as tests/run_tests.sh makes them (build/host/vizzbox-installer.html, build/host/vizz-installer.html,
+build/conv/conv.wasm):
+
+  python3 tests/vizzbox_mutants.py [--no-installer] [--only TEXT]     (--only: the faults whose words hold TEXT)
+
+Each fault is put into a copy of the sources in a scratch folder, the test that should see it built from that copy
+and run (tests/producer_test.c with the case named, tests/vizzbox_inactive.c both ways, tests/vizzbox_ui.c against
+its golden); the report lists the checks that failed. A fault none fails is a hole in the tests: the run fails."""
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+P, ISR, UI, PRJ = "producer.c", "producer_isr.c", "ui_vizzbox.c", "project.c"
+# (what, file, [(old, new), ...], test): test ("producer", CASE[, SUBGENRE]), ("inactive",) or ("ui",)
+FAULTS = [
+    ("determinism: a song depends on the songs played before it", P, [
+        ("static void vb_stream(uint32_t what, uint32_t a, uint32_t b)\n{\n"
+         "    vb_r = vb_hash((uint32_t)vb.s.seed * 0x9E3779B1u ^ vb_hash(what << 24 ^ a << 12 ^ b)) | 1u;",
+         "static uint32_t vb_songs;\nstatic void vb_stream(uint32_t what, uint32_t a, uint32_t b)\n{\n"
+         "    vb_r = vb_hash((uint32_t)vb.s.seed * 0x9E3779B1u ^ vb_hash(what << 24 ^ a << 12 ^ b) ^ vb_songs) | 1u;"),
+        ("    vb.s = vb.k;\n    vb_song();\n    vb_load();", "    vb.s = vb.k;\n    vb_songs++;\n    vb_song();\n    vb_load();")],
+     ("producer", "favourites")),
+    ("determinism: the seed left out (another seed, the same song)", P, [
+        ("vb_hash((uint32_t)vb.s.seed * 0x9E3779B1u ^", "vb_hash(0x5EEDu * 0x9E3779B1u ^"),
+        ("(vb_hash(s->seed ^ 0x51u) %", "(vb_hash(0x5EEDu ^ 0x51u) %")],
+     ("producer", "determinism")),
+    ("CC 104 .. 109 a 1/16 late (on the bar's second step)", ISR, [
+        ("        if (!s || vb_out != o || vb_resend) {", "        if (s == 1u || vb_out != o || vb_resend) {")],
+     ("producer", "song", "0")),
+    ("CC 104 never sent (the six from 105 on)", ISR, [
+        ("            for (i = 0; i < 6u; i++)\n                vb_cc(VB_CC + i, i == 1u ? e : c->cc[i]);\n"
+         "            vb_out = (uint8_t)o;\n            vb_resend = 0;\n            vb_e = (uint8_t)e;",
+         "            for (i = 1; i < 6u; i++)\n                vb_cc(VB_CC + i, i == 1u ? e : c->cc[i]);\n"
+         "            vb_out = (uint8_t)o;\n            vb_resend = 0;\n            vb_e = (uint8_t)e;")],
+     ("producer", "song", "0")),
+    ("CC 104 not 0 at the stop", ISR, [
+        ("    if (song.playing)\n        vb_cc(VB_CC, 0);\n    vb_hold_fx(PF_N);", "    vb_hold_fx(PF_N);")],
+     ("producer", "transport")),
+    ("CC 104 .. 109 on channel 15", ISR, [("#define VB_CH 15u", "#define VB_CH 14u")], ("producer", "song", "0")),
+    ("CC 104 .. 109 with SEQ MIDI OUT OFF", ISR, [
+        ("    if (seq_midi_on)\n        midi_out_event(0x0Bu | (0xB0u | VB_CH) << 8", "    if (1)\n        midi_out_event(0x0Bu | (0xB0u | VB_CH) << 8")],
+     ("producer", "transport")),
+    ("the six not again when SEQ MIDI OUT turns on or USB comes up", ISR, [
+        ("    o = 1u | (seq_midi_on ? 2u : 0u) | (usb.config ? 4u : 0u);", "    o = 1u;")],
+     ("producer", "transport")),
+    ("no CC 104 0 into the GROOVEBOX (a unit whose producer never played)", UI, [
+        ("        vb_resend = 2;                              /* (BRIEF 5: into the GROOVEBOX, CC 104 0 once) */", "")],
+     ("producer", "switch")),
+    ("the producer's ISR part runs in the GROOVEBOX too (vb_run left out)", ISR, [
+        ("    if (!vb_run || !song.playing || c->bar != st >> 4)", "    if (!song.playing || c->bar != st >> 4)")],
+     ("inactive",)),
+    ("a DROP without its kick on its one", P, [
+        ("        if (lanes & 1u)\n            vb_hit(0, LN_KICK, 120u);\n    }",
+         "        vb_o[0].hit &= (uint8_t)~(1u << LN_KICK);\n    }")],
+     ("producer", "song", "0")),
+    ("a BUILD without its roll and without its riser", P, [
+        ("        roll = left <= 4u ? 5u - left : 0u;", "        roll = 0;"),
+        ("    if (c->type == VS_BUILD) {\n        if (!vb.sbar)\n            vb_put(0, 72u, 100u);\n"
+         "        vb_hold(vb.sbar ? 0u : 1u, 16u);\n    } else if (c->type == VS_DROP) {",
+         "    if (c->type == VS_BUILD) {\n    } else if (c->type == VS_DROP) {")],
+     ("producer", "song", "0")),
+    ("notes a semitone off the key (a scale degree's semitones)", P, [
+        ("            d--;\n        }\n    return o + (int32_t)i;\n}", "            d--;\n        }\n    return o + (int32_t)i + 1;\n}")],
+     ("producer", "song", "0")),
+    ("the voice budget off", P, [("    vb_budget(dst);\n", "    (void)vb_budget;\n")], ("producer", "song", "0")),
+    ("the arrangement through the user's MUTE", P, [
+        ("        vb_o = dst[k];\n        vb_clear();\n        if (!((m >> k) & 1u))",
+         "        vb_o = dst[k];\n        vb_clear();\n        trk[k].p[P_MUTE] = !((m >> k) & 1u);\n        if (!((m >> k) & 1u))")],
+     ("producer", "mute")),
+    ("ENERGY at once (not from the next section)", P, [
+        ("    return (uint32_t)clamp(e, 0, 100) * (35u + 65u * vb.s.energy / 100u) / 100u;",
+         "    return (uint32_t)clamp(e, 0, 100) * (35u + 65u * vb.k.energy / 100u) / 100u;")],
+     ("producer", "live")),
+    ("ENDLESS never moves to a related subgenre", P, [
+        ("        vb_related();                               /* (ENDLESS: after a DROP (ambient: a BREAK), now and then a",
+         "        (void)0;                                    /* (ENDLESS: after a DROP (ambient: a BREAK), now and then a")],
+     ("producer", "endless")),
+    ("a favourite stored but not written", UI, [
+        ("    if (st_erase(off) || st_prog(off, &vb_fav, sizeof vb_fav))", "    if (st_erase(off))")],
+     ("producer", "favourites")),
+    ("a favourite written while playing (an erase stops the audio)", UI, [
+        ("    if (!vb_fav_dirty || song.playing || !flash_ok)", "    if (!vb_fav_dirty || !flash_ok)")],
+     ("producer", "favourites")),
+    ("the GROOVEBOX's music not given back", P, [
+        ("    vb_run = 0;\n    vb_resend = 2;\n    if (vb.kept) {", "    vb_run = 0;\n    vb_resend = 2;\n    if (0) {")],
+     ("producer", "modes")),
+    ("the autosave keeps the producer's song as the user's session", PRJ, [
+        ("    if (vb_owns())\n        return;                                    /* ((Vizzbox) the producer's song is no session to keep) */",
+         "    (void)vb_owns;")],
+     ("producer", "projects")),
+    ("the screen's bar counted from 0", UI, [("        p = vb_num(p, (uint32_t)vb.sbar + 1u);", "        p = vb_num(p, (uint32_t)vb.sbar);")],
+     ("ui",)),
+]
+INSTALLER = [
+    ("the installer: a Vizzbox told by its version (v1.0: before 2.0, a backup)",
+     "!before20(device.id, info)", "major(info.version) >= 2"),
+    ("the installer: no backup, as Skiff's page by the package's version (1.0)",
+     "  // (Vizzbox) its 1.0 is Skiff 2.0 inside: the backup and the conversion as 2.0's\n",
+     "  if (major(meta.version) < 2) return null;\n"),
+]
+CFLAGS = ["-O2", "-ffp-contract=off", "-w"]
+
+
+def run(cmd, **kw):
+    return subprocess.run(cmd, capture_output=True, text=True, **kw)
+
+
+def build(work, src, out, extra=()):
+    gen = os.path.join(ROOT, "build", "gen")
+    return run(["cc", *CFLAGS, *extra, "-I" + gen, "-I" + os.path.join(work, "firmware", "src"), "-o", out,
+                os.path.join(work, "tests", src), "-lm"])
+
+
+def check(work, test):
+    """the test on the copy in work: (built, [the checks that failed])"""
+    if test[0] == "producer":
+        exe = os.path.join(work, "producer_test")
+        r = build(work, "producer_test.c", exe)
+        if r.returncode:
+            return False, r.stderr[-400:]
+        out = run([exe, *test[1:]]).stdout
+        return True, [ln[5:] for ln in out.splitlines() if ln.startswith("FAIL ")]
+    if test[0] == "inactive":
+        res = []
+        for v in "01":
+            exe = os.path.join(work, "inactive" + v)
+            r = build(work, "vizzbox_inactive.c", exe, ["-DVIZZBOX=" + v])
+            if r.returncode:
+                return False, r.stderr[-400:]
+            res.append(run([exe]).stdout.splitlines())
+        return True, [f"{a.split('  audio')[0].strip()}: VIZZBOX 0 / 1 differ" for a, b in zip(*res) if a != b]
+    exe = os.path.join(work, "vizzbox_ui")
+    r = build(work, "vizzbox_ui.c", exe)
+    if r.returncode:
+        return False, r.stderr[-400:]
+    want = open(os.path.join(ROOT, "tests", "vizzbox_ui_golden.txt")).read().splitlines()
+    got = run([exe]).stdout.splitlines()
+    return True, [f"{a.split()[0]}: the screen changed" for a, b in zip(want, got) if a != b] + \
+        (["screens missing"] if len(got) != len(want) else [])
+
+
+def main():
+    work = tempfile.mkdtemp(prefix="vizzbox_mutants.")
+    holes = 0
+    try:
+        for d in ("firmware", "tests", "web"):
+            shutil.copytree(os.path.join(ROOT, d), os.path.join(work, d))
+        for t in [("producer", "song", "0"), ("producer", "transport"), ("inactive",), ("ui",)]:
+            ok, failed = check(work, t)
+            if not ok or failed:
+                sys.exit(f"vizzbox_mutants: {t} fails without a fault: {failed if ok else 'does not build'}")
+        only = sys.argv[sys.argv.index("--only") + 1] if "--only" in sys.argv else None
+        for what, f, pairs, test in FAULTS:
+            if only and only not in what:
+                continue
+            p = os.path.join(work, "firmware", "src", f)
+            src = bad = open(p, encoding="utf-8").read()
+            for old, new in pairs:
+                if bad.count(old) != 1:
+                    sys.exit(f"vizzbox_mutants: {what}: the place is not in {f} once; update the fault")
+                bad = bad.replace(old, new)
+            open(p, "w", encoding="utf-8").write(bad)
+            try:
+                built, failed = check(work, test)
+            finally:
+                open(p, "w", encoding="utf-8").write(src)
+            if not built:
+                print(f"vizzbox_mutants: {what}: does not build\n{failed}")
+                holes += 1
+                continue
+            print(f"vizzbox_mutants: {what} [{' '.join(test)}]: {len(failed)} checks fail"
+                  f"{'' if failed else '  <- a hole in the tests'}")
+            for x in failed[:3]:
+                print(f"vizzbox_mutants:     {x[:110]}")
+            holes += not failed
+        if "--no-installer" not in sys.argv and not only:
+            html = os.path.join(ROOT, "build", "host", "vizzbox-installer.html")
+            good = open(html, encoding="utf-8").read()
+            for what, old, new in INSTALLER:
+                if good.count(old) != 1:
+                    sys.exit(f"vizzbox_mutants: {what}: the place is not in the installer once; update the fault")
+                bad = os.path.join(work, "vizzbox-installer.html")
+                open(bad, "w", encoding="utf-8").write(good.replace(old, new))
+                r = run(["node", os.path.join(ROOT, "web", "test_vizzbox_installer.mjs"), bad,
+                         os.path.join(ROOT, "tests", "vizz10_unit.json"), os.path.join(ROOT, "build", "conv", "conv.wasm"),
+                         os.path.join(ROOT, "build", "host", "vizz-installer.html")])
+                if "skipped (no Playwright)" in r.stdout:
+                    print(f"vizzbox_mutants: {what}: skipped (no Playwright)")
+                    continue
+                failed = [ln.replace("vizzbox installer: ", "").rsplit(" FAIL", 1)[0].strip()
+                          for ln in r.stdout.splitlines() if ln.endswith("FAIL")]
+                print(f"vizzbox_mutants: {what}: {len(failed)} checks fail{'' if failed else '  <- a hole in the tests'}")
+                for x in failed[:3]:
+                    print(f"vizzbox_mutants:     {x[:110]}")
+                holes += not failed
+    finally:
+        shutil.rmtree(work, ignore_errors=True)
+    print("vizzbox_mutants: " + ("every fault caught" if not holes else f"{holes} faults not caught"))
+    sys.exit(1 if holes else 0)
+
+
+if __name__ == "__main__":
+    main()
