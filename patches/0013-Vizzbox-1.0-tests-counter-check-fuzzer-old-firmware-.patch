+/* into the GROOVEBOX on a unit whose producer never played: CC 104 0 once (BRIEF 5), nothing else of the six */
+static void case_switch(void)
+{
+    uint32_t i, zero = 0, other = 0;
+    snprintf(tag, sizeof tag, "switch");
+    boot();
+    nev = 0;
+    web_buttons(1u << B_HOME);
+    run_s(0.06);
+    web_buttons(1u << B_HOME | 1u << B_PLAY);
+    run_s(0.06);
+    web_buttons(0);
+    run_s(0.5);
+    ok(!vb_mode, "HOME + PLAY: still the VIZZBOX");
+    for (i = 0; i < nev; i++)
+        if (ev[i].st == 0xBFu && ev[i].d1 >= 104u && ev[i].d1 <= 109u) {
+            zero += ev[i].d1 == 104u && !ev[i].d2;
+            other += ev[i].d1 != 104u || ev[i].d2;
+        }
+    ok(zero == 1u && !other, "into the GROOVEBOX, never played: CC 104 0 %u times, %u others", zero, other);
+}
 /* PLAY and stop; SEQ MIDI OUT OFF, then on while playing; USB coming up; the GROOVEBOX */
 static void case_transport(void)
 {
@@ -610,6 +631,99 @@ static void case_favourites(void)
     if (read(p[0], &a, sizeof a) != (ssize_t)sizeof a)
         ok(0, "no answer");
     ok(a == direct, "loaded after off and on: MIDI %08x, played directly %08x", a, direct);
+    {   /* SAVE + a white key while playing: kept, written once stopped (an erase stops the audio) */
+        static uint8_t was[0x2000];
+        uint32_t k6;
+        for (k6 = 0; k6 < 27u && !(!key_black(k6) && key_place(k6) == 5u); k6++)
+            ;
+        knobs(1, 4, 0x6666u, 60, 30, 1);
+        press(1u << B_PLAY);
+        run_s(5.0);
+        memcpy(was, nor + 0x95000u, sizeof was);
+        web_buttons(1u << B_SAVE);
+        run_s(0.1);
+        web_keys(1u << k6);
+        run_s(0.08);
+        web_keys(0);
+        web_buttons(0);
+        run_s(2.0);
+        ok(vb_fav.f[5].seed == 0x6666u && !memcmp(was, nor + 0x95000u, sizeof was) && song.playing,
+           "saved while playing: not kept, or written while the audio plays");
+        press(1u << B_PLAY);
+        run_s(0.5);
+        ok(memcmp(was, nor + 0x95000u, sizeof was) != 0, "saved while playing: not written once stopped");
+    }
+}
+
+/* the user's music and projects (BRIEF: "Die gespeicherten Projekte des Nutzers fasst der Produzent nie an"): slot 1
+ * saved in the GROOVEBOX, the autosave settled; then 70 s of the producer's songs (a knob turned, a new style) and back
+ * into the GROOVEBOX: the projects, user samples and presets (0x97000..0xDFFFF), the autosave and the pattern pool
+ * (0xE5000..0xE8FFF) byte for byte as before; off and on (a fresh device on that flash): the GROOVEBOX with the user's
+ * music, slot 1 as saved */
+static struct { uint8_t nor[0x100000]; uint32_t store, autos; } pj;
+static void proj_music(void)
+{
+    uint32_t i;
+    for (i = 0; i < 16u; i++)
+        memset(&trk[0].step[i], 0, sizeof trk[0].step[i]);
+    for (i = 0; i < 16u; i += 4u)
+        trk[0].step[i] = (step_t){{(uint8_t)(41u + i / 4u)}, 1, ST_NOTE, 0, 99};
+    song.g[G_BPM] = 97;
+}
+static int proj_is(void)
+{
+    return trk[0].step[0].n == 1u && trk[0].step[0].note[0] == 41u && trk[0].step[12].note[0] == 44u &&
+           !trk[0].step[1].n && song.g[G_BPM] == 97;
+}
+static void proj_run(void *a)
+{
+    static uint8_t store[0xE0000u - 0x97000u], autos[0xE9000u - 0xE5000u];
+    (void)a;
+    boot();
+    vb_mode_set(0);
+    run_s(0.3);
+    proj_music();
+    ok(!project_save_as(0, "MINE"), "slot 1 not saved");
+    run_s(15.0);                                    /* (the autosave settled) */
+    memcpy(store, nor + 0x97000u, sizeof store);
+    memcpy(autos, nor + 0xE5000u, sizeof autos);
+    web_buttons(1u << B_HOME);                      /* HOME + PLAY: the VIZZBOX, PLAY */
+    run_s(0.06);
+    web_buttons(1u << B_HOME | 1u << B_PLAY);
+    run_s(0.06);
+    web_buttons(0);
+    run_s(0.3);
+    press(1u << B_PLAY);
+    run_s(30.0);
+    web_enc(EN_K1, 2);                              /* (another genre: a new style over a BREAK and a BUILD) */
+    run_s(40.0);
+    press(1u << B_PLAY);
+    run_s(3.0);
+    web_buttons(1u << B_HOME);                      /* back into the GROOVEBOX, stopped */
+    run_s(0.06);
+    web_buttons(1u << B_HOME | 1u << B_PLAY);
+    run_s(0.06);
+    web_buttons(0);
+    run_s(25.0);
+    pj.store = !memcmp(store, nor + 0x97000u, sizeof store);
+    pj.autos = !memcmp(autos, nor + 0xE5000u, sizeof autos);
+    memcpy(pj.nor, nor, sizeof nor);
+}
+static void case_projects(void)
+{
+    char b[PROJ_NAME_LEN + 1];
+    snprintf(tag, sizeof tag, "projects");
+    ok(!spawn(proj_run, &pj, sizeof pj), "no answer");
+    ok(pj.store, "the producer's session changed the projects, user samples or presets (0x97000..0xDFFFF)");
+    ok(pj.autos, "the producer's session changed the autosave or the pattern pool (0xE5000..0xE8FFF)");
+    memcpy(nor, pj.nor, sizeof nor);                /* off and on: a fresh device on that flash */
+    web_boot();
+    usb.config = 1;
+    web_master(1023);
+    run_s(1.5);
+    ok(!vb_mode, "off and on: not in the GROOVEBOX, where it was left");
+    ok(proj_is(), "off and on: the GROOVEBOX without the user's music");
+    ok(project_name(0, b) && !strcmp(b, "MINE"), "off and on: slot 1 not MINE");
 }
 
