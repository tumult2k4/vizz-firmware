+++ b/web/emu/make_vizzbox_emu.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+# (Vizzbox, BRIEF-VIZZBOX.md 8: "eine Vizzbox-Fassung als eine HTML-Datei in demos/")
+"""The Vizzbox in the browser as one file: Skiff's browser emulator (web/emu: the firmware's own sources in
+WebAssembly, played in an AudioWorklet, the panel drawn by web/panel.js) built with VIZZBOX=1, its page with the
+WebAssembly, the worklet, the panel's script and the font inside, so the file works opened from the disk.
+
+  emcc ... -DVIZZBOX=1 -o build/emu_vizzbox/felucca.wasm web/emu/felucca_web.c     (as web/emu/build.sh, see below)
+  web/emu/make_vizzbox_emu.py build/emu_vizzbox/felucca.wasm VERSION OUT.html
+
+A new unit starts in the VIZZBOX: knob 1 GENRE, 2 SUBGENRE, 3 ENERGY, 4 VARIATION, PLAY. Its saves stay in the
+browser (its own key, apart from Skiff's page). The page's words: Skiff's, with the Vizzbox's name, its controls in
+German, and the credits of Skiff, Felucca, X0X and the font kept."""
+import base64
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+
+
+def sub(html, old, new, n=1):
+    if html.count(old) != n:
+        raise SystemExit(f"web/emu/index.html must contain {old[:60]!r} {n} time(s); update make_vizzbox_emu.py")
+    return html.replace(old, new)
+
+
+def page(wasm_path, version):
+    html = (HERE / "index.html").read_text(encoding="utf-8")
+    worklet = (HERE / "worklet.js").read_text(encoding="utf-8")
+    panel = (HERE.parent / "panel.js").read_text(encoding="utf-8")
+    font = base64.b64encode((HERE / "fonts" / "DotGothic16-subset.woff").read_bytes()).decode()
+    ofl = (HERE / "fonts" / "OFL.txt").read_text(encoding="utf-8")
+    wasm = base64.b64encode(Path(wasm_path).read_bytes()).decode()
+    if "</script" in worklet or "</script" in panel:
+        raise SystemExit("a script holds </script: it cannot go inline")
+    html = sub(html, "<title>Try Skiff</title>", "<title>Vizzbox im Browser</title>")
+    html = sub(html, 'content="Skiff, the six-track groovebox firmware for the M-VAVE FM-1, running in your browser: '
+                     'the same code the unit runs."',
+               'content="Die Vizzbox – ein Produzent für die M-VAVE FM-1, der die Musik selbst macht – im Browser: '
+                     'derselbe Code wie auf dem Gerät."')
+    html = sub(html, 'url("fonts/DotGothic16-subset.woff")', f'url("data:font/woff;base64,{font}")')
+    html = sub(html, '<small class="version">@VERSION@@PREVIEW@</small><br>',
+               f'<small class="version">Vizzbox {version}</small><br>\n'
+               '  <b>VIZZBOX:</b> Regler 1 GENRE · 2 SUBGENRE · 3 ENERGIE · 4 VARIATION · SELECT TEMPO · ALGORITHM LÄNGE · '
+               'PRESETS Seed · PLAY Start/Stopp · REC neuer Seed · FX DROP JETZT · ARP BREAK JETZT · SEQ HALTEN · '
+               'HOME + PLAY GROOVEBOX (dort HOME + PLAY zurück)<br>\n'
+               '  Die Vizzbox ist eine geänderte Fassung von Skiff 2.0.1 (Vizz 2.0 und ein Produzent), GPL-3.0; '
+               'nicht von Skiff veröffentlicht.<br>')
+    html = sub(html, '<a href="fonts/OFL.txt">SIL OFL 1.1</a>', '<a href="#ofl">SIL OFL 1.1</a>')
+    html = sub(html, '<nav><a href="../webapp/installer/">Install</a><a href="../webapp/editor/">Editor</a>'
+                     '<a href="../learn/">Learn</a><a href="https://github.com/illuminus5/skiff">Source</a></nav>',
+               '<nav><a href="https://github.com/illuminus5/skiff">Skiff source</a></nav>')
+    html = sub(html, "Skiff is not affiliated with or endorsed by them.</small>",
+               "Skiff and the Vizzbox are not affiliated with or endorsed by them.</small>\n"
+               f'  <details id="ofl"><summary>DotGothic16: SIL Open Font License 1.1</summary><pre>{ofl}</pre></details>')
+    html = sub(html, '<script src="../panel.js"></script>', f"<script>\n{panel}\n</script>")
+    html = sub(html, 'const STORE = "skiff-emu-flash";', 'const STORE = "vizzbox-emu-flash";   // (Vizzbox: its own saves)')
+    html = sub(html, 'fetch("felucca.wasm").then((r) => { if (!r.ok) throw new Error(`felucca.wasm: ${r.status}`); '
+                     'return r.arrayBuffer(); }),',
+               'Promise.resolve(Uint8Array.from(atob(document.getElementById("wasm").textContent), '
+               '(c) => c.charCodeAt(0)).buffer),')
+    # (the worklet from a data: URL: under file://, an opaque origin, a blob: URL does not load as a module)
+    html = sub(html, 'ac.audioWorklet.addModule("worklet.js")',
+               'ac.audioWorklet.addModule("data:text/javascript;base64," + '
+               'btoa(unescape(encodeURIComponent(document.getElementById("worklet").textContent))))')
+    html = sub(html, "</body>", f'<script type="application/octet-stream" id="wasm">{wasm}</script>\n'
+                                f'<script type="text/plain" id="worklet">{worklet}</script>\n</body>')
+    for w in ("@VERSION@", "@PREVIEW@", '"felucca.wasm"', '"worklet.js"', 'src="../panel.js"'):
+        if w in html:
+            raise SystemExit(f"left in the page: {w}")
+    return html
+
+
+if __name__ == "__main__":
+    if len(sys.argv) != 4:
+        sys.exit("usage: make_vizzbox_emu.py FELUCCA.wasm VERSION OUT.html")
+    out = Path(sys.argv[3])
+    out.write_text(page(sys.argv[1], sys.argv[2]), encoding="utf-8")
+    print(f"vizzbox emu: {out} ({out.stat().st_size} B), Vizzbox {sys.argv[2]}")
diff --git a/web/emu/test_vizzbox_emu.mjs b/web/emu/test_vizzbox_emu.mjs
new file mode 100644
index 0000000..f238478
--- /dev/null
+++ b/web/emu/test_vizzbox_emu.mjs
@@ -0,0 +1,83 @@
+// SPDX-License-Identifier: GPL-3.0-only
+// (Vizzbox) The one-file Vizzbox in the browser (web/emu/make_vizzbox_emu.py) in Chromium (Playwright), opened from
+// the disk as a user would: it switches on (the WebAssembly and the worklet from inside the page), boots into the
+// VIZZBOX (its screen drawn), KNOB 1 turned with the mouse wheel changes the genre on the screen, PLAY plays (the
+// screen moves on bar by bar, the audio is not silent: an AnalyserNode on the output), PLAY again stops; no script
+// errors. Screenshots of the screen to OUT when given.
+//   node web/emu/test_vizzbox_emu.mjs VIZZBOX-EMU.html [OUT]
+import { createRequire } from "module";
+import { mkdirSync, writeFileSync } from "fs";
+import { pathToFileURL } from "url";
+
+const [htmlPath, outDir] = process.argv.slice(2);
+if (!htmlPath) { console.log("usage: test_vizzbox_emu.mjs VIZZBOX-EMU.html [OUT]"); process.exit(2); }
+let chromium;
+try { ({ chromium } = createRequire(import.meta.url)("playwright")); }
+catch { console.log("vizzbox emu: skipped (no Playwright)"); process.exit(0); }
+
+let fails = 0;
+const ok = (c, what) => { console.log(`vizzbox emu: ${what.padEnd(84)} ${c ? "ok" : "FAIL"}`); if (!c) fails++; };
+const browser = await chromium.launch({ args: ["--autoplay-policy=no-user-gesture-required"] });
+const page = await (await browser.newContext({ locale: "de-DE" })).newPage();
+const errors = [];
+page.on("pageerror", (e) => errors.push(String(e)));
+page.on("console", (m) => { if (m.type() === "error") errors.push(m.text()); });
+/* a tap on the output: the page's AudioWorkletNode connects to the destination; an AnalyserNode beside it */
+await page.addInitScript(() => {
+  const connect = AudioNode.prototype.connect;
+  AudioNode.prototype.connect = function (dst, ...rest) {
+    if (this instanceof AudioWorkletNode && dst instanceof AudioDestinationNode) {
+      const an = new AnalyserNode(this.context, { fftSize: 2048 });
+      connect.call(this, an);
+      window.__peak = () => { const b = new Float32Array(an.fftSize); an.getFloatTimeDomainData(b); return Math.max(...b.map(Math.abs)); };
+    }
+    return connect.call(this, dst, ...rest);
+  };
+});
+await page.goto(pathToFileURL(htmlPath).href);
+ok(await page.title() === "Vizzbox im Browser", "the page: Vizzbox im Browser");
+await page.click("#go");
+await page.waitForFunction(() => document.getElementById("start").hidden, null, { timeout: 30000 });
+const screen = async (name) => {
+  const png = await page.locator("#screen").screenshot();
+  if (outDir) { mkdirSync(outDir, { recursive: true }); writeFileSync(`${outDir}/${name}.png`, png); }
+  return png.toString("base64");
+};
+await page.waitForTimeout(2500);                  /* (the splash, then the VIZZBOX) */
+const ready = await screen("ready");
+const lit = await page.evaluate(() => {
+  const c = document.getElementById("screen"), d = c.getContext("2d").getImageData(0, 0, 240, 240).data;
+  let n = 0;
+  for (let i = 0; i < d.length; i += 4) n += d[i] + d[i + 1] + d[i + 2] > 120;
+  return n;
+});
+ok(lit > 2000, `switched on: the screen drawn (${lit} lit pixels)`);
+const k1 = page.getByRole("slider", { name: "KNOB 1" }).or(page.locator('[aria-label="KNOB 1"]')).first();
+await k1.hover();
+await page.mouse.wheel(0, -100);
+await page.waitForTimeout(400);
+const genre = await screen("genre");
+ok(genre !== ready, "KNOB 1 (the mouse wheel): the screen shows the next genre");
+await page.waitForTimeout(1600);
+await page.keyboard.press("Minus");               /* (PLAY: the key under '-') */
+await page.waitForTimeout(6000);
+const a = await screen("playing-a");
+const peak = await page.evaluate(async () => {   /* (the loudest 46 ms window over 3 s: a sparse intro has gaps) */
+  let p = -1;
+  for (let i = 0; i < 75 && window.__peak; i++) { p = Math.max(p, window.__peak()); await new Promise((r) => setTimeout(r, 40)); }
+  return p;
+});
+await page.waitForTimeout(3000);
+const b = await screen("playing-b");
+ok(a !== b, "PLAY: the screen moves on while it plays");
+ok(peak > 0.01, `PLAY: the audio is not silent (peak ${peak.toFixed(3)})`);
+await page.keyboard.press("Minus");
+await page.waitForTimeout(4000);
+const c1 = await screen("stopped-a");
+await page.waitForTimeout(1500);
+const c2 = await screen("stopped-b");
+ok(c1 === c2, "PLAY again: stopped (the screen still)");
+ok(!errors.length, `no script errors${errors.length ? ": " + errors.join(" | ").slice(0, 300) : ""}`);
+await browser.close();
+console.log(fails ? `vizzbox emu: ${fails} FAILED` : "vizzbox emu: all ok");
+process.exit(fails ? 1 : 0);
