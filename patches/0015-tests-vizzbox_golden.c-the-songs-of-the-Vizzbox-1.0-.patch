diff --git a/tests/vizzbox_golden.c b/tests/vizzbox_golden.c
new file mode 100644
index 0000000..db5d2c7
--- /dev/null
+++ b/tests/vizzbox_golden.c
@@ -0,0 +1,142 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox 1.1) tests/vizzbox_golden.c: the songs of the Vizzbox 1.0 (BRIEF-VIZZBOX-1.1.md 1, 9): with nobody's hand on
+ * the controls the producer makes the same songs as 1.0 did, bit for bit. Every subgenre of 1.0 with three seeds (each
+ * with its own ENERGY and VARIATION) in every LENGTH (SHORT and NORMAL to their end, ENDLESS for 180 s), and ENDLESS for
+ * ten minutes twice (its subgenres changing): what the unit sends over USB MIDI (every byte, the clock too, and the
+ * sample it went out by) and its audio, each as a hash. tests/vizzbox_golden10.txt holds them as Vizzbox 1.0's tree
+ * made them (this file built against it); a line that differs is a song that changed.
+ * On the browser emulator's device built natively (web/emu/felucca_web.c with VIZZBOX=1), as tests/producer_test.c.
+ *   cc -O2 -ffp-contract=off -w -Ibuild/gen -Ifirmware/src -o build/host/vizzbox_golden tests/vizzbox_golden.c -lm
+ *   build/host/vizzbox_golden > out.txt; diff tests/vizzbox_golden10.txt out.txt
+ *   build/host/vizzbox_golden N      (case N only) */
+#define VIZZBOX 1
+#include "../web/emu/felucca_web.c"
+#include <math.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static uint64_t frames;
+static uint32_t ahash, mhash, nmidi;
+static void drain(void)
+{
+    while (mo_r != mo_w) {
+        uint32_t pkt = midi_out_q[mo_r % MQ], i;
+        uint64_t t = frames;
+        mo_r++;
+        for (i = 0; i < 4u; i++)
+            mhash = (mhash ^ ((pkt >> (8u * i)) & 0xFFu)) * 16777619u;
+        for (i = 0; i < 4u; i++)
+            mhash = (mhash ^ (uint32_t)((t >> (8u * i)) & 0xFFu)) * 16777619u;
+        nmidi++;
+    }
+}
+static void run_frames(uint64_t n)
+{
+    while (n) {
+        uint32_t m = n < 128u ? (uint32_t)n : 128u, k;
+        web_render(m);
+        for (k = 0; k < m; k++) {
+            int32_t s = (int32_t)lrintf(out_l[k] * 32767.0f) * 3 + (int32_t)lrintf(out_r[k] * 32767.0f);
+            ahash = (ahash ^ (uint32_t)s) * 16777619u;
+        }
+        frames += m;
+        drain();
+        n -= m;
+    }
+}
+static void run_s(double s) { run_frames((uint64_t)(s * FS)); }
+static void press(uint32_t labels)
+{
+    web_buttons(labels);
+    run_s(0.04);
+    web_buttons(0);
+    run_s(0.02);
+}
+
+/* case n: subgenre n / 9, its seed n / 3 % 3, its LENGTH n % 3; 324, 325: ENDLESS ten minutes */
+static const uint16_t SEED[3] = {0x5EEDu, 0x0B0Bu, 0xC0DEu};
+static const uint8_t EN[3] = {70, 100, 25}, VA[3] = {40, 90, 10};
+static void one(uint32_t n)
+{
+    uint32_t ri = n / 9u, si = n / 3u % 3u, len = n % 3u, g;
+    double secs, max;
+    if (n >= 324u) {                                /* (ENDLESS ten minutes: DEEP HOUSE, LIQUID) */
+        ri = n == 324u ? 0u : 22u;
+        si = 0;
+        len = 2;
+    }
+    for (g = 0; g < 9u && ri >= vb_sub0(g + 1u); g++)
+        ;
+    web_nor_erase();
+    web_boot();
+    usb.config = 1;
+    web_master(1023);
+    run_s(0.6);
+    frames = 0;
+    nmidi = 0;
+    ahash = mhash = 2166136261u;
+    vb.k.genre = (uint8_t)g;
+    vb.k.sub = (uint8_t)(ri - vb_sub0(g));
+    vb.k.seed = (uint16_t)(SEED[si] + ri * 13u);
+    vb.k.energy = EN[si];
+    vb.k.var = VA[si];
+    vb.k.len = (uint8_t)len;
+    vb.k.bpm = 0;
+    press(1u << B_PLAY);
+    max = len == 2u ? (n >= 324u ? 600.0 : 180.0) : 420.0;
+    for (secs = 0; song.playing && secs < max; secs += 0.5)
+        run_s(0.5);
+    if (song.playing)
+        press(1u << B_PLAY);
+    run_s(1.0);
+    printf("%3u %-10s %-16s %04X E%-3u V%-3u %-7s %4.0f s  midi %08x (%u)  audio %08x\n", n, VB_GNAME[g],
+           VB_SNAME[ri], vb.k.seed, vb.k.energy, vb.k.var, len == 0u ? "SHORT" : len == 1u ? "NORMAL" : "ENDLESS",
+           secs, mhash, nmidi, ahash);
+}
+
+int main(int argc, char **argv)
+{
+    uint32_t n, running = 0, failed = 0, at = 0;
+    static char out[326][160];
+    int fd[326][2];
+    pid_t pid[326];
+    if (argc > 1) {
+        one((uint32_t)atoi(argv[1]));
+        return 0;
+    }
+    fflush(stdout);
+    for (n = 0; n < 326u; n++) {                    /* (four at a time, printed in order) */
+        if (running == 4u) {
+            int st;
+            ssize_t r = read(fd[at][0], out[at], sizeof out[at] - 1u);
+            out[at][r > 0 ? r : 0] = 0;
+            waitpid(pid[at], &st, 0);
+            failed += !WIFEXITED(st) || WEXITSTATUS(st) != 0;
+            fputs(out[at], stdout);
+            fflush(stdout);
+            close(fd[at][0]);
+            at++;
+            running--;
+        }
+        if (pipe(fd[n]))
+            return 2;
+        if (!(pid[n] = fork())) {
+            dup2(fd[n][1], 1);
+            one(n);
+            fflush(stdout);
+            _exit(0);
+        }
+        close(fd[n][1]);
+        running++;
+    }
+    for (; at < 326u; at++) {
+        int st;
+        ssize_t r = read(fd[at][0], out[at], sizeof out[at] - 1u);
+        out[at][r > 0 ? r : 0] = 0;
+        waitpid(pid[at], &st, 0);
+        failed += !WIFEXITED(st) || WEXITSTATUS(st) != 0;
+        fputs(out[at], stdout);
+        close(fd[at][0]);
+    }
+    return failed ? 1 : 0;
+}
