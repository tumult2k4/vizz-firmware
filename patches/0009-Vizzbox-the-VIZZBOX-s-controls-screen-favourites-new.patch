+/* PLAY and stop; SEQ MIDI OUT OFF; the GROOVEBOX */
+static void case_transport(void)
+{
+    uint32_t i, n103 = 0, fa = 0, first104 = 0, any = 0;
+    snprintf(tag, sizeof tag, "transport");
+    boot();
+    knobs(0, 0, 0x1234u, 70, 40, 1);
+    press(1u << B_PLAY);
+    run_s(10.0);
+    for (i = 0; i < nev && !first104; i++) {
+        if (ev[i].st == 0xFAu)
+            fa = i + 1u;
+        if (fa && (ev[i].st & 0xF0u) == 0xB0u && ev[i].d1 == 103u)
+            n103++;
+        if (ev[i].st == 0xBFu && ev[i].d1 == 104u)
+            first104 = i + 1u;
+    }
+    ok(fa && n103 == 6u && first104 > fa, "PLAY: Start, %u CC 103, then the six (at %u, Start at %u)", n103, first104,
+       fa);
+    for (i = first104 - 1u; i < first104 + 5u && i < nev; i++)
+        ok(ev[i].st == 0xBFu && ev[i].d1 == 104u + (i - first104 + 1u), "PLAY: the six in order");
+    nev = 0;
+    press(1u << B_PLAY);
+    run_s(0.5);
+    for (i = 0, any = 0; i < nev; i++)
+        any |= ev[i].st == 0xBFu && ev[i].d1 == 104u && ev[i].d2 == 0u;
+    ok(any, "stop: no CC 104 0");
+    CPU2_BYTE |= 8u;                                /* SEQ MIDI OUT OFF (ui.c SEQOUT_OFF): nothing of it */
+    nev = 0;
+    press(1u << B_PLAY);
+    run_s(20.0);
+    for (i = 0, any = 0; i < nev; i++)
+        any |= ev[i].st == 0xBFu && ev[i].d1 >= 104u && ev[i].d1 <= 109u;
+    ok(!any, "SEQ MIDI OUT OFF: CC 104 .. 109 sent");
+    press(1u << B_PLAY);
+    CPU2_BYTE &= ~8u;
+    run_s(0.5);
+    web_buttons(1u << B_HOME);                      /* the GROOVEBOX: its own music, none of it */
+    run_s(0.06);
+    web_buttons(1u << B_HOME | 1u << B_PLAY);
+    run_s(0.06);
+    web_buttons(0);
+    run_s(0.5);
+    ok(!vb_mode, "HOME + PLAY: still the VIZZBOX");
+    nev = 0;
+    press(1u << B_PLAY);
+    run_s(20.0);
+    press(1u << B_PLAY);
+    for (i = 0, any = 0; i < nev; i++)
+        any |= ev[i].st == 0xBFu && ev[i].d1 >= 104u && ev[i].d1 <= 109u;
+    ok(!any, "the GROOVEBOX playing: CC 104 .. 109 sent");
+    ok(!vb.own, "the GROOVEBOX: the producer still holds the tracks");
+}
