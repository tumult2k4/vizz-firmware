+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox) tests/producer_test.c: the producer (BRIEF-VIZZBOX.md 9), on the browser emulator's device built natively
+ * (web/emu/felucca_web.c with VIZZBOX=1: the firmware's sources, the main loop every ms, the audio ISR every I2S half),
+ * what it sends over USB MIDI read back as the unit sends it. Each case on a device of its own (fork), four at a time.
+ *   - every subgenre a whole song in every LENGTH: it ends by itself (SHORT 2:20 .. 3:45, NORMAL 4:30 .. 6:15; ENDLESS
+ *     runs on), its sections in a form's order and lengths (INTRO first, OUTRO last, a DROP after its BUILD, bars a
+ *     multiple of 4, CC 106 counting), its tempo in the subgenre's range, its notes in the key, each role in its
+ *     register, no voice stolen; each DROP: CC 104 4 before the kick on its one, the BUILD before it a roll or a riser;
+ *     CC 104 .. 109 on channel 16 only, all six at each bar's first step before its notes, CC 105 at most once a 1/16
+ *   - determinism: a song twice, and with the main loop in another phase (another render chunk): the same MIDI bytes and
+ *     the same audio; another seed: another song
+ *   - PLAY: Start, Vizz' six CC 103, then the six; stop: CC 104 0; SEQ MIDI OUT OFF: none of it; the GROOVEBOX: none
+ *   - the knobs while playing: ENERGY and GENRE from the next section on; DROP NOW, BREAK NOW, HOLD
+ *   - the user's MUTE and SOLO: they silence, CC 103 says them, and only them (never the arrangement's pauses)
+ *   - ENDLESS for 60 minutes: related subgenres come, 8 BPM at most each time, the plan does not grow, no voice stolen
+ *   - favourites: stored, the unit off and on again (its flash kept), loaded, played: the same song, bit for bit
+ *   - VIZZBOX <-> GROOVEBOX, playing too: the song goes on; stopped in the GROOVEBOX, its music comes back
+ *   producer_test [CASE]      (no CASE: all; prints "producer: all passed" or the failures) */
+#define VIZZBOX 1
+#include "../web/emu/felucca_web.c"
+#include <math.h>
+#include <stdarg.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static int fails;
+static uint32_t nchecks;
+static char tag[96];
+static void ok(int c, const char *fmt, ...)
+{
+    va_list a;
+    nchecks++;
+    if (c)
+        return;
+    fails++;
+    printf("FAIL %s: ", tag);
+    va_start(a, fmt);
+    vprintf(fmt, a);
+    va_end(a);
+    printf("\n");
+}
+
+/* ---------------------------------------------------------------- the device and what it sends */
+typedef struct { uint64_t t; uint8_t st, d1, d2; } ev_t;    /* t: the frame (sample) it went out by */
+static ev_t *ev;
+static uint32_t nev, cap;
+static uint64_t frames;
+static uint32_t ahash = 2166136261u, mhash = 2166136261u;
+static uint32_t chunk = 128;
+static void drain(void)
+{
+    while (mo_r != mo_w) {
+        uint32_t pkt = midi_out_q[mo_r % MQ], st = (pkt >> 8) & 0xFFu;
+        mo_r++;
+        if (nev == cap) {
+            cap = cap ? 2u * cap : 65536u;
+            ev = realloc(ev, cap * sizeof *ev);
+        }
+        ev[nev].t = frames;
+        ev[nev].st = (uint8_t)st;
+        ev[nev].d1 = (uint8_t)((pkt >> 16) & 0x7Fu);
+        ev[nev].d2 = (uint8_t)((pkt >> 24) & 0x7Fu);
+        if (st != 0xF8u) {                          /* (the clock aside) */
+            mhash = (mhash ^ st) * 16777619u;
+            mhash = (mhash ^ ev[nev].d1) * 16777619u;
+            mhash = (mhash ^ ev[nev].d2) * 16777619u;
+        }
+        nev++;
+    }
+}
+static void run_frames(uint64_t n)
+{
+    while (n) {
+        uint32_t m = n < chunk ? (uint32_t)n : chunk, k;
+        web_render(m);
+        for (k = 0; k < m; k++) {
+            int32_t s = (int32_t)lrintf(out_l[k] * 32767.0f) * 3 + (int32_t)lrintf(out_r[k] * 32767.0f);
+            ahash = (ahash ^ (uint32_t)s) * 16777619u;
+        }
+        frames += m;
+        drain();
+        n -= m;
+    }
+}
+static void run_s(double s) { run_frames((uint64_t)(s * FS)); }
+static void boot(void)
+{
+    web_nor_erase();
+    web_boot();
+    usb.config = 1;
+    web_master(1023);
+    run_s(0.6);
+    nev = 0;
+    frames = 0;
+    ahash = mhash = 2166136261u;
+}
+static void knobs(uint32_t g, uint32_t s, uint32_t seed, uint32_t e, uint32_t v, uint32_t len)
+{
+    vb.k.genre = (uint8_t)g;
+    vb.k.sub = (uint8_t)s;
+    vb.k.seed = (uint16_t)seed;
+    vb.k.energy = (uint8_t)e;
+    vb.k.var = (uint8_t)v;
+    vb.k.len = (uint8_t)len;
+    vb.k.bpm = 0;
+}
+static void press(uint32_t labels)
+{
+    web_buttons(labels);
+    run_s(0.04);
+    web_buttons(0);
+    run_s(0.02);
+}
+static void play_to_end(double max_s)              /* PLAY, until it stops by itself or max_s */
+{
+    double t = 0;
+    press(1u << B_PLAY);
+    while (song.playing && t < max_s) {
+        run_s(0.5);
+        t += 0.5;
+    }
+}
