+/* the user's MUTE and SOLO; CC 103 says them and only them */
+static void case_mute(void)
+{
+    uint32_t i, t2_on = 0, cc103_wrong = 0, cc103_t2 = 0, k, solo_ok = 1;
+    snprintf(tag, sizeof tag, "mute");
+    boot();
+    knobs(0, 0, 0x7777u, 70, 40, 1);
+    press(1u << B_PLAY);
+    run_s(40.0);                                    /* (the INTRO: the arrangement pauses tracks) */
+    for (i = 0; i < nev; i++)
+        cc103_wrong += (ev[i].st & 0xF0u) == 0xB0u && ev[i].d1 == 103u && ev[i].d2 != 0u;
+    ok(!cc103_wrong, "CC 103 127 for an arrangement's pause (%u)", cc103_wrong);
+    for (k = 0; k < 27u && !(key_black(k) && key_place(k) == 1u); k++)
+        ;
+    web_keys(1u << k);                              /* T2's black key tapped: its MUTE */
+    run_s(0.08);
+    web_keys(0);
+    run_s(0.1);
+    ok(trk[1].p[P_MUTE] == 1, "a tap: T2 not muted");
+    nev = 0;
+    run_s(20.0);
+    for (i = 0; i < nev; i++) {
+        t2_on += ev[i].st == 0x91u && ev[i].d2;
+        cc103_t2 += ev[i].st == 0xB1u && ev[i].d1 == 103u && ev[i].d2 == 127u;
+    }
+    ok(!t2_on, "T2 muted: %u notes", t2_on);
+    ok(cc103_t2 > 0u, "T2 muted: no CC 103 127");
+    web_buttons(1u << B_GLO);                       /* GLO + T3's black key held: T3 alone */
+    run_s(0.05);
+    for (k = 0; k < 27u && !(key_black(k) && key_place(k) == 2u); k++)
+        ;
+    web_keys(1u << k);
+    nev = 0;
+    run_s(4.0);
+    for (i = 0; i < nev; i++)
+        solo_ok &= !((ev[i].st & 0xF0u) == 0x90u && ev[i].d2 && (ev[i].st & 15u) != 2u && (ev[i].st & 15u) < 6u);
+    ok(solo_ok && perf_solo == 4u, "GLO + T3's key: not T3 alone");
+    web_keys(0);
+    web_buttons(0);
+    run_s(0.1);
+    ok(!perf_solo, "SOLO stayed");
+}
