+/* ENDLESS for 60 minutes */
+static void case_endless(void)
+{
+    uint32_t b, changes = 0, maxplan = 0, last_ri, jump_ok = 1, t, bpm = 0;
+    snprintf(tag, sizeof tag, "ENDLESS 60 min");
+    boot();
+    knobs(5, 0, 0xC0DEu, 70, 50, 2);
+    press(1u << B_PLAY);
+    last_ri = vb.ri;
+    bpm = vb.bpm;
+    for (t = 0; t < 3600u; t++) {
+        run_s(1.0);
+        if (vb.nplan > maxplan)
+            maxplan = vb.nplan;
+        if (vb.ri != last_ri && vb.sbar == 0u) {
+            changes++;
+            jump_ok &= vb.bpm + 8u >= bpm && vb.bpm <= bpm + 8u;
+            last_ri = vb.ri;
+            bpm = vb.bpm;
+        }
+        if (!vb.xfer)
+            bpm = vb.bpm;
+        if (!song.playing)
+            break;
+    }
+    ok(song.playing, "ENDLESS stopped after %u s", t);
+    ok(changes >= 5u, "%u subgenre changes in 60 minutes", changes);
+    ok(jump_ok, "a change glided more than 8 BPM");
+    ok(maxplan <= VB_PLAN, "the plan grew to %u", maxplan);
+    ok(voice_kills == 0, "%u voices stolen", voice_kills);
+    read_bars();
+    {
+        uint32_t i, drops = 0, kicks = 0;
+        for (b = 1; b < nbars; b++) {
+            ok(bars[b].cc[0] != 6u, "an OUTRO in ENDLESS");
+            if (bars[b].cc[0] == 4u && !bars[b].cc[2]) {   /* every DROP's one, after a new style too: the kick */
+                uint32_t k = 0;
+                drops++;
+                for (i = bars[b].i; i < nev && ev[i].t <= ev[bars[b].i].t + 128u; i++)
+                    k |= ev[i].st == 0x90u && ev[i].d1 == 36u && ev[i].d2;
+                kicks += k;
+                if (!k)
+                    ok(0, "the DROP at bar %u (genre %u, subgenre %u): no kick on its one", b, bars[b].cc[4],
+                       bars[b].cc[5]);
+            }
+        }
+        ok(drops > 10u, "%u DROPs in 60 minutes", drops);
+    }
+    press(1u << B_PLAY);
+}
