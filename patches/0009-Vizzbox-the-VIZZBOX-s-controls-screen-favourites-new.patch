+    play_to_end(300.0);
+    run_s(2.0);
+    direct = mhash;
+    if (pipe(p))
+        return;
+    if (!fork()) {                                  /* off and on: a new device on the flash kept */
+        uint32_t r;
+        memcpy(nor, nor_kept, sizeof nor);
+        web_boot();
+        usb.config = 1;
+        web_master(1023);
+        run_s(0.6);
+        knobs(0, 0, 0x1111u, 90, 90, 1);           /* (other knobs) */
+        web_buttons(1u << B_GLO);
+        run_s(0.1);
+        web_keys(1u << k);
+        run_s(0.08);
+        web_keys(0);
+        web_buttons(0);
+        run_s(0.3);
+        nev = 0;
+        frames = 0;
+        mhash = 2166136261u;
+        play_to_end(300.0);
+        run_s(2.0);
+        r = mhash;
+        if (write(p[1], &r, sizeof r) != (ssize_t)sizeof r)
+            _exit(1);
+        _exit(0);
+    }
+    a = 0;
+    wait(NULL);
+    if (read(p[0], &a, sizeof a) != (ssize_t)sizeof a)
+        ok(0, "no answer");
+    ok(a == direct, "loaded after off and on: MIDI %08x, played directly %08x", a, direct);
+}
+
+/* VIZZBOX <-> GROOVEBOX, playing too */
+static void case_modes(void)
+{
+    uint32_t i, notes = 0;
+    int16_t lvl;
+    snprintf(tag, sizeof tag, "modes");
+    boot();
+    lvl = trk[0].p[P_LEVEL];
+    knobs(4, 0, 0x2222u, 70, 40, 1);
+    press(1u << B_PLAY);
+    run_s(10.0);
+    web_buttons(1u << B_HOME);
+    run_s(0.06);
+    web_buttons(1u << B_HOME | 1u << B_PLAY);
+    run_s(0.06);
+    web_buttons(0);
+    nev = 0;
+    run_s(10.0);
+    ok(!vb_mode && song.playing && vb.own, "into the GROOVEBOX playing: the song stopped");
+    for (i = 0; i < nev; i++)
+        notes += (ev[i].st & 0xF0u) == 0x90u && ev[i].d2;
+    ok(notes > 20u, "into the GROOVEBOX playing: %u notes in 10 s", notes);
+    web_buttons(1u << B_HOME);                      /* SHIFT + PLAY: back */
+    run_s(0.06);
+    web_buttons(1u << B_HOME | 1u << B_PLAY);
+    run_s(0.06);
+    web_buttons(0);
+    run_s(1.0);
+    ok(vb_mode && song.playing, "back in the VIZZBOX: stopped or not there");
+    press(1u << B_PLAY);
+    run_s(0.5);
+    web_buttons(1u << B_HOME);
+    run_s(0.06);
+    web_buttons(1u << B_HOME | 1u << B_PLAY);
+    run_s(0.06);
+    web_buttons(0);
+    run_s(0.5);
+    ok(!vb_mode && !vb.own && trk[0].p[P_LEVEL] == lvl, "stopped into the GROOVEBOX: its music not back");
+    ok(voice_kills == 0, "%u voices stolen", voice_kills);
+}
+
+/* ---------------------------------------------------------------- the cases, four at a time */
+typedef struct { const char *name; uint32_t a, b; } case_t;
+static void one(const case_t *c)
+{
+    if (!strcmp(c->name, "song"))
+        case_song(c->a, c->b);
+    else if (!strcmp(c->name, "determinism"))
+        case_determinism();
+    else if (!strcmp(c->name, "transport"))
+        case_transport();
+    else if (!strcmp(c->name, "live"))
+        case_live();
+    else if (!strcmp(c->name, "mute"))
+        case_mute();
+    else if (!strcmp(c->name, "endless"))
+        case_endless();
+    else if (!strcmp(c->name, "favourites"))
+        case_favourites();
+    else
+        case_modes();
+}
+int main(int argc, char **argv)
+{
+    static case_t cs[200];
+    uint32_t n = 0, i, ri, len, running = 0, failed = 0;
+    const char *only = argc > 1 ? argv[1] : NULL;
+    cs[n++] = (case_t){"endless", 0, 0};
+    for (ri = 0; ri < 36u; ri++)
+        for (len = 0; len < 3u; len++)
+            cs[n++] = (case_t){"song", ri, len};
+    cs[n++] = (case_t){"determinism", 0, 0};
+    cs[n++] = (case_t){"transport", 0, 0};
+    cs[n++] = (case_t){"live", 0, 0};
+    cs[n++] = (case_t){"mute", 0, 0};
+    cs[n++] = (case_t){"favourites", 0, 0};
+    cs[n++] = (case_t){"modes", 0, 0};
+    fflush(stdout);
+    for (i = 0; i < n; i++) {
+        int st;
+        if (only && strcmp(only, cs[i].name))
+            continue;
+        if (running == 4u) {
+            wait(&st);
+            failed += !WIFEXITED(st) || WEXITSTATUS(st) != 0;
+            running--;
+        }
+        if (!fork()) {
+            one(&cs[i]);
+            printf("producer: %-40s %u checks, %d failed\n", tag, nchecks, fails);
+            fflush(stdout);
+            _exit(fails ? 1 : 0);
+        }
+        running++;
+    }
+    while (running) {
+        int st;
+        wait(&st);
+        failed += !WIFEXITED(st) || WEXITSTATUS(st) != 0;
+        running--;
+    }
+    if (failed)
+        printf("producer: %u cases FAILED\n", failed);
+    else
+        printf("producer: all passed\n");
+    return failed ? 1 : 0;
+}
