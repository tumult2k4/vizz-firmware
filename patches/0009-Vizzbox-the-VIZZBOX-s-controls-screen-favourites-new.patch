+/* the knobs while playing; DROP NOW, BREAK NOW, HOLD */
+static uint32_t sec_at(uint32_t b) { return b < nbars ? bars[b].cc[0] : 0u; }
+typedef struct { uint32_t turn, n, at; uint8_t cc[160][6]; } en_t;
+static void en_run(void *a)                         /* 60 s, ENERGY turned up at 20 s (or not): the bars' six */
+{
+    en_t *d = a;
+    uint32_t b;
+    boot();
+    knobs(1, 1, 0x4242u, 60, 30, 1);
+    press(1u << B_PLAY);
+    run_s(20.0);
+    read_bars();
+    d->at = nbars;                                  /* (the bars before the turn) */
+    if (d->turn)
+        web_enc(EN_K3, 40);
+    run_s(40.0);
+    read_bars();
+    for (b = 0; b < nbars && b < 160u; b++)
+        memcpy(d->cc[b], bars[b].cc, 6);
+    d->n = b;
+}
+static void case_live(void)
+{
+    static en_t ref, turned;
+    uint32_t b, start, from = 0, same = 1, differs = 0;
+    snprintf(tag, sizeof tag, "live");
+    ref.turn = 0;
+    turned.turn = 1;
+    ok(!spawn(en_run, &ref, sizeof ref) && !spawn(en_run, &turned, sizeof turned), "no answer");
+    for (b = 0; b < ref.n && b < turned.n; b++) {   /* ENERGY: from the next section on (turned at 20 s) */
+        if (!from && b > turned.at && ref.cc[b][2] == 0u)
+            from = b;
+        if (!from)
+            same &= !memcmp(ref.cc[b], turned.cc[b], 6);
+        else
+            differs |= ref.cc[b][1] != turned.cc[b][1];
+    }
+    ok(from && same, "ENERGY came in before the next section (bar %u)", from);
+    ok(differs, "ENERGY never came in");
+    boot();
+    knobs(1, 1, 0x4242u, 60, 30, 1);
+    press(1u << B_PLAY);
+    run_s(30.0);
+    read_bars();
+    press(1u << B_FX);                              /* DROP NOW: a BUILD, then the DROP */
+    start = nbars;
+    run_s(40.0);
+    read_bars();
+    for (b = start; b < nbars && sec_at(b) != 3u; b++)
+        ;
+    ok(b < nbars && b <= start + 2u, "DROP NOW: no BUILD next");
+    for (; b < nbars && sec_at(b) == 3u; b++)
+        ;
+    ok(b < nbars && sec_at(b) == 4u, "DROP NOW: no DROP after the BUILD");
+    press(1u << B_ARP);                             /* BREAK NOW: a BREAK next */
+    start = nbars;
+    run_s(12.0);
+    read_bars();
+    for (b = start; b < nbars && sec_at(b) != 5u; b++)
+        ;
+    ok(b < nbars && b <= start + 2u, "BREAK NOW: no BREAK next");
+    press(1u << B_SEQ);                             /* HOLD: the section again */
+    run_s(60.0);
+    read_bars();
+    for (b = nbars - 1u; b > 0u && sec_at(b - 1u) == sec_at(nbars - 1u); b--)
+        ;
+    ok(nbars - b > 16u, "HOLD: the section changed (%u bars of it)", nbars - b);
+    press(1u << B_SEQ);
+    web_enc(EN_K1, 2);                              /* GENRE: a new style, a section later */
+    start = nbars;
+    run_s(1.0);
+    read_bars();
+    for (b = start; b < nbars; b++)
+        ok(bars[b].cc[4] == 1u, "GENRE came in before the next section");
+    run_s(120.0);
+    read_bars();
+    ok(bars[nbars - 1u].cc[4] == 3u, "GENRE never came in (%u)", bars[nbars - 1u].cc[4]);
+    ok(voice_kills == 0, "%u voices stolen", voice_kills);
+}
