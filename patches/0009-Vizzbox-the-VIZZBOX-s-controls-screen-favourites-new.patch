+/* ---------------------------------------------------------------- what a song sent */
+/* the bars as the six CCs began them: their event index, section, energy, bar, length, genre, subgenre */
+typedef struct { uint32_t i; uint8_t cc[6]; } bar_t;
+static bar_t *bars;
+static uint32_t nbars;
+static void read_bars(void)
+{
+    uint32_t i, j;
+    free(bars);
+    bars = calloc(nev / 6u + 2u, sizeof *bars);
+    nbars = 0;
+    for (i = 0; i + 5u < nev; i++) {
+        if (ev[i].st != 0xBFu || ev[i].d1 != 104u)
+            continue;
+        for (j = 0; j < 6u && ev[i + j].st == 0xBFu && ev[i + j].d1 == 104u + j; j++)
+            ;
+        if (j < 6u || !ev[i].d2)
+            continue;
+        bars[nbars].i = i;
+        for (j = 0; j < 6u; j++)
+            bars[nbars].cc[j] = ev[i + j].d2;
+        nbars++;
+        i += 5u;
+    }
+}
+static int key_has(uint32_t note)                   /* note in the song's key (vb.root, vb.scale) */
+{
+    return (int)((SCALE_MASK[vb.scale % 16u] >> ((note + 12u - vb.root % 12u) % 12u)) & 1u);
+}
+
+/* every subgenre in every length: the song as a whole */
+static void case_song(uint32_t ri, uint32_t len)
+{
+    uint32_t g, s, i, j, b, kicks = 0, drops = 0, in_key = 0, notes = 0, tempo_ok = 1, cc105 = 0;
+    const vb_sub_t *u = &VB_SUB[ri];
+    double secs;
+    int slice;
+    for (g = 0; g < 9u && ri >= vb_sub0(g + 1u); g++)
+        ;
+    s = ri - vb_sub0(g);
+    snprintf(tag, sizeof tag, "%s / %s %s", VB_GNAME[g], VB_SNAME[ri], len == 0 ? "SHORT" : len == 1 ? "NORMAL" : "ENDLESS");
+    boot();
+    knobs(g, s, 0x5EEDu + ri * 7u, 70, 40, len);
+    press(1u << B_PLAY);
+    for (secs = 0; song.playing && secs < (len == 2 ? 200.0 : 420.0); secs += 0.5) {   /* (ENDLESS: before a related
+                                                     * subgenre comes, case_endless) */
+        run_s(0.5);
+        if (song.g[G_BPM] < u->bpm0 || song.g[G_BPM] > u->bpm1)
+            tempo_ok = 0;
+    }
+    if (len == 2) {
+        ok(song.playing, "ENDLESS stopped after %.0f s", secs);
+        press(1u << B_PLAY);
+    } else {
+        ok(!song.playing, "never ended");
+        ok(secs >= (len ? 270.0 : 140.0) && secs <= (len ? 375.0 : 225.0), "length %.0f s", secs);
+    }
+    run_s(1.0);
+    ok(tempo_ok, "tempo outside %u .. %u", u->bpm0, u->bpm1);
+    ok(voice_kills == 0, "%u voices stolen", voice_kills);
+    read_bars();
+    ok(nbars > 16u, "%u bars announced", nbars);
+    ok(bars[0].cc[0] == 1u && bars[0].cc[2] == 0u, "starts with section %u bar %u", bars[0].cc[0], bars[0].cc[2]);
+    if (len != 2)
+        ok(bars[nbars - 1u].cc[0] == 6u, "ends in section %u", bars[nbars - 1u].cc[0]);
+    for (b = 0; b < nbars; b++) {
+        const uint8_t *c = bars[b].cc;
+        ok(c[0] >= 1u && c[0] <= 6u && c[4] == g && c[5] == s && c[3] % 4u == 0u && c[2] < c[3],
+           "bar %u: CC 104..109 %u %u %u %u %u %u", b, c[0], c[1], c[2], c[3], c[4], c[5]);
+        if (b && c[2])
+            ok(c[2] == bars[b - 1u].cc[2] + 1u && c[0] == bars[b - 1u].cc[0], "bar %u: CC 106 %u after %u", b, c[2],
+               bars[b - 1u].cc[2]);
+        if (c[0] == 4u && !c[2]) {                  /* a DROP's one: the kick after CC 104 4, the BUILD before it */
+            uint32_t k = 0, before = b ? bars[b - 1u].cc[0] : 0u;
+            drops++;
+            for (i = bars[b].i; i < nev && ev[i].t <= ev[bars[b].i].t + 128u; i++)
+                k |= ev[i].st == 0x90u && ev[i].d1 == 36u && ev[i].d2;
+            kicks += k;
+            if (before == 3u) {                     /* a roll (four snare hits in its last bar) or a riser (T6) */
+                uint32_t sn = 0, rs = 0, st = b ? bars[b - 1u].i : 0u;
+                for (i = st; i < bars[b].i; i++) {
+                    sn += ev[i].st == 0x90u && ev[i].d1 == 38u && ev[i].d2;
+                    rs += ev[i].st == 0x95u && ev[i].d2;
+                }
+                for (j = b; j > 0u && bars[j - 1u].cc[0] == 3u; j--)
+                    ;
+                for (i = bars[j].i; i < bars[b].i; i++)
+                    rs += ev[i].st == 0x95u && ev[i].d2;
+                ok(sn >= 4u || rs > 0u, "the BUILD into DROP %u: no roll, no riser", drops);
+            } else                                  /* (the forms: T's DROP after its BREAK, V's after a GROOVE or
+                                                     * its BREAK) */
+                ok((before == 5u && (u->form == FO_T || u->form == FO_V)) || (before == 2u && u->form == FO_V),
+                   "DROP %u after section %u", drops, before);
+        }
+        if (c[0] == 4u && b && bars[b - 1u].cc[0] != 4u)
+            ok(!c[2], "a DROP starts at bar %u", c[2]);
+    }
+    if (drops)
+        ok(kicks == drops, "%u of %u DROPs with the kick on their one", kicks, drops);
+    slice = VB_SND[vb.snd[R_A] % NELEM(VB_SND)].eng == ENGI_SLICE;
+    for (i = 0; i < nev; i++) {
+        uint32_t st = ev[i].st, ch = (st & 15u) + 1u, n = ev[i].d1;
+        if ((st & 0xF0u) == 0xB0u && ev[i].d1 >= 104u && ev[i].d1 <= 109u)
+            ok(ch == 16u, "CC %u on channel %u", ev[i].d1, ch);
+        if ((st & 0xF0u) == 0xB0u && ev[i].d1 == 105u && i && ev[i - 1u].st == 0xBFu && ev[i - 1u].d1 == 105u &&
+            !(ev[i - 2u].d1 == 104u))
+            cc105 += ev[i].t - ev[i - 1u].t < div_samples(2) / 2u;
+        if ((st & 0xF0u) != 0x90u || !ev[i].d2 || ch < 2u || ch > 5u || (ch == 5u && slice))
+            continue;
+        notes++;
+        in_key += (uint32_t)key_has(n);
+        if (ch == 2u)
+            ok(n <= 52u, "bass note %u above E3", n);
+        else if (ch == 3u)
+            ok(n >= 48u && n <= 76u, "chord note %u outside C3 .. E5", n);
+        else
+            ok(n >= 55u && n <= 88u, "%s note %u outside G3 .. E6", ch == 4u ? "lead" : "arp", n);
+    }
+    ok(notes > 0u && in_key == notes, "%u of %u notes in the key", in_key, notes);
+    ok(cc105 == 0u, "CC 105 twice within a 1/16 %u times", cc105);
+    for (b = 0; b < nbars; b++) {                   /* the six before the bar's first note */
+        uint32_t t0 = (uint32_t)ev[bars[b].i].t;
+        for (i = bars[b].i; i > 0u && ev[i - 1u].t == t0; i--)
+            ok(!((ev[i - 1u].st & 0xF0u) == 0x90u && ev[i - 1u].d2), "bar %u: a note before the six", b);
+    }
+}
