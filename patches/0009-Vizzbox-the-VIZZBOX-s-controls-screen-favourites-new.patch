+/* a run on a device of its own (fork: a device powers on once): fn fills out, it comes back through a pipe */
+static int spawn(void (*fn)(void *), void *out, size_t n)
+{
+    int p[2], st;
+    if (pipe(p))
+        return -1;
+    fflush(stdout);
+    if (!fork()) {
+        fn(out);
+        if (write(p[1], out, n) != (ssize_t)n)
+            _exit(1);
+        _exit(0);
+    }
+    close(p[1]);
+    {
+        size_t got = 0;
+        ssize_t r;
+        while (got < n && (r = read(p[0], (uint8_t *)out + got, n - got)) > 0)
+            got += (size_t)r;
+        close(p[0]);
+        wait(&st);
+        return got == n ? 0 : -1;
+    }
+}
+/* the same song twice; with the main loop in another phase; another seed */
+typedef struct { uint32_t seed, chunk, midi, audio; } det_t;
+static void det_run(void *a)
+{
+    det_t *d = a;
+    chunk = d->chunk;
+    boot();
+    knobs(3, 1, d->seed, 80, 60, 0);
+    play_to_end(400.0);
+    run_s(2.0);
+    d->midi = mhash;
+    d->audio = ahash;
+}
+static void case_determinism(void)
+{
+    det_t r[4] = {{0xBEEFu, 128, 0, 0}, {0xBEEFu, 128, 0, 0}, {0xBEEFu, 44, 0, 0}, {0xBEF0u, 128, 0, 0}};
+    uint32_t i;
+    snprintf(tag, sizeof tag, "determinism");
+    for (i = 0; i < 4u; i++)
+        ok(!spawn(det_run, &r[i], sizeof r[i]), "run %u: no answer", i);
+    ok(r[0].midi == r[1].midi && r[0].audio == r[1].audio, "the same song twice: MIDI %08x / %08x, audio %08x / %08x",
+       r[0].midi, r[1].midi, r[0].audio, r[1].audio);
+    ok(r[0].midi == r[2].midi && r[0].audio == r[2].audio, "another render chunk: MIDI %08x / %08x, audio %08x / %08x",
+       r[0].midi, r[2].midi, r[0].audio, r[2].audio);
+    ok(r[3].midi != r[0].midi && r[3].audio != r[0].audio, "another seed, the same song");
+}
