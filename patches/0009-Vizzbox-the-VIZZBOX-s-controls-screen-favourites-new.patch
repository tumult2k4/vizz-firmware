diff --git a/tests/vizzbox_ui.c b/tests/vizzbox_ui.c
new file mode 100644
index 0000000..bbd7cd4
--- /dev/null
+++ b/tests/vizzbox_ui.c
@@ -0,0 +1,142 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox) the VIZZBOX's screens (BRIEF-VIZZBOX.md 2.3, 9: UI goldens for every new screen): the browser emulator's
+ * device (web/emu/felucca_web.c, VIZZBOX=1) driven through its scenes, each screen's FNV-1a hash printed and, with
+ * OUTDIR, written as OUTDIR/<scene>.ppm (tests/ui_render.py's way: tools/vizzbox_ui.py makes the PNGs).
+ *   cc -O2 -ffp-contract=off -w -Ibuild/gen -Ifirmware/src -o build/host/vizzbox_ui tests/vizzbox_ui.c -lm
+ *   build/host/vizzbox_ui [OUTDIR]          (tests/run_tests.sh: compared with tests/vizzbox_ui_golden.txt) */
+#define VIZZBOX 1
+#include "../web/emu/felucca_web.c"
+#include <sys/wait.h>
+#include <unistd.h>
+
+static const char *outdir;
+static char pal_name[16];
+static void ms(uint32_t n)                          /* the device runs n ms */
+{
+    while (n--)
+        web_render(44);
+}
+static void shot(const char *name)
+{
+    uint32_t h = 2166136261u, i;
+    ui.force = 1;
+    ms(140);                                        /* (a few frames: the screen drawn) */
+    for (i = 0; i < 240u * 240u; i++) {
+        h = (h ^ (web_fb[i] & 0xFFu)) * 16777619u;
+        h = (h ^ (web_fb[i] >> 8)) * 16777619u;
+    }
+    printf("%s_%-22s %08x\n", pal_name, name, h);
+    if (outdir) {
+        char path[512];
+        FILE *f;
+        snprintf(path, sizeof path, "%s/%s_%s.ppm", outdir, pal_name, name);
+        if ((f = fopen(path, "wb")) != NULL) {
+            fprintf(f, "P6\n240 240\n255\n");
+            for (i = 0; i < 240u * 240u; i++) {
+                uint32_t c = (uint32_t)(web_fb[i] >> 8 | (web_fb[i] & 0xFFu) << 8);   /* (high byte first) */
+                fputc((int)((c >> 11) * 255u / 31u), f);
+                fputc((int)(((c >> 5) & 63u) * 255u / 63u), f);
+                fputc((int)((c & 31u) * 255u / 31u), f);
+            }
+            fclose(f);
+        }
+    }
+}
+static void press(uint32_t labels, uint32_t hold_ms)
+{
+    web_buttons(labels);
+    ms(hold_ms);
+    web_buttons(0);
+    ms(60);
+}
+static uint32_t key_of(int black, uint32_t place)   /* the key (0 F3 .. 26 G5) that is the place-th of its colour */
+{
+    uint32_t k;
+    for (k = 0; k < 27u; k++)
+        if (key_black(k) == black && key_place(k) == place)
+            return k;
+    return 0;
+}
+
+static void scenes(uint32_t pal)
+{
+    web_nor_erase();
+    web_boot();
+    web_master(1023);
+    ms(1200);                                       /* (the splash) */
+    settings.palette = (uint8_t)pal;                /* (MENU > THEME's palette) */
+    theme_apply();
+    str_cpy(pal_name, UI_PALETTES[pal % NPALETTES].name, sizeof pal_name);
+    shot("vb_ready");                               /* a new unit: the VIZZBOX, the knobs' song */
+    web_enc(EN_K1, 1);
+    ms(30);
+    shot("vb_knob_genre");                          /* GENRE turned: big */
+    web_enc(EN_K2, 2);
+    ms(30);
+    web_enc(EN_K3, 10);
+    ms(1400);
+    shot("vb_techno_ready");                        /* the knob's value gone: TECHNO / DUB TECHNO's song */
+    web_enc(EN_ALGO, 1);
+    ms(30);
+    shot("vb_knob_length");
+    web_enc(EN_ALGO, -1);
+    ms(1400);
+    press(1u << B_PLAY, 40);
+    ms(30000);
+    shot("vb_playing");                             /* 30 s in: its section, the bar, the tracks playing */
+    web_keys(1u << key_of(1, 1));                   /* the second black key: T2 */
+    ms(80);
+    web_keys(0);
+    ms(100);
+    shot("vb_muted_t2");                            /* T2 muted (a tap) */
+    web_keys(1u << key_of(1, 1));
+    ms(80);
+    web_keys(0);
+    ms(100);
+    web_buttons(1u << B_SAVE);
+    ms(100);
+    web_keys(1u << key_of(0, 2));                   /* SAVE + the third white key: favourite 3 */
+    ms(80);
+    web_keys(0);
+    ms(100);
+    shot("vb_favourites_save");
+    web_buttons(0);
+    ms(200);
+    shot("vb_saved_message");
+    web_enc(EN_K1, 3);
+    ms(30);
+    shot("vb_knob_live");                           /* playing: FROM THE NEXT SECTION */
+    press(1u << B_PLAY, 40);
+    ms(3000);
+    shot("vb_stopped");                             /* stopped: the knobs' song (the favourite written now) */
+    web_buttons(1u << B_GLO);
+    ms(100);
+    shot("vb_favourites_load");
+    web_buttons(0);
+    ms(100);
+    web_buttons(1u << B_HOME);
+    ms(60);
+    web_buttons(1u << B_HOME | 1u << B_PLAY);
+    ms(60);
+    web_buttons(0);
+    ms(600);
+    shot("vb_groovebox");                           /* HOME + PLAY: the GROOVEBOX */
+    if (nor[0x95000] != 0x56 && nor[0x96000] != 0x56)
+        printf("%s: the favourite not in the flash\n", pal_name);
+}
+/* every palette on a device of its own (fork), in order */
+int main(int argc, char **argv)
+{
+    uint32_t p;
+    outdir = argc > 1 ? argv[1] : NULL;
+    for (p = 0; p < NPALETTES; p++) {
+        fflush(stdout);
+        if (!fork()) {
+            scenes(p);
+            fflush(stdout);
+            _exit(0);
+        }
+        wait(NULL);
+    }
+    return 0;
+}
