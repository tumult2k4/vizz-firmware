+        seq_midi_mute(ti, 0);                       /* (sounding again within this block, a launch's MUTE: CC 0 first) */
         midi_out_event(0x09u | (0x90u | mc) << 8 | (note & 0x7Fu) << 16 | (vel & 0x7Fu) << 24);
-    else
+    } else
         midi_out_event(0x08u | (0x80u | mc) << 8 | (note & 0x7Fu) << 16);
 }
