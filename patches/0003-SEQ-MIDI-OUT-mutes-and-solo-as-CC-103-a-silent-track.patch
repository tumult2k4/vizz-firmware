 #define SKIFF_SEQ_MIDI 1
 #endif
 #define SEQ_STEP_CC 102u                            /* an undefined controller: harmless to a synth that hears it */
+/* (Vizz, SEQ MIDI OUT) a track's mute as CC SEQ_MUTE_CC on its channel: 127 silent, 0 sounding. Silent is what silences
+ * its sound: its MUTE (P_MUTE: trk_note_on plays nothing), or GLO's SOLO held on another track (perf_solo: perform.c
+ * perf_begin mutes the others' output; not while perf_kill turns the layer's effects off), as ui_layer.c glo_sounding.
+ * A silent track sends no note-on (its note-offs and its step CC go on); turning silent with notes held, CC 123 first.
+ * Sent when it changes (seq_mute_block compares every block: any source, the keys, a solo, a launch, a load), for all
+ * six at PLAY (after Start), on every bar while playing, when SEQ MIDI OUT turns ON and when USB comes up */
+#define SEQ_MUTE_CC 103u                            /* undefined too (102..119) */
 static volatile uint8_t seq_midi_on = 1;
 #if SKIFF_SEQ_MIDI
+static uint8_t seq_mute_sent[NTRK];                 /* what was sent last: bit 0 silent, bits 1..4 the channel; 0xFF not
+                                                     * yet: send it */
+static int trk_silent(uint32_t ti)
+{
+    return trk[ti].p[P_MUTE] != 0 || (perf_solo && !perf_kill && !((perf_solo >> ti) & 1u));
+}
+static void seq_midi_alloff(uint32_t ti)            /* CC 123 All Notes Off: a panic dropped notes without their offs */
+{
+    if (seq_midi_on)
+        midi_out_event(0x0Bu | (0xB0u | trk_midi_ch(ti)) << 8 | 123u << 16);
+}
+static void seq_midi_mute(uint32_t ti, int force)  /* CC SEQ_MUTE_CC when it changed (or its channel), or force */
+{
+    uint32_t mc = trk_midi_ch(ti), m = trk_silent(ti) ? 1u : 0u, s = m | mc << 1, was = seq_mute_sent[ti];
+    if (!seq_midi_on) {
+        seq_mute_sent[ti] = 0xFFu;                  /* (OFF: all six again when it turns ON) */
+        return;
+    }
+    if (!force && was == s)
+        return;
+    if (m && was == (s & ~1u) && trk[ti].seq_n)
+        seq_midi_alloff(ti);                        /* sounding until now, notes held: they end first */
+    midi_out_event(0x0Bu | (0xB0u | mc) << 8 | SEQ_MUTE_CC << 16 | (m ? 127u : 0u) << 24);
+    seq_mute_sent[ti] = (uint8_t)s;
+}
+static void seq_midi_mutes(void)                    /* all six, as they are now */
+{
+    uint32_t i;
+    for (i = 0; i < NTRK; i++)
+        seq_midi_mute(i, 1);
+}
