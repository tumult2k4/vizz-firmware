+        menu_put(MI_SEQOUT, 1);                      /* OFF */
+        trk[0].step[0] = (step_t){{60}, 1, ST_NOTE, 0, 100};
+        settle();
+        glo_mute(1);                                 /* T2 muted */
+        transport_req = 1;
+        blocks(step_blocks(20));
+        lay_combo(B_GLO, white(0));                  /* SOLO T1 held */
+        blocks(8);
