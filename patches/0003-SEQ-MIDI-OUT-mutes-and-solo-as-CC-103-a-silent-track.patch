 {
@@ -125,6 +159,7 @@ static void seq_midi_rt(uint32_t st)                /* a realtime byte: Clock F8
 #define seq_midi_step(ti, idx) ((void)0)
 #define seq_midi_rt(st) ((void)0)
 #define seq_midi_alloff(ti) ((void)0)
+#define seq_midi_mutes() ((void)0)
 #endif
 
 static int drum_track(const track_t *t) { return drum_engine(eng_idx(t->eng_req)); }   /* ((Skiff) DRUM or DRUM-X) */
@@ -959,6 +994,30 @@ static void seq_clk_block(uint32_t n)
 }
 #endif
 
+/* (Vizz, SEQ MIDI OUT) each block, before the tracks tick: CC SEQ_MUTE_CC for a track whose mute changed since what was
+ * sent (whatever changed it), all six on each bar while playing (launch_steps: 16 of a 1/16 track's steps, either clock)
+ * and when USB comes up (a host connected after PLAY knows within a bar) */
+static uint32_t seq_mute_bar;                       /* the bar the last ones were sent in (launch_steps / 16) */
+#if SKIFF_SEQ_MIDI
+static uint8_t seq_mute_usb;                        /* usb.config as last seen */
+static void seq_mute_block(void)
+{
+    uint32_t i, force = 0;
+    if (seq_mute_usb != usb.config) {
+        seq_mute_usb = usb.config;
+        memset(seq_mute_sent, 0xFF, sizeof seq_mute_sent);
+    }
+    if (song.playing && launch_steps / 16u != seq_mute_bar) {
+        seq_mute_bar = launch_steps / 16u;
+        force = 1;
+    }
+    for (i = 0; i < NTRK; i++)
+        seq_midi_mute(i, (int)force);
+}
+#else
+#define seq_mute_block() ((void)0)
+#endif
+
 static void seq_start(void)
 {
     uint32_t i;
@@ -972,6 +1031,8 @@ static void seq_start(void)
         seq_midi_rt(0xFAu);
         seq_clk_acc = beat_samples();
     }
+    seq_midi_mutes();                              /* (Vizz) every track's mute after Start (CC SEQ_MUTE_CC) */
+    seq_mute_bar = 0;
     motion_begin();
     take_clear();                                  /* (Skiff) TAKES: a new log from PLAY */
     for (i = 0; i < NTRK; i++) {                   /* every track from its step 0, together */
@@ -1547,6 +1608,7 @@ static void events_block(uint32_t n)
     }
     if (song.playing)
         launch_clock(seq_n);                          /* (Skiff) the steps a BAR / BEAT launch waits for */
+    seq_mute_block();                                 /* (Vizz, SEQ MIDI OUT) the mutes as they changed, each bar */
     if (aud_req)
         seq_audition();                               /* ((1.3) STEP PREVIEW: a step sounds, stopped) */
     for (i = 0; i < NTRK; i++)
