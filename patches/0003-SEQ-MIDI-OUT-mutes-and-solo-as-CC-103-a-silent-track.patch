 static uint32_t beat_blocks(void) { return beat_samples() / CTL; }
 
+/* (Vizz) the log from entry `from`: a note-on (K_ON), a note-off (K_OFF) or a CC (its number: 102, 103, 123) with the
+ * value v (-1 any), on channel ch (16 any): how many, the first's index (-1 none), the last one's value (-1 none) */
+enum { K_ON = 0x100, K_OFF = 0x101, ANY_CH = 16 };
+static int lmatch(uint32_t pkt, uint32_t kind, uint32_t ch, int v)
+{
+    uint32_t cin = pkt & 15u, st = (pkt >> 8) & 0xFFu, d1 = (pkt >> 16) & 0x7Fu, d2 = (pkt >> 24) & 0x7Fu;
+    if (st >= 0xF0u || (ch < 16u && (st & 15u) != ch))
+        return 0;
+    if (kind == K_ON)
+        return cin == 0x9u && (st & 0xF0u) == 0x90u;
+    if (kind == K_OFF)
+        return cin == 0x8u && (st & 0xF0u) == 0x80u;
+    return cin == 0xBu && (st & 0xF0u) == 0xB0u && d1 == kind && (v < 0 || d2 == (uint32_t)v);
+}
+static uint32_t lcount(uint32_t from, uint32_t kind, uint32_t ch, int v)
+{
+    uint32_t i, n = 0;
+    for (i = from; i < mlog_n; i++)
+        n += (uint32_t)lmatch(mlog[i], kind, ch, v);
+    return n;
+}
+static int lfirst(uint32_t from, uint32_t kind, uint32_t ch, int v)
+{
+    uint32_t i;
+    for (i = from; i < mlog_n; i++)
+        if (lmatch(mlog[i], kind, ch, v))
+            return (int)i;
+    return -1;
+}
+static int llast_val(uint32_t from, uint32_t kind, uint32_t ch)
+{
+    int r = -1;
+    uint32_t i;
+    for (i = from; i < mlog_n; i++)
+        if (lmatch(mlog[i], kind, ch, -1))
+            r = (int)(mlog[i] >> 24 & 0x7Fu);
+    return r;
+}
+static uint32_t cc103(uint32_t ti, uint32_t v)       /* the packet: track ti's mute v on its channel */
+{
+    return 0x0Bu | (0xB0u | trk_midi_ch(ti)) << 8 | SEQ_MUTE_CC << 16 | v << 24;
+}
+static uint32_t step_blocks(uint32_t n) { return n * div_samples(2) / CTL; }   /* n 1/16 steps, in blocks */
+static void settle(void) { blocks(1); reset_log(); }  /* a block (what changed while set up sent), the log emptied */
+static void glo_mute(uint32_t ti)                    /* GLO + its black key: a track's MUTE turned (latched, at once) */
+{
+    lay_combo(B_GLO, black(ti));
+    key_up(black(ti));
+    btn_up(B_GLO);
+    frame();
+}
