diff --git a/web/make_vizz_installer.py b/web/make_vizz_installer.py
new file mode 100644
index 0000000..f5a9e7e
--- /dev/null
+++ b/web/make_vizz_installer.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+# Copyright (C) 2026 Leo Kuroshita (@kurogedelic), Hügelton Instruments
+# (Vizz, a modified Skiff: after web/make_site.py)
+"""Make Vizz's browser installer: one self-contained HTML file, the package and the converter in it.
+
+  web/make_vizz_installer.py build/vizz-2.0.fwsc 2.0 OUT.html [CONV.wasm]
+
+As web/make_site.py makes Skiff's installer page (index_pkg.html with fm1pkg.js, fm1ota.js, fm1backup.js and (2.0)
+conv/conv.js inlined), with the package and the converter (build/conv/conv.wasm, web/conv/build.sh's, by default)
+carried in the page as data: URLs instead of files next to it, so the one file installs (opened from disk or any
+server, in Chrome or Edge: Web MIDI). Skiff 2.0's way over firmware before it stays whole: a complete backup saved
+first (Vizz-backup-DATE.json), after the install what 2.0 can't read converted and written back, the list of it, and
+the way back to M-VAVE's firmware (V15). Vizz is the FM-1's only; its identity is FM-1_8xx (Skiff's 7xx, Felucca's
+9xx). Where a unit's data comes from is told, for a Vizz, by its identity: Vizz X.Y is FM-1_8XY, and Vizz 1.x is
+Skiff 1.4 inside (its formats, its version string v1.x), Vizz 2.x Skiff 2.0; a development build (FM-1_80Y) and any
+other firmware by its version string, as Skiff's page does. The page's words name Vizz where they named the firmware;
+the credits and licences stay as Skiff's page has them (the licence links point at LICENSE, LICENSING.md and LICENSES/
+beside the page: copy them along, as a release folder of build.py has them).
+"""
+import base64
+import json
+import re
+import sys
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE))
+from make_site import product_of, strip_module  # noqa: E402
+
+BASE = "2.0.1"                                      # the Skiff this Vizz is made from
+# first, in the page's words (TEXT), the firmware's name; "Learn Skiff" is the name of Skiff's manual and stays
+WORDS = re.compile(r"\bSkiff\b(?!（使い方| \(the manual)")
+# then (old, new, count): every one must be found as often as given (the template changed: update these)
+EDITS = [
+    ("<title>Skiff</title>", "<title>Vizz</title>", 1),
+    ("<h1>Skiff</h1>", "<h1>Vizz</h1>", 1),
+    ('''  <p class="small"><span data-t="smk"></span>
+    <a href="https://github.com/illuminus5/skiff/blob/main/SMK37.md" target="_blank" rel="noopener" style="color:inherit">SMK37.md</a></p>
+''', "", 1),
+    ('<a href="../editor/"', '<a href="https://illuminus5.github.io/skiff/webapp/editor/" target="_blank" rel="noopener"', 1),
+    ('<a href="../../learn/"', '<a href="https://illuminus5.github.io/skiff/learn/" target="_blank" rel="noopener"', 1),
+    ('  <p class="small">Skiff by illuminus5, built on Felucca',
+     f'  <p class="small">Vizz is a modified version of Skiff {BASE} (SEQ MIDI OUT: the sequencer on USB MIDI, its '
+     'mutes as CC 103; the name), made for the VIZZ visualizer; not a release of Skiff.<br>\n'
+     '    Skiff by illuminus5, built on Felucca', 1),
+    ('href="../../firmware/LICENSING.md"', 'href="LICENSING.md"', 1),
+    ('href="../../firmware/LICENSE"', 'href="LICENSE"', 1),
+    ('href="../../firmware/LICENSES/Apache-2.0.txt"', 'href="LICENSES/Apache-2.0.txt"', 1),
+    ('href="../../firmware/LICENSES/"', 'href="LICENSES/"', 1),
+    ('github.com/illuminus5/skiff</a></p>', f'github.com/illuminus5/skiff</a> (v{BASE})</p>', 1),
+    ("say(`Skiff ${meta.version}`)", "say(`Vizz ${meta.version}`)", 1),
+    ("a.download = `Skiff-backup-", "a.download = `Vizz-backup-", 1),
+    ('intro: "FM-1 または SMK-37 を USB で接続してください。', 'intro: "FM-1 を USB で接続してください。', 1),
+    ('intro: "Connect the FM-1 or SMK-37 by USB.', 'intro: "Connect the FM-1 by USB.', 1),
+    ('beta: "Vizz はカスタムファームウェアです。不具合は GitHub で知らせてください。',
+     f'beta: "Vizz はカスタムファームウェア（Skiff {BASE} の改変版）です。不具合を Skiff に報告しないでください。', 1),
+    ('beta: "Vizz is custom firmware; please report problems on GitHub.',
+     f'beta: "Vizz is custom firmware, a modified Skiff {BASE}: please do not report its problems to Skiff.', 1),
+    ('editor: "エディタ（', 'editor: "Skiff のエディタ（オンライン。', 1),
+    ('editor: "Editor (', 'editor: "Skiff\'s editor (online; ', 1),
+    # (Vizz) where a unit's data comes from (the docstring): the backup and the conversion for a Vizz 1.x as for Skiff 1.4
+    ('const major = (v) => +(/(\\d+)\\.\\d/.exec(v || "") || [0, 0])[1];\n',
+     'const major = (v) => +(/(\\d+)\\.\\d/.exec(v || "") || [0, 0])[1];\n'
+     '// (Vizz) firmware before 2.0: a Vizz by its identity (FM-1_8XY is Vizz X.Y: 1.x Skiff 1.4\'s formats, 2.x Skiff\n'
+     '// 2.0\'s), a development build (FM-1_80Y) and any other firmware by its version string, as Skiff\'s page\n'
+     'const before20 = (id, info) => { const m = /^FM-1_8([1-9])\\d$/.exec(id.text);'
+     ' return m ? +m[1] < 2 : major(info.version) < 2; };\n', 1),
+    ("    if (!info.supported || major(info.version) >= 2) return null;\n",
+     "    if (!info.supported || !before20(device.id, info)) return null;\n", 1),
+]
+
+
+def page(pkg_path, version, conv_path):
+    raw = Path(pkg_path).read_bytes()
+    product = product_of(raw)
+    if not re.fullmatch(r"FM-1_8\d\d", product):
+        raise SystemExit(f"{pkg_path}: identity {product!r} is not Vizz's (FM-1_8xx)")
+    if b"FELUCCA-LOADER-1" not in raw:              # (as make_site.py: never a package with vendor files)
+        raise SystemExit(f"{pkg_path}: no Felucca loader in it; only fm1pkg_make.py packages")
+    conv = Path(conv_path)
+    if not conv.exists():
+        raise SystemExit(f"{conv}: no converter build (sh web/conv/build.sh, after the release build)")
+    wasm = conv.read_bytes()
+    if wasm[:4] != b"\0asm":
+        raise SystemExit(f"{conv}: not WebAssembly")
+    html = (HERE / "index_pkg.html").read_text(encoding="utf-8")
+    a, b = html.index("const TEXT = {"), html.index("let lang = ")
+    html = html[:a] + WORDS.sub("Vizz", html[a:b]) + html[b:]
+    for old, new, n in EDITS:
+        if html.count(old) != n:
+            raise SystemExit(f"index_pkg.html: {old[:60]!r} found {html.count(old)} times, not {n}; update EDITS")
+        html = html.replace(old, new)
+    a, b = html.index("const TEXT = {"), html.index("let lang = ")
+    words = html[a:b]                               # (what still names Skiff: its manual, its editor, the base, Skiff
+    kept = ("Learn Skiff", "Skiff のエディタ", "Skiff's editor", f"Skiff {BASE}", "to Skiff", "Skiff に報告")   # itself)
+    rest = [words[m.start() - 12:m.end() + 12] for m in re.finditer(r"\bSkiff\b", words)
+            if not any(k in words[m.start() - 12:m.end() + 12] for k in kept)]
+    if rest:
+        raise SystemExit(f"index_pkg.html: the page's words still name Skiff: {rest}")
+    lib = strip_module((HERE / "fm1pkg.js").read_text(encoding="utf-8")) + "\n" + \
+        strip_module((HERE / "fm1ota.js").read_text(encoding="utf-8")) + "\n" + \
+        strip_module((HERE / "fm1backup.js").read_text(encoding="utf-8")) + "\n" + \
+        strip_module((HERE / "conv" / "conv.js").read_text(encoding="utf-8"))
+    url = "data:application/octet-stream;base64," + base64.b64encode(raw).decode("ascii")
+    meta = json.dumps({"version": version, "product": product,   # (the package once: the page takes packages first)
+                       "packages": [{"product": product, "pkg": url}]})
+    for mark in ("/*LIB*/", "/*META*/", '"../editor/conv/conv.wasm"'):
+        if html.count(mark) != 1:
+            raise SystemExit(f"index_pkg.html must contain {mark} once; update make_vizz_installer.py")
+    html = html.replace('"../editor/conv/conv.wasm"',   # ((2.0) the converter: in the page, not webapp/editor/conv/)
+                        json.dumps("data:application/wasm;base64," + base64.b64encode(wasm).decode("ascii")))
+    return product, html.replace("/*LIB*/", lib).replace("/*META*/", meta)
+
+
+def main(pkg, version, out, conv=None):
+    product, html = page(pkg, version, conv or HERE.parent / "build" / "conv" / "conv.wasm")
+    Path(out).write_text(html, encoding="utf-8")
+    print(f"installer: {out} ({len(html)} B), Vizz {version}, {product}")
+
+
+if __name__ == "__main__":
+    if len(sys.argv) not in (4, 5):
+        sys.exit(__doc__)
+    main(*sys.argv[1:])
