-BOARD_PREFIX = {"fm1": "FM-1_7", "smk37": "SMK-37 Pro_7"}        # a release build's: prefix + X + Y
+BOARD_PRODUCT = {"fm1": "FM-1_800", "smk37": "SMK-37 Pro_700"}   # a dev build's identity ((Vizz) the FM-1's 8XY)
+BOARD_PREFIX = {"fm1": "FM-1_8", "smk37": "SMK-37 Pro_7"}        # a release build's: prefix + X + Y
 BOARD_DEFS = {"fm1": [], "smk37": ["-DBOARD_SMK37=1"]}           # the FM-1 build gets no new flag (byte-identical)
-BOARD_STEM = {"fm1": "skiff", "smk37": "skiff-smk37"}            # a release package: STEM-X.Y.fwsc
+BOARD_STEM = {"fm1": "vizz", "smk37": "skiff-smk37"}             # a release package: STEM-X.Y.fwsc ((Vizz) vizz-X.Y)
