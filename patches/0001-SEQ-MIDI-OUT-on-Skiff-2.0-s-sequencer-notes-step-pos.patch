+    menu_put(MI_SEQOUT, menu_step(MI_SEQOUT, 1));   /* a step up: ON */
+    reset_log();
+    transport_req = 1;
+    blocks(beat_blocks());
+    transport_req = 2;
+    blocks(2);
+    lscan(&m);
+    bad += check("  back ON: the notes go out again", menu_get(MI_SEQOUT) == 0u && m.on == NTRK && m.start == 1u && lpaired(1));
+    bad += check("MENU: SEQ MIDI OUT in the MIDI tab, after MIDI IN", MI_TAB[MI_SEQOUT] == MTAB_MIDI &&
+                 str_eq(MI_NAME[MI_SEQOUT], "SEQ MIDI OUT") && MI_SEQOUT == MI_ROUTE + 1u);
+    favorites.factory[15][5] = 8u;                   /* (RESET SETTINGS: ON again) */
+    settings_reset();
+    bad += check("  RESET SETTINGS: SEQ MIDI OUT ON", menu_get(MI_SEQOUT) == 0u && seq_midi_on);
+
+    /* (2.0) LENGTHS: T1 (GATE 100 %, a note 1 STEP: 2.0's default) a chord on step 0, C4 1 STEP, E4 2 STEPS, G4 4 STEPS
+     * (NOTES' LENGTH: per-note ties into the steps after it); C5 on step 8 a quarter of its step (its GATE locked) */
+    {
+        track_t *t = &trk[0];
+        int on[4], off[4], ok = 1;
+        static const uint8_t N[4] = {60, 64, 67, 72};
+        uint32_t l;
+        setup();
+        t->p[P_SGATE] = 127;
+        t->p[P_VOICE] = V_POLY;
+        t->step[0] = (step_t){{60, 64, 67}, 3, ST_NOTE, 0, 100};
+        t->step[8] = (step_t){{72}, 1, ST_NOTE, 0, 100};
+        ok &= len_set(t, 0, 2u, LEN_STEPS) == 0 && len_set(t, 0, 4u, LEN_STEPS + 2) == 0 && len_set(t, 8, 0, 32) == 0;
