@@ -1157,6 +1262,8 @@ static void seq_stop(void)
     if (song.playing && !song.g[G_CLOCK])
         smk_uart_tx_put(0xFCu);                    /* (the TRS jack: Stop) */
 #endif
+    if (song.playing && !song.g[G_CLOCK])
+        seq_midi_rt(0xFCu);                        /* (SEQ MIDI OUT) Stop ((2.0) SONG ONCE's end too: bank.c song_rewind) */
     song.playing = 0;
