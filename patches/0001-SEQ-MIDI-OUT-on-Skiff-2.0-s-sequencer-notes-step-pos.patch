@@ -1049,6 +1128,25 @@ static void smk_clk_block(uint32_t n)
 }
 #endif
 
+/* (SEQ MIDI OUT) the INT clock's MIDI Clock on USB: 24 a beat while playing, counted in samples as smk_clk_block's */
+static uint32_t seq_clk_acc __attribute__((section(".pool")));   /* (.pool: out of the merged globals) */
+#if !BOARD_SMK37 && SKIFF_SEQ_MIDI
+static __attribute__((noinline)) void seq_clk_block(uint32_t n)
+{
+    uint32_t b;
+    if (!song.playing || song.g[G_CLOCK] || !seq_midi_on)
+        return;
+    b = beat_samples();
+    seq_clk_acc += n * 24u;
+    while (b && seq_clk_acc >= b) {
+        seq_midi_rt(0xF8u);
+        seq_clk_acc -= b;
+    }
+}
+#else
+#define seq_clk_block(n) ((void)0)
+#endif
