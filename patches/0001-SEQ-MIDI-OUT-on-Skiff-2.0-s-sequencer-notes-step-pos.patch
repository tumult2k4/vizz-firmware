new file mode 100644
index 0000000..3912f1a
--- /dev/null
+++ b/tests/seqmidi_test.c
@@ -0,0 +1,533 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Skiff fork) SEQ MIDI OUT (seq.c seq_midi_*): what the sequencer plays goes out on USB MIDI, on the real sequencer,
+ * USB queue and UI sources (with the stubs of tests/ui_test.c):
+ *   NOTES      a step's notes: note-on on the track's channel with its velocity (accent 127), note-off at its gate;
+ *              each track on its own channel (T1..T6 CHANNEL); a drum hit as its GM note ((2.0) on a kit of its own,
+ *              USR1..USR3, too)
+ *   STEP       entering a step: CC 102 = its index on the track's channel
+ *   CLOCK      INT clock: Start at PLAY, 24 Clock a beat, Stop at STOP; with an external clock: none of the three
+ *   RATCH      x3: three note-on / note-off pairs in the step
+ *   SLIDE      a slide into the same note sends no second note-on, and every note-on gets one note-off
+ *   MENU       MENU > MIDI > SEQ MIDI OUT: ON by default, OFF sends nothing, back ON sends again
+ * (2.0) Skiff 2.0's sequencer (seq.c seq_step, seq_gate_end; launch.c; bank.c song_poll):
+ *   LENGTHS    a chord's notes of their own lengths (NOTES' LENGTH: 1, 2 and 4 STEPS) end apart, each with its own
+ *              note-off at its own end; a note a quarter of its step long (a GATE lock) ends there
+ *   OVERLAP    a pitch struck again while it still sounds on the channel (it goes on into the step half a step past
+ *              its GATE, a tie beside it holding): its note-off first, then the note-on (one of a pitch on a channel)
+ *   TIE        a TIE chain and a note tied on by per-note ties: one note-on, one note-off
+ *   CHAIN      A (LEN 4) on CHAIN into B (LEN 6): CC 102 counts each part from 0 (A 0..3, B 0..5, A again); A's last
+ *              note going on into B is one note
+ *   ONCE       SONG ONCE: at its end the transport stops: every note-on its note-off, one Stop, no Clock after it
+ *   PAIRS      in every case: on a channel, a pitch's note-ons and note-offs alternate (never two note-ons)
+ * Built and run by tests/run_tests.sh. */
+#define UI_TEST_NO_MAIN 1
+#include "ui_test.c"
+
+typedef struct { uint32_t on, off, cc, clk, start, stop, onvel_sum, ch_mask, last_cc; uint8_t onn[64]; } mstat_t;
+
+/* run the sequencer for `blocks` blocks as the audio ISR does (events_block), draining the USB ring as the host would:
+ * the events are copied to a log (the ring itself holds MQ), each with the block it came in (mtime: its sample) */
+static uint32_t mlog[16384], mtime[16384], mlog_n, mclock;
+static void drain(void)
+{
+    while (mo_r != mo_w && mlog_n < NELEM(mlog)) {
+        mtime[mlog_n] = mclock;
+        mlog[mlog_n++] = midi_out_q[mo_r++ % MQ];
+    }
+    mo_r = mo_w;
+}
+static void blocks(uint32_t n)
+{
+    while (n--) {
+        events_block(CTL);
+        mclock += CTL;
+        drain();
+    }
+}
+/* .. with the main loop's switching after each (bank.c bank_poll, song_poll: a chain's next part, a song's end) */
+static void blocks_main(uint32_t n)
+{
+    while (n--) {
+        events_block(CTL);
+        mclock += CTL;
+        bank_poll();
+        song_poll();
+        drain();
+    }
+}
+static void lscan(mstat_t *m)                       /* the log, counted */
+{
+    uint32_t i;
+    memset(m, 0, sizeof *m);
+    for (i = 0; i < mlog_n; i++) {
+        uint32_t pkt = mlog[i], cin = pkt & 15u, st = (pkt >> 8) & 0xFFu, d1 = (pkt >> 16) & 0x7Fu, d2 = (pkt >> 24) & 0x7Fu;
+        if (cin == 0x9u && (st & 0xF0u) == 0x90u) {
+            if (m->on < 64u)
+                m->onn[m->on] = (uint8_t)d1;
+            m->on++;
+            m->onvel_sum += d2;
+            m->ch_mask |= 1u << (st & 15u);
+        } else if (cin == 0x8u && (st & 0xF0u) == 0x80u)
+            m->off++;
+        else if (cin == 0xBu && (st & 0xF0u) == 0xB0u && d1 == SEQ_STEP_CC) {
+            m->cc++;
+            m->last_cc = d2;
+        } else if (cin == 0xFu && st == 0xF8u)
+            m->clk++;
+        else if (cin == 0xFu && st == 0xFAu)
+            m->start++;
+        else if (cin == 0xFu && st == 0xFCu)
+            m->stop++;
+    }
+}
+static void reset_log(void) { drain(); mlog_n = 0; }
+static void ldump(const char *what)                 /* (SEQMIDI_DUMP=1: the log, for a failing case) */
+{
+    uint32_t i;
+    if (!getenv("SEQMIDI_DUMP"))
+        return;
+    printf("ui:   log of %s (%u):\n", what, mlog_n);
+    for (i = 0; i < mlog_n; i++)
+        if ((mlog[i] >> 8 & 0xFFu) != 0xF8u)
+            printf("ui:     %4u t %6u  %02X %3u %3u\n", i, mtime[i], mlog[i] >> 8 & 0xFFu, mlog[i] >> 16 & 0x7Fu,
+                   mlog[i] >> 24 & 0x7Fu);
+}
+
+/* the log from entry `from`: a note-on (K_ON), a note-off (K_OFF) or a CC (its number: 102, 103, 123) with the value v
+ * (-1 any; a note's: its pitch), on channel ch (16 any): how many, the first's index (-1 none), the last one's value */
+enum { K_ON = 0x100, K_OFF = 0x101, ANY_CH = 16 };
+static int lmatch(uint32_t pkt, uint32_t kind, uint32_t ch, int v)
+{
+    uint32_t cin = pkt & 15u, st = (pkt >> 8) & 0xFFu, d1 = (pkt >> 16) & 0x7Fu, d2 = (pkt >> 24) & 0x7Fu;
+    if (st >= 0xF0u || (ch < 16u && (st & 15u) != ch))
+        return 0;
+    if (kind == K_ON)
+        return cin == 0x9u && (st & 0xF0u) == 0x90u && (v < 0 || d1 == (uint32_t)v);
+    if (kind == K_OFF)
+        return cin == 0x8u && (st & 0xF0u) == 0x80u && (v < 0 || d1 == (uint32_t)v);
+    return cin == 0xBu && (st & 0xF0u) == 0xB0u && d1 == kind && (v < 0 || d2 == (uint32_t)v);
+}
+static uint32_t lcount(uint32_t from, uint32_t kind, uint32_t ch, int v)
+{
+    uint32_t i, n = 0;
+    for (i = from; i < mlog_n; i++)
+        n += (uint32_t)lmatch(mlog[i], kind, ch, v);
+    return n;
+}
+static int lfirst(uint32_t from, uint32_t kind, uint32_t ch, int v)
+{
+    uint32_t i;
+    for (i = from; i < mlog_n; i++)
+        if (lmatch(mlog[i], kind, ch, v))
+            return (int)i;
+    return -1;
+}
+static int llast_val(uint32_t from, uint32_t kind, uint32_t ch)
+{
+    int r = -1;
+    uint32_t i;
+    for (i = from; i < mlog_n; i++)
+        if (lmatch(mlog[i], kind, ch, -1))
+            r = (int)(mlog[i] >> 24 & 0x7Fu);
+    return r;
+}
+/* (2.0) every channel's every pitch: its note-ons and note-offs alternate, starting with a note-on (an off for a note
+ * never sent sounding, or a second on before its off: 0); closed: none left sounding */
+static int lpaired(int closed)
+{
+    static uint8_t s[16][128];
+    uint32_t i, ch, n;
+    memset(s, 0, sizeof s);
+    for (i = 0; i < mlog_n; i++) {
+        uint32_t pkt = mlog[i], st = (pkt >> 8) & 0xFFu, d1 = (pkt >> 16) & 0x7Fu;
+        if (lmatch(pkt, K_ON, ANY_CH, -1)) {
+            if (s[st & 15u][d1])
+                return 0;
+            s[st & 15u][d1] = 1;
+        } else if (lmatch(pkt, K_OFF, ANY_CH, -1)) {
+            if (!s[st & 15u][d1])
+                return 0;
+            s[st & 15u][d1] = 0;
+        }
+    }
+    for (ch = 0, n = 0; ch < 16u; ch++)
+        for (i = 0; i < 128u; i++)
+            n += s[ch][i];
+    return !closed || !n;
+}
+
+/* every track empty but those set up; 16 steps of 1/16 at 120 BPM, GATE 64, no swing */
+static void setup(void)
+{
+    uint32_t i;
+    ui_power_on();
+    usb.config = 1;
+    usb.suspended = 0;
+    song.g[G_BPM] = 120;
+    song.g[G_SWING] = 0;
+    song.g[G_CLOCK] = 0;
+    for (i = 0; i < NTRK; i++) {
+        track_t *t = &trk[i];
+        track_defaults_steps(t);
+        memset(t->step, 0, sizeof t->step);
+        t->p[P_SLEN] = 16;
+        t->p[P_SGATE] = 64;
+        t->p[P_SSWING] = 0;
+        t->p[P_SDIV] = 2;
+        t->p[P_MUTE] = 0;
+    }
+    seq_midi_on = 1;
+    memset(seq_mo, 0, sizeof seq_mo);
+    reset_log();
+    mclock = 0;
+}
+static uint32_t beat_blocks(void) { return beat_samples() / CTL; }
+static uint32_t step_blocks(uint32_t n) { return n * div_samples(2) / CTL; }   /* n 1/16 steps, in blocks */
+static uint32_t slen(void) { return div_samples(2); }                          /* a 1/16 step, samples */
+static int lat(int i) { return i < 0 ? -1 : (int)mtime[i]; }                   /* an entry's time (-1 none) */
+
+int main(void)
+{
+    int bad = 0;
+    mstat_t m;
+    uint32_t i;
+
+    /* NOTES + STEP + CLOCK: track 1 a note on step 0 (vel 100) and an accented one on step 4; track 3 a note on step 8 */
+    setup();
+    trk[0].step[0] = (step_t){{60}, 1, ST_NOTE, 0, 100};
+    trk[0].step[4] = (step_t){{64}, 1, ST_NOTE, SF_ACCENT, 100};
+    trk[2].step[8] = (step_t){{67}, 1, ST_NOTE, 0, 90};
+    transport_req = 1;
+    blocks(4u * beat_blocks() - 2u);                /* one bar, the last block or two short of the next pass */
+    lscan(&m);
+    bad += check("SEQ MIDI OUT ON by default (no setting stored)", menu_get(MI_SEQOUT) == 0u && str_eq(menu_vname(MI_SEQOUT, 0), "ON"));
+    bad += check("a bar: 3 note-ons, the velocities as played (100, accent 127, 90)", m.on == 3u && m.onvel_sum == 100u + 127u + 90u);
+    bad += check("  on the tracks' channels (T1 ch 1, T3 ch 3)", m.ch_mask == ((1u << trk_midi_ch(0)) | (1u << trk_midi_ch(2))));
+    bad += check("  every note-on ended by its gate (3 note-offs)", m.off == 3u && lpaired(1));
+    bad += check("  the notes: 60, 64, 67", m.onn[0] == 60u && m.onn[1] == 64u && m.onn[2] == 67u);
+    bad += check("STEP: CC 102 for each step entered, every track (16 x 6)", m.cc == 16u * NTRK);
+    if (m.cc != 16u * NTRK)
+        printf("ui:   step CCs %u\n", m.cc);
+    bad += check("CLOCK: Start once, 24 Clock a beat (95 or 96 in the bar)", m.start == 1u && m.clk >= 95u && m.clk <= 96u);
+    if (m.clk < 95u || m.clk > 96u)
+        printf("ui:   clocks %u\n", m.clk);
+    reset_log();
+    transport_req = 2;
+    blocks(2);
+    lscan(&m);
+    bad += check("STOP: one Stop, no Clock after it", m.stop == 1u && m.clk == 0u);
+
+    /* channels follow T1..T6 CHANNEL */
+    setup();
+    menu_put(MI_TCH1 + 1, 9);                       /* T2 on channel 10 */
+    trk[1].step[0] = (step_t){{50}, 1, ST_NOTE, 0, 100};
+    transport_req = 1;
+    blocks(4);
+    lscan(&m);
+    bad += check("T2 CHANNEL 10: its note on channel 10", m.on == 1u && m.ch_mask == 1u << 9);
+    transport_req = 2;
+    blocks(2);
+    menu_put(MI_TCH1 + 1, 1);
+
+    /* DRUM hits as GM notes */
+    setup();
+    trk[0].step[0] = (step_t){{0}, 0, ST_NOTE, 0, 100};
+    trk[0].step[0].hit = 1u | 2u;                    /* lanes 0 and 1 */
+    transport_req = 1;
+    blocks(4);
+    lscan(&m);
+    bad += check("drum hits: their GM notes (lanes 0, 1)", m.on == 2u && m.onn[0] == DRUM_LANE_NOTE[0] && m.onn[1] == DRUM_LANE_NOTE[1]);
+    transport_req = 2;
+    blocks(2);
+    {   /* (2.0, #35) a DRUM track on its own kit USR1..USR3 (a user sample slot a lane): the same GM notes */
+        int ok = 1;
+        for (i = 0; i < 3u; i++) {
+            setup();
+            set_engine_of(&trk[0], ENGI_DRUM);
+            trk[0].engine = trk[0].eng_req;
+            trk[0].p[P_E0] = (int16_t)(DK_USR1 + i);
+            trk[0].step[0] = (step_t){{0}, 0, ST_NOTE, 0, 100};
+            trk[0].step[0].hit = 1u | 4u | 0x80u;    /* lanes 0, 2, 7 */
+            transport_req = 1;
+            blocks(4);
+            lscan(&m);
+            ok &= drum_user(trk[0].p) == i + 1u && m.on == 3u && m.onn[0] == DRUM_LANE_NOTE[0] &&
+                  m.onn[1] == DRUM_LANE_NOTE[2] && m.onn[2] == DRUM_LANE_NOTE[7];
+            transport_req = 2;
+            blocks(2);
+        }
+        bad += check("  (2.0) on the kits of its own, USR1..USR3: the same GM notes (lanes 0, 2, 7)", ok);
+    }
+
+    /* RATCH x3 */
+    setup();
+    trk[0].p[P_SLEN] = 1;
+    trk[0].step[0] = (step_t){{60}, 1, ST_NOTE, 0, 100};
+    step_set_ratchet(&trk[0].step[0], 3);
+    transport_req = 1;
+    blocks(step_samples(&trk[0], div_samples(2), 0) / CTL - 1u);
+    lscan(&m);
+    bad += check("RATCH x3: three note-ons in the step, each with its note-off", m.on == 3u && m.off >= 2u && lpaired(0));
+    transport_req = 2;
+    blocks(2);
+    lscan(&m);
+    bad += check("  and after STOP every note-on has its note-off", m.on == m.off && lpaired(1));
+
+    /* SLIDE into the same note: one note-on, held; pairs balanced at STOP */
+    setup();
+    trk[0].p[P_SLEN] = 2;
+    trk[0].step[0] = (step_t){{60}, 1, ST_NOTE, SF_SLIDE, 100};
+    trk[0].step[1] = (step_t){{60}, 1, ST_NOTE, 0, 100};
+    transport_req = 1;
+    blocks(2u * step_samples(&trk[0], div_samples(2), 0) / CTL - 1u);
+    lscan(&m);
+    bad += check("SLIDE into the same note: no second note-on while it sounds", m.on == 1u);
+    transport_req = 2;
+    blocks(2);
+    lscan(&m);
+    bad += check("  note-ons and note-offs balanced after STOP", m.on == m.off && lpaired(1));
+
+    /* external clock: no Start / Clock / Stop from us (notes still go out) */
+    setup();
+    trk[0].step[0] = (step_t){{60}, 1, ST_NOTE, 0, 100};
+    song.g[G_CLOCK] = 1;
+    blocks(1);
+    seq_start();                                     /* as midi_clock_transport would */
+    blocks(beat_blocks());
+    seq_stop();
+    drain();
+    lscan(&m);
+    bad += check("external clock: no Start, Clock or Stop sent", m.start == 0u && m.clk == 0u && m.stop == 0u);
+    song.g[G_CLOCK] = 0;
+
+    /* MENU: OFF sends nothing, back ON sends again */
+    setup();
+    menu_put(MI_SEQOUT, menu_step(MI_SEQOUT, -1));   /* a step down: OFF (ON is value 0, as HINTS) */
+    for (i = 0; i < NTRK; i++)
+        trk[i].step[0] = (step_t){{60}, 1, ST_NOTE, 0, 100};
+    transport_req = 1;
+    blocks(beat_blocks());
+    transport_req = 2;
+    blocks(2);
+    lscan(&m);
+    bad += check("MENU > MIDI > SEQ MIDI OUT OFF: nothing sent (no notes, steps, clock, start, stop)",
+                 menu_get(MI_SEQOUT) == 1u && str_eq(menu_vname(MI_SEQOUT, 1), "OFF") && !m.on && !m.off && !m.cc && !m.clk && !m.start && !m.stop);
+    bad += check("  OFF is bit 3 of the settings byte CPU2_BYTE (saved with the settings), the others as they were",
