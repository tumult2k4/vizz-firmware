     cin_left = 0;                                  /* (a count-in: cancelled, nothing recorded) */
@@ -1310,13 +1417,19 @@ static __attribute__((noinline)) void seq_step(track_t *t, const step_t *s, uint
         if (!held)
             seq_release(t);
         for (i = 0; i < m; i++)
-            if (!(((sk | on | xs) >> i) & 1u))
+            if (!(((sk | on | xs) >> i) & 1u)) {
                 trk_note_on(t, nn[i], vv[i]);
+                if (!slide_in || !seq_mo_has(k, nn[i]))   /* (SEQ MIDI OUT) a note slid into and still sounding:
+                                                         * no new note-on (struck again otherwise: off, then on) */
