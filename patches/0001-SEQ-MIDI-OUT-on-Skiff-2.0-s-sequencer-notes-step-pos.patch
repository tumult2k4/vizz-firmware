+/* (Skiff fork, SEQ MIDI OUT) MENU > MIDI > SEQ MIDI OUT, ON by default: what the sequencer plays goes out on USB MIDI as
+ * the keys' notes do, on each track's channel (trk_midi_ch): its notes and drum hits (GM notes, DRUM_LANE_NOTE) with
+ * their velocity (accent 127, ratchets and flams as played), and on entering a step its index as CC SEQ_STEP_CC (0..63,
+ * for a visualizer: where each track is; (2.0) a chain's part counted from its own first step). With the INT clock also
+ * MIDI Clock (24 per beat) and Start / Stop, so a host can follow the tempo. ui_input.c copies the setting here every
+ * frame (ui.c SEQOUT_OFF); the audio ISR reads it. A host that echoes this back into the FM-1 plays every note twice:
+ * route it elsewhere.
+ * (2.0) Each note ends with its own note-off as the sequencer ends it (its own length, a tie into the steps after it: one
+ * note; a chord's notes apart). MIDI has one note of a pitch on a channel: one struck again while it still sounds there
+ * (an overlap, a step played early by its NUDGE) ends first. seq_mo: the notes sent sounding, a bit per pitch and track */
+#ifndef SKIFF_SEQ_MIDI
+#define SKIFF_SEQ_MIDI 1
+#endif
+#define SEQ_STEP_CC 102u                            /* an undefined controller: harmless to a synth that hears it */
+static volatile uint8_t seq_midi_on = 1;
+#if SKIFF_SEQ_MIDI
+static uint8_t seq_mo[NTRK][16] __attribute__((section(".pool")));   /* (.pool, zeroed at boot: a new .bss global moves
+                                                                        * the others and their code with them) */
+static int seq_mo_any(uint32_t ti)                  /* track ti has notes sent sounding */
+{
+    uint32_t i, m = 0;
+    for (i = 0; i < 16u; i++)
+        m |= seq_mo[ti][i];
+    return m != 0u;
+}
+static int seq_mo_has(uint32_t ti, uint32_t note) { return (seq_mo[ti][(note & 0x7Fu) >> 3] >> (note & 7u)) & 1u; }
+static __attribute__((noinline)) void seq_midi_note(uint32_t ti, uint32_t note, uint32_t vel)
+{
+    uint32_t mc = trk_midi_ch(ti), b = 1u << (note & 7u);
+    uint8_t *m = &seq_mo[ti][(note & 0x7Fu) >> 3];
+    note &= 0x7Fu;
+    if (!vel) {                                     /* a note-off: for a note sent sounding */
+        if (*m & b) {
+            *m = (uint8_t)(*m & ~b);
+            if (seq_midi_on)
+                midi_out_event(0x08u | (0x80u | mc) << 8 | note << 16);
+        }
+        return;
+    }
+    if (!seq_midi_on)
+        return;
+    if (*m & b)                                     /* (still sounding on its channel: ended first) */
+        midi_out_event(0x08u | (0x80u | mc) << 8 | note << 16);
+    midi_out_event(0x09u | (0x90u | mc) << 8 | note << 16 | (vel & 0x7Fu) << 24);
+    *m = (uint8_t)(*m | b);
+}
+static __attribute__((noinline)) void seq_midi_step(uint32_t ti, uint32_t idx)
+{
+    if (seq_midi_on)
+        midi_out_event(0x0Bu | (0xB0u | trk_midi_ch(ti)) << 8 | SEQ_STEP_CC << 16 | (idx & 0x7Fu) << 24);
+}
+static void seq_midi_alloff(uint32_t ti)            /* CC 123 All Notes Off: a panic dropped notes without their offs */
+{
+    if (seq_midi_on)
+        midi_out_event(0x0Bu | (0xB0u | trk_midi_ch(ti)) << 8 | 123u << 16);
+}
+static __attribute__((noinline)) void seq_midi_drop(uint32_t ti)   /* .. for the notes sent sounding, which are gone */
+{
+    if (seq_mo_any(ti))
+        seq_midi_alloff(ti);
+    memset(seq_mo[ti], 0, sizeof seq_mo[ti]);
+}
+#if !BOARD_SMK37                                    /* (the SMK sends its own clock to TRS: smk_clk_block) */
+static void seq_midi_rt(uint32_t st)                /* a realtime byte: Clock F8, Start FA, Stop FC (CIN F) */
+{
+    if (seq_midi_on)
+        midi_out_event(0x0Fu | st << 8);
+}
+#else
+#define seq_midi_rt(st) ((void)0)
+#endif
+#else
+#define seq_midi_note(ti, note, vel) ((void)0)
+#define seq_midi_step(ti, idx) ((void)0)
+#define seq_midi_rt(st) ((void)0)
+#define seq_midi_drop(ti) ((void)0)
+#define seq_mo_has(ti, note) 0
+#endif
+
 static int drum_track(const track_t *t) { return drum_engine(eng_idx(t->eng_req)); }   /* ((Skiff) DRUM or DRUM-X) */
 
