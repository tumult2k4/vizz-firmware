+            }
         for (i = 0; i < t->seq_n; i++) {            /* release what is not held over (nor plays again) */
             for (j = 0; j < m && (nn[j] != t->seq_notes[i] || ((xs >> j) & 1u)); j++)
                 ;
-            if (j == m)
+            if (j == m) {
