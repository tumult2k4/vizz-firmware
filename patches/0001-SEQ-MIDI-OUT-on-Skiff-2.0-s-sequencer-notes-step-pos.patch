+                seq_midi_note(k, t->seq_notes[i], 0);   /* (SEQ MIDI OUT) */
+            }
         }
         t->seq_n = 0;
         for (i = 0; i < m; i++)
@@ -1518,6 +1631,8 @@ static void seq_tick(track_t *t, uint32_t n)
             take_pass[trk_index(t)]++;              /* a new pass of its loop: TAKES (take.c), the conditions */
         }
         t->seq_cnt++;
+        seq_midi_step(trk_index(t), t->seq_idx);    /* (SEQ MIDI OUT) where the track is: CC SEQ_STEP_CC ((2.0) a chain's
