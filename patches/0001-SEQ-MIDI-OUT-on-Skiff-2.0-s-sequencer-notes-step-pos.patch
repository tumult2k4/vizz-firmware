 #endif
+    if (!song.g[G_CLOCK]) {                        /* (SEQ MIDI OUT) Start, the first Clock with the first block */
+        seq_midi_rt(0xFAu);
+        seq_clk_acc = beat_samples();
+    }
     motion_begin();
