+        ok &= off[3] - on[3] >= (int)(l / 4u) - CTL && off[3] - on[3] <= (int)(l / 4u) + CTL;
+        bad += check("  C5 a quarter of its step (its GATE locked to 25 %): its note-off a quarter step after it", ok);
+        if (!ok)
+            printf("ui:   C5 on %d off %d (a step %u)\n", on[3], off[3], l);
+        transport_req = 2;
+        blocks(2);
+    }
+
+    /* (2.0) OVERLAP: GATE 100 %; C4 on step 0 tied into step 1 (2 STEPS), E4 starting on step 1 tied into step 2, C4
+     * again on step 2: the first C4 goes on half a step past step 1's GATE (seq_gate_end) and E4's tie holds the notes
+     * over (seq_k): the new C4 comes while the first still sounds */
+    {
+        track_t *t = &trk[0];
+        int a, b, c, ok;
+        setup();
+        t->p[P_SGATE] = 127;
+        t->p[P_VOICE] = V_POLY;
+        t->step[0] = (step_t){{60}, 1, ST_NOTE, 0, 100};
+        t->step[1] = (step_t){{60, 64}, 2, ST_NOTE, 0, 100, 0, 1};    /* (C4 tied: acc bit 0) */
+        t->step[2] = (step_t){{64, 60}, 2, ST_NOTE, 0, 100, 0, 1};    /* (E4 tied, C4 new) */
+        transport_req = 1;
+        blocks(step_blocks(2) + step_blocks(1) / 4u);  /* (into step 2) */
+        a = lfirst(0, K_ON, 0, 60);
+        b = lfirst((uint32_t)a + 1u, K_OFF, 0, 60);
+        c = lfirst((uint32_t)a + 1u, K_ON, 0, 60);
+        ok = a >= 0 && b > a && c == b + 1 && lat(b) == lat(c) && lat(c) - lat(a) >= (int)(2u * slen()) - CTL &&
+             lat(c) - lat(a) <= (int)(2u * slen()) + CTL &&
+             lcount(0, K_ON, 0, 60) == 2u && lcount(0, K_ON, 0, 64) == 1u && lpaired(0);
+        bad += check("(2.0) OVERLAP: C4 struck again while it sounds (step 2): its note-off first, then the note-on", ok);
+        if (!ok)
+            printf("ui:   C4 on %d (t %d), off %d (t %d), on %d (t %d); a step %u\n", a, lat(a), b, lat(b), c, lat(c), slen());
+        blocks(step_blocks(4));
+        transport_req = 2;
+        blocks(2);
+        bad += check("  every pitch's note-ons and note-offs alternate (never two note-ons), none left after STOP",
+                     lpaired(1) && lcount(0, K_ON, ANY_CH, -1) == lcount(0, K_OFF, ANY_CH, -1));
+    }
+
+    /* (2.0) TIE: a TIE chain (steps 1..3 TIE) and, on T2 (GATE 100 %), D4 held over four steps by per-note ties (steps
+     * 1..3 list it tied): one note each */
+    {
+        int ok;
+        setup();
+        trk[0].step[0] = (step_t){{60}, 1, ST_NOTE, 0, 100};
+        for (i = 1; i < 4u; i++)
+            trk[0].step[i] = (step_t){{0}, 0, ST_TIE, 0, 0};
+        trk[1].p[P_SGATE] = 127;
+        trk[1].step[0] = (step_t){{62}, 1, ST_NOTE, 0, 100};
+        for (i = 1; i < 4u; i++)                     /* (as tests/ties_test.c: each step lists D4 tied, acc bit 0) */
+            trk[1].step[i] = (step_t){{62}, 1, ST_NOTE, 0, 100, 0, 1};
+        ok = step_ties(&trk[1].step[3]) == 1u;
+        transport_req = 1;
+        blocks(step_blocks(6));
+        ok &= lcount(0, K_ON, 0, 60) == 1u && lcount(0, K_OFF, 0, 60) == 1u &&
+              lat(lfirst(0, K_OFF, 0, 60)) > (int)(3u * slen()) && lcount(0, K_ON, 1, 62) == 1u &&
+              lcount(0, K_OFF, 1, 62) == 1u && lat(lfirst(0, K_OFF, 1, 62)) > (int)(3u * slen()) && lpaired(1);
+        ldump("TIE");
+        bad += check("(2.0) TIE: a TIE chain and a note tied on over 4 steps: one note-on, one note-off each, at its end", ok);
+        transport_req = 2;
+        blocks(2);
+    }
+
+    /* (2.0) CHAIN: T1 A (LEN 4, C4 on its last step, 3 STEPS: on into B's first two) on CHAIN into B (LEN 6), SONG OFF:
+     * the chain loops, A B A */
+    {
+        track_t *t = &trk[0];
+        uint32_t k, want[16], nw = 0, got[24], ng = 0;
+        int ok;
+        setup();
+        lists_clear();
+        track_defaults_steps(t);
+        t->p[P_SLEN] = 4;
+        t->p[P_SGATE] = 64;
+        t->p[P_SSWING] = 0;
+        t->p[P_VOICE] = V_POLY;
+        trk_pid[0] = 0;
+        t->step[3] = (step_t){{60}, 1, ST_NOTE, 0, 100};
+        bank_put(0, 0, 0);                           /* A */
+        track_defaults_steps(t);
+        t->p[P_SLEN] = 6;
+        t->p[P_SSWING] = 0;
+        trk_pid[0] = 0;
+        bank_put(0, 1, 0);                           /* B */
+        lists.ent[0][0][1] = REPS_CHAIN;
+        (void)ent_go(0, 0);
+        undo_clear();
+        song_poll();
+        ok = len_set(t, 3, 0, LEN_STEPS + 1) == 0 && t->p[P_SLEN] == 4;
+        reset_log();
+        transport_req = 1;
+        blocks_main(step_blocks(4 + 6 + 4) - 2u);
+        for (k = 0; k < 4u; k++)
+            want[nw++] = k;
+        for (k = 0; k < 6u; k++)
+            want[nw++] = k;
+        for (k = 0; k < 4u; k++)
+            want[nw++] = k;
+        for (i = 0; i < mlog_n && ng < NELEM(got); i++)
+            if (lmatch(mlog[i], SEQ_STEP_CC, 0, -1))
+                got[ng++] = mlog[i] >> 24 & 0x7Fu;
+        ok &= ng == nw;
+        for (k = 0; ok && k < nw; k++)
+            ok &= got[k] == want[k];
+        bad += check("(2.0) CHAIN: CC 102 counts each part from 0 (A 0..3, B 0..5, A 0..3 again), not on through", ok);
+        if (!ok) {
+            printf("ui:   step CCs:");
+            for (k = 0; k < ng; k++)
+                printf(" %u", got[k]);
+            printf("\n");
+        }
+        ok = lcount(0, K_ON, 0, 60) == 2u && lcount(0, K_OFF, 0, 60) == 1u &&
+             lat(lfirst(0, K_OFF, 0, 60)) > (int)(5u * slen()) && lat(lfirst(0, K_OFF, 0, 60)) < (int)(7u * slen()) &&
+             lpaired(0);
+        bad += check("  A's last note on into B's first two steps: one note (its note-off in B), then A's again", ok);
+        transport_req = 2;
+        blocks_main(2);
+        lists_clear();
+    }
+
+    /* (2.0) SONG ONCE: T1 a list of one entry (LEN 4, C4 on step 0, E4 on step 3, GATE 100 %), REPS x2; T2 no list,
+     * D4 held by a TIE chain over its 16 steps: sounding when the song ends */
+    {
+        track_t *t = &trk[0];
+        uint32_t n;
+        int ok, stop;
+        setup();
+        lists_clear();
+        track_defaults_steps(t);
+        t->p[P_SLEN] = 4;
+        t->p[P_SGATE] = 127;
+        t->p[P_SSWING] = 0;
+        trk_pid[0] = 0;
+        t->step[0] = (step_t){{60}, 1, ST_NOTE, 0, 100};
+        t->step[3] = (step_t){{64}, 1, ST_NOTE, 0, 100};
+        bank_put(0, 0, 0);
+        lists.ent[0][0][1] = 1;                      /* (REPS x2: ui.c ent_reps) */
+        trk[1].step[0] = (step_t){{62}, 1, ST_NOTE, 0, 100};
+        for (i = 1; i < 16u; i++)
+            trk[1].step[i] = (step_t){{0}, 0, ST_TIE, 0, 0};
+        lists.song = SONG_ONCE;
+        reset_log();
+        song_top();                                  /* PLAY (ui_input.c play_press) */
+        for (n = 0; n < 8u * step_blocks(1) && (n < 2u || song.playing); n++)
+            blocks_main(1);
+        blocks_main(4);
+        stop = -1;
+        for (i = 0; i < mlog_n; i++)
+            if (mlog[i] == (0x0Fu | 0xFCu << 8))
+                stop = (int)i;
+        lscan(&m);
+        ok = !song.playing && m.start == 1u && m.stop == 1u && lcount(0, K_ON, 0, 60) == 2u &&
+             lcount(0, K_ON, 0, 64) == 2u && lcount(0, K_ON, 1, 62) == 1u && lpaired(1) && stop >= 0 &&
+             lat(stop) >= (int)(8u * slen()) && lat(stop) <= (int)(9u * slen()) &&
+             lfirst((uint32_t)stop, K_OFF, 1, 62) > stop;   /* (T2's held note: ended at the Stop, as at STOP) */
+        for (i = (uint32_t)(stop < 0 ? 0 : stop); ok && i < mlog_n; i++)
+            ok &= mlog[i] != (0x0Fu | 0xF8u << 8);
+        ldump("SONG ONCE");
+        bad += check("(2.0) SONG ONCE: at its end the transport stops: every note-on its note-off, one Stop, no Clock after",
+                     ok);
+        if (!ok)
+            printf("ui:   playing %d, start %u stop %u (at %d of %u), ons %u offs %u\n", song.playing, m.start, m.stop,
+                   stop, mlog_n, m.on, m.off);
+        lists.song = 0;
+        lists_clear();
+    }
+
+    printf("seqmidi: %s\n", bad ? "FAILED" : "all ok");
+    return bad != 0;
+}
