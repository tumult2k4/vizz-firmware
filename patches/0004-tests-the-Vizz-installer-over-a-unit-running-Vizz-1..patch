diff --git a/tests/vizz10_fixture.sh b/tests/vizz10_fixture.sh
new file mode 100755
index 0000000..30ea134
--- /dev/null
+++ b/tests/vizz10_fixture.sh
@@ -0,0 +1,139 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-3.0-only
+# (Vizz 2.0) A unit running Vizz 1.0, made by Vizz 1.0's own code: tests/vizz10_unit.json, the device the installer
+# test (web/test_vizz_installer.mjs) simulates. Built in a checkout of Vizz 1.0 (Skiff v1.4 with the vizz-1.0
+# branch's patches, after one ./build.sh there: build/gen):
+#   tests/vizz10_fixture.sh VIZZ10_TREE [OUT.json]       (default: tests/vizz10_unit.json)
+# What it holds, as Vizz 1.0 answers it:
+#   identity  FM-1_810 (the update handshake), the port named FM-1
+#   info      the editor's INFO reply (editor.c ED_INFO: "FELUCCA v1.0", the tags a complete backup needs)
+#   archive   a complete backup (editor_backup.c LIST, GET; web/fm1backup.js's file): the music (SKF3), the settings
+#             (PER4 with Skiff's mark; SEQ MIDI OUT OFF, T2 on channel 10), slot 1 saved by Vizz 1.0 (SKF3), slot 3
+#             one an older Skiff saved and 1.4 kept as it was (SKF2), a user sound (version 5), the pattern bank
+set -e
+V10="$(cd "$1" && pwd)"
+OUT="${2:-$(cd "$(dirname "$0")" && pwd)/vizz10_unit.json}"
+[ -f "$V10/build/gen/felucca_tables.h" ] || { echo "vizz10_fixture: $V10: no build/gen (./build.sh there first)"; exit 1; }
+grep -q '"FM-1_800"' "$V10/firmware/src/felucca.c" || { echo "vizz10_fixture: $V10 is not Vizz 1.0"; exit 1; }
+T="$V10/tests"
+CC="${CC:-cc} -O1 -w -I$V10/build/gen -I$V10/firmware/src"
+
+# INFO: editor_test.c's harness (the editor and its USB framing) with Vizz 1.0's version string
+sed -e 's/^#define FELUCCA_VERSION "TEST"/#define FELUCCA_VERSION "v1.0"/' -e 's/^int main(void)/static int et_main(void)/' \
+    "$T/editor_test.c" > "$T/vizz10_info.c"
+cat >> "$T/vizz10_info.c" <<'EOF'
+int main(void)                                   /* (vizz10_fixture.sh) the INFO reply, as the USB wire has it */
+{
+    uint32_t i, n;
+    (void)et_main;
+    reset();
+    n = request(ED_INFO, 0, 0);
+    printf("[");
+    for (i = 0; i < n; i++)
+        printf("%s%u", i ? "," : "", host_wire[i]);
+    printf("]");
+    return 0;
+}
+EOF
+
+# the archive: backup_test.c's harness (the flash, its objects) and a unit set up as a Vizz 1.0 user's
+sed -n '1,63p' "$T/backup_test.c" > "$T/vizz10_unit.c"
+sed -n '95,100p;101,101p;147,183p' "$T/backup_test.c" >> "$T/vizz10_unit.c"
+cat >> "$T/vizz10_unit.c" <<'EOF'
+static void reset(void)                          /* (backup_test.c's) */
+{
+    memset(nor, 0xFF, sizeof nor);
+    memset(&song, 0, sizeof song);
+    memset(trk, 0, sizeof trk);
+    memset(proj_slot, 0, sizeof proj_slot);
+    memset(up_bank, 0, sizeof up_bank);
+    memset(&persist_saved, 0, sizeof persist_saved);
+    memset(&settings, 0, sizeof settings);
+    memset(&ui, 0, sizeof ui);
+    panel = PANEL_DEFAULT;
+    settings_init();
+    host_tracks_init();
+    fm1_ms = 0;
+    transport_req = 0;
+    usb.resets = 0;
+    ed_bk_valid = ed_bk_put = 0;
+    bank_boot();
+    lists_clear();
+    motion_lost = 0;
+}
+static void b64(const uint8_t *p, uint32_t n)
+{
+    static const char T64[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    uint32_t i;
+    for (i = 0; i < n; i += 3u) {
+        uint32_t v = (uint32_t)p[i] << 16 | (i + 1u < n ? (uint32_t)p[i + 1u] << 8 : 0u) | (i + 2u < n ? p[i + 2u] : 0u);
+        putchar(T64[v >> 18 & 63u]);
+        putchar(T64[v >> 12 & 63u]);
+        putchar(i + 1u < n ? T64[v >> 6 & 63u] : '=');
+        putchar(i + 2u < n ? T64[v & 63u] : '=');
+    }
+}
+int main(void)
+{
+    static uint8_t obj[3840];
+    uint32_t i, k, id, len, crc, n;
+    uint8_t ids[64];
+    reset();
+    /* the music: T1 a bassline (an accent, a slide), T2 a chord held two steps (a TIE), T3 drums */
+    for (i = 0; i < 16u; i += 2u)
+        trk[0].step[i] = (step_t){{(uint8_t)(36u + (i & 4u))}, 1, ST_NOTE, i == 4u ? SF_ACCENT : i == 10u ? SF_SLIDE : 0u, 100};
+    trk[1].step[0] = (step_t){{60, 64, 67}, 3, ST_NOTE, 0, 90};
+    trk[1].step[1] = (step_t){{0}, 0, ST_TIE, 0, 0};
+    trk[2].step[0] = (step_t){{0}, 0, ST_NOTE, 0, 100};
+    trk[2].step[0].hit = 1u;
+    trk[2].step[4].hit = 2u;
+    trk[2].step[4].time = ST_NOTE;
+    /* the settings: Skiff's mark (1.4's bank.c set it once it freed its old scenes), MENU > MIDI > SEQ MIDI OUT OFF (Vizz
+     * 1.0: bit 3 of CPU2_BYTE), T2 CHANNEL 10 */
+    favorites.factory[15][24] = 0xA5u;
+    CPU2_BYTE |= 8u;
+    ui_mch(1) = 8u;
+    settings_save();
+    if (project_save_as(0, "VIZZ 1.0"))          /* slot 1, as Vizz 1.0 saves (SKF3) */
+        return 1;
+    project_capture(&proj_scratch);              /* slot 3: an older Skiff's, kept by 1.4 as it was (SKF2: as 1.4
+                                                  * writes an old record again, project.c proj_pack2) */
+    memcpy(proj_scratch.name, "OLD SKIFF   ", PROJ_NAME_LEN);
+    if (!proj_pack2(&proj_wire, &proj_scratch, &PROJ_SKF2) || st_save(OBJ_PROJECT0 + 2u, &proj_wire, PROJ_SKF2.size))
+        return 1;
+    memcpy(&proj_slot[2], &proj_wire, sizeof proj_wire);
+    if (up_store(0, "VIZZ BASS"))                /* a user sound: T1's (version 5) */
+        return 1;
+    call(ED_BACKUP_LIST, 0, 0);                  /* the backup, as web/fm1backup.js captureBackup takes it */
+    if (rep[1])
+        return 1;
+    n = rep[2];
+    for (i = 0; i < n; i++)
+        ids[i] = rep[3 + i * 11u];
+    printf("{\"format\":\"felucca-backup\",\"version\":1,\"firmware\":\"FELUCCA v1.0\","
+           "\"created\":\"2026-10-25T12:00:00.000Z\",\"objects\":[");
+    for (k = 0; k < n; k++) {
+        id = ids[k];
+        if (list(id, &len, &crc) || (len && get_all(id, obj, len)) || (len && st_crc32(obj, len) != crc))
+            return 1;
+        printf("%s{\"id\":%u,\"size\":%u,\"crc\":%u,\"data\":\"", k ? "," : "", id, len, len ? crc : 0u);
+        b64(obj, len);
+        printf("\"}");
+    }
+    printf("]}");
+    return 0;
+}
+EOF
+B="${TMPDIR:-/tmp}/vizz10_fixture.$$"
+mkdir -p "$B"
+$CC -o "$B/info" "$T/vizz10_info.c" -lm
+$CC -o "$B/unit" "$T/vizz10_unit.c" -lm
+{
+    printf '{"what":"a unit running Vizz 1.0 (tests/vizz10_fixture.sh: Vizz 1.0'"'"'s own code)","identity":"FM-1_810","port":"FM-1",\n"info":'
+    (cd "$B" && ./info)
+    printf ',\n"archive":'
+    (cd "$B" && ./unit)
+    printf '}\n'
+} > "$OUT"
+rm -rf "$B" "$T/vizz10_info.c" "$T/vizz10_unit.c"
+echo "vizz10_fixture: $OUT ($(wc -c < "$OUT" | tr -d ' ') B)"
