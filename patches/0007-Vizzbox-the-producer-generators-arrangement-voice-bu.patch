diff --git a/firmware/src/ui_vizzbox.c b/firmware/src/ui_vizzbox.c
new file mode 100644
index 0000000..5121e9c
--- /dev/null
+++ b/firmware/src/ui_vizzbox.c
@@ -0,0 +1,99 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox) The VIZZBOX screen and its controls (BRIEF-VIZZBOX.md 2): the producer's knobs and keys, the favourites,
+ * the switch to the GROOVEBOX (Skiff's whole interface) and back. Included by felucca.c after producer.c */
+
+/* the mode: 1 VIZZBOX (its screen, its controls), 0 GROOVEBOX. Kept in the settings (CPU2_BYTE bit 4: set, the
+ * GROOVEBOX was last), so a unit starts where it was left; a new one in the VIZZBOX */
+#define VB_MODE_BIT 16u
+static void vb_mode_boot(void)
+{
+    vb_mode = !(CPU2_BYTE & VB_MODE_BIT);
+    vb.k.energy = 70;                               /* (the knobs at power-on: a lively song, some variation) */
+    vb.k.var = 40;
+    vb.k.len = VL_NORMAL;
+    vb.k.seed = 0x5EEDu;
+}
+static void vb_mode_set(uint32_t m)
+{
+    if (vb_mode == m)
+        return;
+    vb_mode = (uint8_t)m;
+    CPU2_BYTE = (uint8_t)(m ? CPU2_BYTE & ~VB_MODE_BIT : CPU2_BYTE | VB_MODE_BIT);
+    settings_save();
+    if (!m && !song.playing)
+        vb_give();                                  /* (the GROOVEBOX's music back) */
+    ui.force = 1;
+    lcd_fill(0, 0, 240, 240, T_BG);
+}
+
+/* the knobs' song: GENRE, SUBGENRE, ENERGY, VARIATION; while playing they come in at the next section */
+static void vb_knob(uint32_t k, int32_t s)
+{
+    vb_song_t *w = &vb.k;
+    if (k == 0u) {
+        w->genre = (uint8_t)clamp((int32_t)w->genre + (s > 0 ? 1 : -1), 0, 9);
+        w->sub = 0;
+    } else if (k == 1u)
+        w->sub = (uint8_t)clamp((int32_t)w->sub + (s > 0 ? 1 : -1), 0, VB_NSUB[w->genre % 10u] - 1);
+    else if (k == 2u)
+        w->energy = (uint8_t)clamp((int32_t)w->energy + s, 0, 100);
+    else
+        w->var = (uint8_t)clamp((int32_t)w->var + s, 0, 100);
+    if (k < 2u)
+        w->bpm = 0;                                 /* (the new style's own tempo) */
+    if (vb.own && song.playing)
+        vb.chg = 1;
+    ui.force = 1;
+}
+
+/* each pass in the VIZZBOX (ui_input): the buttons, the knobs, the keys */
+static void vb_input(uint32_t pressed, uint32_t notes)
+{
+    uint32_t b, id;
+    int32_t s;
+    (void)notes;
+    for (id = 0; id < FM1_NBTN; id++) {
+        if (!((pressed >> id) & 1u))
+            continue;
+        b = panel_btn_of(id);
+        if (b == B_PLAY) {
+            if (((fm1_in.buttons >> panel.btn[B_HOME]) & 1u)) {
+                vb_mode_set(0);
+                continue;
+            }
+            if (song.playing)
+                transport_req = 2;
+            else
+                (void)vb_start();
+        } else if (b == B_REC) {
+            vb.k.seed = (uint16_t)(vb_hash(vb.k.seed + fm1_ms) & 0xFFFFu);
+        } else if (b == B_FX && vb.own && song.playing)
+            vb.req |= VQ_DROP;
+        else if (b == B_ARP && vb.own && song.playing)
+            vb.req |= VQ_BREAK;
+        else if (b == B_SEQ)
+            vb.req ^= VQ_HOLD;
+    }
+    for (id = 0; id < 4u; id++)
+        if ((s = panel_enc(EN_K1 + id)) != 0)
+            vb_knob(id, s);
+    if ((s = panel_enc(EN_SELECT)) != 0) {
+        vb.k.bpm = (uint8_t)clamp((vb.k.bpm ? vb.k.bpm : (int32_t)vb.bpm) + s, 40, 240);
+        ui.force = 1;
+    }
+}
+
+/* the screen (a first one: the names and the section) */
+static void vb_draw(void)
+{
+    char b[32];
+    if (!ui.force && (ui.frame & 7u))
+        return;
+    ui.force = 0;
+    cv_begin(240, 120, T_BG);
+    cv_text(8, 8, &AF_M, VB_GNAME[vb.k.genre % 10u], T_TEXT);
+    cv_text(8, 30, &AF_M, VB_SNAME[(vb_sub0(vb.k.genre) + vb.k.sub) % 36u], T_THEME);
+    str_cpy(b, "BPM ", sizeof b);
+    cv_text(8, 60, &AF_S, b, T_MID);
+    cv_blit(0, 0);
+}
