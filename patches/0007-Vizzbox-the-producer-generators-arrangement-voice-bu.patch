diff --git a/firmware/src/producer.c b/firmware/src/producer.c
new file mode 100644
index 0000000..7afcbf2
--- /dev/null
+++ b/firmware/src/producer.c
@@ -0,0 +1,1385 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox) The producer (BRIEF-VIZZBOX.md 3): it makes a whole track from a genre, a subgenre and a seed and plays it
+ * on Skiff's six tracks, as someone at the groovebox would: patterns into the sequencer, sounds onto the tracks, the
+ * arrangement, the transitions with the FX layer and the filters. No sound of its own.
+ *   T1 DRUMS (DRUM or DRUM-X)  T2 BASS  T3 CHORDS  T4 LEAD  T5 ARP (or a break on SLICE)  T6 FX (risers, impacts)
+ * Each track plays a pattern of 16 steps at 1/16. One bar ahead, in the main loop (vb_poll, from ui_input), the next
+ * bar of every track goes into Skiff's launch queue (launch.c launch_q, LOOP: the audio ISR swaps it in on the bar line,
+ * a note going on across it), what else the bar does into vb_ctl (producer_isr.c applies it on its steps). So what
+ * plays is what the sequencer plays (SEQ MIDI OUT, CC 102 and CC 103 as for any pattern), and when the main loop ran
+ * does not change a sample: the same song is the same, bit for bit.
+ * A song is (genre, subgenre, seed, energy, variation, tempo, length) and the live moves in their order. Each part of
+ * it draws from a stream of its own (vb_stream: the seed, the role, the section, the bar), so a change in one place
+ * leaves the rest as it was.
+ * The arrangement switches a track off with empty steps, never with its MUTE: MUTE and SOLO stay the user's (and CC 103
+ * says only them). The user's music: before the producer first takes the tracks, Skiff keeps the patterns the tracks
+ * changed (bank.c keep_all, as the autosave would) and the music as a project in RAM (vb_keep); while the producer has
+ * the tracks neither the autosave nor the pattern pool writes anything (vb_owns); back in the GROOVEBOX, stopped, that
+ * music comes back. Stopped in the GROOVEBOX with the producer's song in the tracks, it is the GROOVEBOX's from then on
+ * (the brief's "Song übernehmen"). */
+#include "producer_tables.c"
+
+enum { VS_INTRO = 1, VS_GROOVE, VS_BUILD, VS_DROP, VS_BREAK, VS_OUTRO };   /* CC 104's values */
+enum { VL_SHORT, VL_NORMAL, VL_ENDLESS };
+#define VB_PLAN 16u
+typedef struct { uint8_t genre, sub, energy, var, len, bpm; uint16_t seed; } vb_song_t;   /* a favourite */
+typedef struct { uint8_t type, bars, e0, e1; } vb_sec_t;   /* a section: VS_*, its bars, its energy at its start, end */
+static struct {
+    vb_song_t k;                     /* the knobs */
+    vb_song_t s;                     /* the song playing (the knobs at PLAY; then at a section a change came for) */
+    uint8_t own;                     /* the tracks hold the producer's song */
+    uint8_t kept;                    /* the GROOVEBOX's music is in vb_keep */
+    uint8_t ri;                      /* the subgenre playing (VB_SUB) */
+    uint8_t root, scale;             /* the key: 0..11, SCALE_MASK */
+    uint8_t prog[4], cbars;          /* the progression: its degrees; bars a chord */
+    uint8_t mot[2][16], mbars;       /* the lead's motif: a step's degree + 8 (0 none), bit 6 a tie; one or two bars */
+    uint8_t snd[NTRK];               /* each role's sound (VB_SND) */
+    vb_sec_t plan[VB_PLAN];
+    uint8_t nplan, sec, sbar;        /* sections planned; the staged bar's section and bar in it */
+    uint8_t occ;                     /* how many sections of its type came before the staged one */
+    uint16_t nsec;                   /* sections since PLAY */
+    uint32_t bar;                    /* the bar staged last (from PLAY) */
+    uint8_t staged;                  /* bar is staged (or, stopped, in the tracks) */
+    uint8_t act;                     /* the roles playing in the bar staged last (bit per track) */
+    uint8_t req;                     /* live: VQ_* */
+    uint8_t chg;                     /* the knobs changed while playing: the next section takes them */
+    uint8_t tape;                    /* TAPE STOP used */
+    uint8_t bpm;                     /* the tempo of the bar staged last */
+    uint8_t bpm_to;                  /* .. gliding to (ENDLESS, a new style) */
+    uint16_t sub_bars;               /* ENDLESS: bars since the subgenre came in */
+    uint8_t cprev[4], cn;            /* the chord voiced last (voice leading) */
+} vb __attribute__((section(".pool")));
+#define VQ_DROP 1u
+#define VQ_BREAK 2u
+#define VQ_HOLD 4u
+
+/* ---------------------------------------------------------- streams --- */
+/* each part of the song draws from its own stream: the seed, then what (role, section, bar) */
+static uint32_t vb_r __attribute__((section(".pool")));
+static uint32_t vb_hash(uint32_t x)
+{
+    x ^= x >> 16;
+    x *= 0x7FEB352Du;
+    x ^= x >> 15;
+    x *= 0x846CA68Bu;
+    return x ^ (x >> 16);
+}
+static void vb_stream(uint32_t what, uint32_t a, uint32_t b)
+{
+    vb_r = vb_hash((uint32_t)vb.s.seed * 0x9E3779B1u ^ vb_hash(what << 24 ^ a << 12 ^ b)) | 1u;
+}
+static uint32_t vb_rnd(void)
+{
+    vb_r ^= vb_r << 13;
+    vb_r ^= vb_r >> 17;
+    vb_r ^= vb_r << 5;
+    return vb_r;
+}
+static uint32_t vb_below(uint32_t n) { return ((vb_rnd() >> 16) * n) >> 16; }
+static int vb_pct(uint32_t p) { return vb_below(100u) < p; }
+enum { VR_SONG = 1, VR_DRUM, VR_BASS, VR_CHORD, VR_LEAD, VR_ARP, VR_FX, VR_PLAN, VR_HUM };
+
+/* ------------------------------------------------------------ the key --- */
+static uint32_t vb_nscale(void)
+{
+    uint32_t m = SCALE_MASK[vb.scale], n = 0;
+    for (; m; m &= m - 1u)
+        n++;
+    return n;
+}
+/* scale degree d (any, 0 the root) -> semitones above the key's root */
+static int32_t vb_semi(int32_t d)
+{
+    uint32_t m = SCALE_MASK[vb.scale], i;
+    int32_t n = (int32_t)vb_nscale(), o = 0;
+    while (d < 0) {
+        d += n;
+        o -= 12;
+    }
+    o += 12 * (d / n);
+    d %= n;
+    for (i = 0; i < 12u; i++)
+        if ((m >> i) & 1u) {
+            if (!d)
+                break;
+            d--;
+        }
+    return o + (int32_t)i;
+}
+/* the note of degree d in the octave whose C is c (the key's root above it) */
+static uint32_t vb_note(int32_t d, int32_t c) { return (uint32_t)clamp(c + (int32_t)vb.root + vb_semi(d), 0, 127); }
+static uint32_t vb_chord(void)                      /* the staged bar's chord: its degree */
+{
+    return vb.prog[(vb.sbar / vb.cbars) & 3u];
+}
+
+/* ---------------------------------------------------------- writing --- */
+static step_t *vb_o __attribute__((section(".pool")));                                /* the bar being written: 16 steps */
+static void vb_clear(void)
+{
+    uint32_t i;
+    for (i = 0; i < 16u; i++)
+        step_clear(&vb_o[i]);
+}
+static uint32_t vb_hum(uint32_t v)                  /* a velocity, a little human */
+{
+    int32_t x = (int32_t)v + (int32_t)vb_below(11u) - 5;
+    return (uint32_t)clamp(x, 1, 127);
+}
+static void vb_put(uint32_t i, uint32_t note, uint32_t vel)   /* a note into step i (up to four: a chord) */
+{
+    step_t *s = &vb_o[i & 15u];
+    if (s->time != ST_NOTE) {
+        s->time = ST_NOTE;
+        s->n = 0;
+    }
+    if (s->n < 4u)
+        s->note[s->n++] = (uint8_t)note;
+    s->vel = (uint8_t)(vel > s->vel ? vel : s->vel);
+}
+static void vb_hold(uint32_t from, uint32_t to)     /* steps from .. to - 1 TIEs (the note before goes on) */
+{
+    for (; from < to && from < 16u; from++)
+        if (vb_o[from].time != ST_NOTE)
+            vb_o[from].time = ST_TIE;
+}
+static void vb_hit(uint32_t i, uint32_t lane, uint32_t vel)
+{
+    step_t *s = &vb_o[i & 15u];
+    s->time = ST_NOTE;
+    s->hit |= (uint8_t)(1u << lane);
+    s->vel = (uint8_t)(vel > s->vel ? vel : s->vel);
+}
+
+/* -------------------------------------------------------- the song --- */
+static const vb_sub_t *vb_sub(void) { return &VB_SUB[vb.ri % 36u]; }
+static uint32_t vb_tempo(void)                      /* the subgenre's tempo for this seed, or the knob's */
+{
+    const vb_sub_t *u = vb_sub();
+    return vb.s.bpm ? vb.s.bpm : u->bpm0 + (vb_hash(vb.s.seed ^ 0x51u) % (uint32_t)(u->bpm1 - u->bpm0 + 1u));
+}
+/* the forms for LENGTH NORMAL (BRIEF 3.5): a section a byte, its type << 4 | its bars / 4 - 1 */
+#define VB_FS(t, b) ((uint8_t)((t) << 4 | ((b) / 4 - 1)))
+static const uint8_t VB_FORM[7][8] = {
+    {VB_FS(1, 16), VB_FS(2, 16), VB_FS(3, 8), VB_FS(4, 32), VB_FS(5, 16), VB_FS(3, 16), VB_FS(4, 32), VB_FS(6, 16)},   /* D */
+    {VB_FS(1, 32), VB_FS(2, 32), VB_FS(3, 16), VB_FS(4, 32), VB_FS(5, 8), VB_FS(4, 32), VB_FS(6, 32), 0},          /* T */
+    {VB_FS(1, 32), VB_FS(3, 8), VB_FS(4, 32), VB_FS(5, 16), VB_FS(3, 8), VB_FS(4, 32), VB_FS(6, 16), 0},            /* N */
+    {VB_FS(1, 16), VB_FS(3, 8), VB_FS(4, 16), VB_FS(5, 16), VB_FS(3, 8), VB_FS(4, 16), VB_FS(6, 8), 0},             /* S */
+    {VB_FS(1, 4), VB_FS(2, 16), VB_FS(4, 8), VB_FS(2, 16), VB_FS(4, 8), VB_FS(5, 8), VB_FS(4, 8), VB_FS(6, 4)},        /* V */
+    {VB_FS(1, 16), VB_FS(2, 32), VB_FS(5, 32), VB_FS(2, 32), VB_FS(6, 16), 0, 0, 0},                         /* A */
+    {VB_FS(1, 16), VB_FS(3, 16), VB_FS(4, 32), VB_FS(5, 32), VB_FS(3, 16), VB_FS(4, 32), VB_FS(6, 16), 0},          /* H */
+};
+/* a section type's energy, its start and end (0..100, before ENERGY) */
+static const uint8_t VB_SECE[7][2] = {{0, 0}, {15, 45}, {50, 60}, {50, 90}, {92, 97}, {30, 35}, {45, 10}};
+static void vb_sec_put(uint32_t i, uint32_t type, uint32_t bars)
+{
+    if (i >= VB_PLAN)
+        return;
+    vb.plan[i].type = (uint8_t)type;
+    vb.plan[i].bars = (uint8_t)bars;
+    vb.plan[i].e0 = VB_SECE[type][0];
+    vb.plan[i].e1 = VB_SECE[type][1];
+    if (vb_sub()->form == FO_A && type != VS_INTRO && type != VS_OUTRO) {   /* ambient: no hard changes */
+        vb.plan[i].e0 = type == VS_BREAK ? 25 : 40;
+        vb.plan[i].e1 = type == VS_BREAK ? 30 : 50;
+    }
+}
+static uint32_t vb_bars_ms(uint32_t bars) { return bars * 240000u / vb_tempo(); }
+/* the plan: the form, NORMAL ~4.25 min at least (its middle again), SHORT about half of it; ENDLESS: without the
+ * outro, more comes as it plays (vb_more) */
+static void vb_plan(void)
+{
+    const uint8_t *f = VB_FORM[vb_sub()->form % 7u];
+    uint32_t n = 0, i, total = 0, mid0 = 0, mid1 = 0, rep;
+    for (i = 0; i < 8u && f[i]; i++) {
+        uint32_t t = f[i] >> 4, b = 4u * ((f[i] & 15u) + 1u);
+        if (vb.s.len == VL_SHORT && t != VS_BUILD)
+            b = b >= 16u ? b / 2u : b;
+        if (vb.s.len == VL_ENDLESS && t == VS_OUTRO)
+            break;
+        vb_sec_put(n++, t, b);
+        total += b;
+    }
+    /* the middle: from the first section after the first DROP to the last DROP */
+    for (i = 0; i < n && vb.plan[i].type != VS_DROP; i++)
+        ;
+    mid0 = i + 1u;
+    for (mid1 = n; mid1 > mid0 && vb.plan[mid1 - 1u].type != VS_DROP; mid1--)
+        ;
+    for (rep = 0; vb.s.len == VL_NORMAL && rep < 4u && vb_bars_ms(total) < 255000u && mid1 > mid0 &&
+                  n + (mid1 - mid0) <= VB_PLAN; rep++) {
+        uint32_t m = mid1 - mid0, j;
+        for (j = n; j-- > mid1;)                    /* (the outro and what follows the middle move on) */
+            vb.plan[j + m] = vb.plan[j];
+        for (j = 0; j < m; j++) {
+            vb.plan[mid1 + j] = vb.plan[mid0 + j];
+            total += vb.plan[mid0 + j].bars;
+        }
+        n += m;
+        mid0 = mid1;
+        mid1 += m;
+    }
+    vb.nplan = (uint8_t)n;
+}
+/* ENDLESS: the next cycle when the plan runs out: GROOVE or BREAK, BUILD, DROP; the played sections leave */
+static void vb_more(void)
+{
+    uint32_t i, k = vb.sec, n = vb.nplan - k;
+    vb_stream(VR_PLAN, vb.nsec, 0);
+    for (i = 0; i < n; i++)
+        vb.plan[i] = vb.plan[k + i];
+    vb.sec = 0;
+    vb_sec_put(n++, vb_pct(50) ? VS_BREAK : VS_GROOVE, vb_pct(50) ? 16u : 8u);
+    vb_sec_put(n++, VS_BUILD, vb_pct(50) ? 16u : 8u);
+    vb_sec_put(n++, VS_DROP, vb_pct(40) ? 16u : 32u);
+    vb.nplan = (uint8_t)n;
+}
+
+/* the lead's motif (BRIEF 3.3): one or two bars, drawn once a song; it comes back all through the song. A rhythm cell
+ * of the style, its notes a walk on the scale, chord tones on the strong steps (vb_lead puts them right on the chord
+ * that sounds) */
+static void vb_motif(void)
+{
+    const vb_sub_t *u = vb_sub();
+    uint32_t b, i, on, n;
+    int32_t d = 0;
+    vb_stream(VR_LEAD, 0, 0);
+    vb.mbars = (uint8_t)(u->lead == LS_RIFF || u->lead == LS_ACID || u->lead == LS_BLIP || u->lead == LS_STAB ||
+                         vb_pct(40) ? 1u : 2u);
+    memset(vb.mot, 0, sizeof vb.mot);
+    for (b = 0; b < vb.mbars; b++)
+        for (i = 0; i < 16u; i++) {
+            switch (u->lead) {
+            case LS_RIFF:
+            case LS_ACID:
+                on = vb_pct(i % 4u == 0u ? 85 : i % 2u ? 45 : 60);
+                break;
+            case LS_BLIP:
+                on = vb_pct(18);
+                break;
+            case LS_STAB:
+                on = i % 4u == 2u ? vb_pct(70) : vb_pct(15);
+                break;
+            case LS_SPARSE:
+                on = !i || (i == 8u && vb_pct(60)) || (i % 4u == 3u && vb_pct(20));
+                break;
+            case LS_BIG:
+                on = i % 4u == 0u ? vb_pct(80) : i % 2u ? vb_pct(10) : vb_pct(35);
+                break;
+            default:   /* HOOK */
+                on = i % 4u == 0u ? vb_pct(70) : i % 2u ? vb_pct(30) : vb_pct(55);
+            }
+            if (!i && !b)
+                on = 1;
+            if (!on) {
+                if (vb.mot[b][i ? i - 1u : 0u] && i && vb_pct(u->lead == LS_BIG || u->lead == LS_SPARSE ? 80 : 30))
+                    vb.mot[b][i] = 64u;             /* (the note before goes on) */
+                continue;
+            }
+            n = vb_below(10u);                      /* a step, a skip, a leap; towards the middle */
+            d += n < 4u ? 1 : n < 7u ? -1 : n < 8u ? 2 : n < 9u ? -2 : (d > 2 ? -4 : 4);
+            d = clamp(d, -3, 9);
+            if (i % 4u == 0u && d % 2)              /* (strong steps: a chord tone of the tonic, near) */
+                d += d > 3 ? -1 : 1;
+            vb.mot[b][i] = (uint8_t)(d + 8);
+            if (u->lead == LS_ACID && vb_pct(25))
+                vb.mot[b][i] |= 128u;               /* (a slide on, acid) */
+        }
+}
+
+/* the song from vb.s: its subgenre, key, tempo, progression, sounds, motif and plan (nothing in the tracks yet) */
+static void vb_song(void)
+{
+    const vb_sub_t *u;
+    uint32_t i, j;
+    vb.ri = (uint8_t)((vb_sub0(vb.s.genre) + vb.s.sub) % 36u);
+    u = vb_sub();
+    vb_stream(VR_SONG, vb.ri, 0);                   /* (the seed and the subgenre: the key, the sounds) */
+    vb.root = (uint8_t)vb_below(12u);
+    vb.scale = VB_SCALES[u->scale][vb_below(2u)];
+    i = vb_pct(50) ? u->prog0 : u->prog1;
+    for (j = 0; j < 4u; j++)
+        vb.prog[j] = (uint8_t)((VB_PROG[i % NELEM(VB_PROG)] >> (4u * j)) & 15u);
+    vb.cbars = u->cbars;
+    {   /* the sounds: one of each role's candidates */
+        static const uint8_t *const L[1] = {0};
+        const uint8_t li[NTRK] = {u->kit, u->blist, u->clist, u->llist, u->alist, u->flist};
+        (void)L;
+        for (j = 0; j < NTRK; j++) {
+            const uint8_t *c = VB_LIST[li[j] % NELEM(VB_LIST)];
+            uint32_t n = 0;
+            while (n < 4u && c[n] != 0xFFu)
+                n++;
+            vb.snd[j] = c[n ? vb_below(n) : 0u];
+        }
+    }
+    vb.bpm = vb.bpm_to = (uint8_t)vb_tempo();
+    vb_motif();
+    vb_plan();
+    vb.cn = 0;
+}
+
+/* --------------------------------------------------- the arrangement --- */
+static const vb_sec_t *vb_cur(void) { return &vb.plan[vb.sec % VB_PLAN]; }
+static uint32_t vb_left(void) { return vb_cur()->bars - vb.sbar; }   /* bars left in the section, this one counted */
+/* the staged bar's energy, 0..100: the section's line, a later DROP a little more, scaled by ENERGY (at 0 about a
+ * third: gentle; at 100 the whole) */
+static uint32_t vb_energy(void)
+{
+    const vb_sec_t *c = vb_cur();
+    int32_t e = c->e0 + (c->e1 - c->e0) * (int32_t)vb.sbar / (c->bars ? c->bars : 1);
+    if (c->type == VS_DROP && vb.occ)
+        e += 3;
+    return (uint32_t)clamp(e, 0, 100) * (35u + 65u * vb.s.energy / 100u) / 100u;
+}
+/* a role is "dense" (BRIEF 3.3: at most two at once): a 16th arp, a riff or acid lead, gated or plucked chords, an acid
+ * or riff bass */
+static uint32_t vb_dense(uint32_t m)
+{
+    const vb_sub_t *u = vb_sub();
+    uint32_t d = 0;
+    if ((m >> R_A) & 1u && (u->arp & 0x7Fu) != AR_LOOP && !(u->arp & 0x80u))
+        d |= 1u << R_A;
+    if ((m >> R_L) & 1u && (u->lead == LS_RIFF || u->lead == LS_ACID || u->lead == LS_HOOK))
+        d |= 1u << R_L;
+    if ((m >> R_C) & 1u && (u->chords == CR_GATE || u->chords == CR_PLUCK || u->chords == CR_PIANO))
+        d |= 1u << R_C;
+    if ((m >> R_B) & 1u && (u->bass == BS_ACID || u->bass == BS_RIFF))
+        d |= 1u << R_B;
+    return d;
+}
+static uint32_t vb_count(uint32_t m)
+{
+    uint32_t n = 0;
+    for (; m; m &= m - 1u)
+        n++;
+    return n;
+}
+/* the roles playing in the staged bar (a bit per track) */
+static uint32_t vb_roles(uint32_t e)
+{
+    const vb_sub_t *u = vb_sub();
+    const vb_sec_t *c = vb_cur();
+    uint32_t m = 0, have = 0x3Fu, k, i;
+    if (u->bass == BS_NONE)
+        have &= ~(1u << R_B);
+    if (u->chords == CR_NONE)
+        have &= ~(1u << R_C);
+    if (u->lead == LS_NONE)
+        have &= ~(1u << R_L);
+    if ((u->arp & 0x7Fu) == AR_NONE)
+        have &= ~(1u << R_A);
+    switch (c->type) {
+    case VS_INTRO:
+    case VS_OUTRO:                                  /* a role every 8 bars in (out: the other way) */
+        k = c->type == VS_INTRO ? 1u + vb.sbar / 8u : 4u - (vb.sbar * 4u / c->bars);
+        for (i = 0; i < 4u && i < k; i++)
+            m |= 1u << ((u->intro >> (4u * i)) & 7u);
+        break;
+    case VS_GROOVE:
+        m = 1u << R_D | 1u << R_B | 1u << R_C;
+        if (e >= 55u || u->lead == LS_SPARSE || u->lead == LS_BLIP || u->lead == LS_STAB)
+            m |= 1u << R_L;
+        if (e >= 55u)
+            m |= 1u << R_A;
+        break;
+    case VS_BUILD:
+        m = 1u << R_D | 1u << R_C | 1u << R_F;
+        if (vb.sbar < c->bars / 2u || c->bars <= 4u)
+            m |= 1u << R_B;
+        if (vb.sbar >= c->bars / 2u)
+            m |= 1u << R_L;
+        if (e >= 60u)
+            m |= 1u << R_A;
+        break;
+    case VS_DROP:
+        m = 0x1Fu | (vb.sbar < 2u ? 1u << R_F : 0u);
+        break;
+    default:                                        /* BREAK: the chords, the melody where the form has one */
+        m = 1u << R_C | 1u << R_F;
+        if (u->form == FO_H || u->lead == LS_BIG || u->lead == LS_SPARSE || (have & ~(1u << R_C) & 1u << R_L && e > 30u))
+            m |= 1u << R_L;
+        if (u->form == FO_A)
+            m |= 1u << R_A | (u->grid == G_AMBIENT ? 0u : 0u);
+        break;
+    }
+    m &= have;
+    if (!(m & have & ~(1u << R_F)) && (have & 1u << R_C))
+        m |= 1u << R_C;                             /* (never only the FX) */
+    while (vb_count(vb_dense(m)) > 2u)              /* at most two dense melodic roles: the arp goes first */
+        m &= ~((vb_dense(m) >> R_A) & 1u ? 1u << R_A : 1u << R_C);
+    return m;
+}
+
+/* ------------------------------------------------------- the drums --- */
+enum { LN_KICK, LN_SNARE, LN_CLAP, LN_HATC, LN_HATO, LN_TOM, LN_RIM, LN_BELL };
+/* T1: the raster at the bar's energy (anchors always, the rest from medium / high energy on), the hats' accents, a fill
+ * at the end of an 8-bar phrase, the build's roll (1/4 1/8 1/16 1/32 over its last four bars, louder), the kick out at
+ * its end, a beat of silence before the drop, the drop's crash; trap's hat rolls */
+static void vb_drums(uint32_t e)
+{
+    const vb_sub_t *u = vb_sub();
+    const vb_sec_t *c = vb_cur();
+    const uint32_t *g = VB_GRID[u->grid % G_N];
+    uint32_t i, l, lanes = 0xFFu, left = vb_left(), roll = 0, fill = 0, v, vel;
+    vb_stream(VR_DRUM, vb.nsec, vb.sbar);
+    if ((c->type == VS_INTRO || c->type == VS_OUTRO) && (u->form == FO_N || u->form == FO_S || u->form == FO_A))
+        lanes &= ~(1u << LN_KICK | 1u << LN_SNARE | 1u << LN_CLAP);   /* (no full kit in DnB's, dubstep's intro) */
+    if (c->type == VS_BUILD) {
+        roll = left <= 4u ? 5u - left : 0u;
+        if (u->form == FO_T)                         /* techno: the tension on hats and percussion */
+            lanes &= ~(1u << LN_KICK | 1u << LN_CLAP);
+        if (((u->flags & VF_KO2) && left <= 2u) || ((u->flags & VF_KO1) && left == 1u))
+            lanes &= ~(1u << LN_KICK);
+    }
+    fill = c->type != VS_BUILD && (vb.sbar % 8u == 7u || left == 1u) && vb_pct(35u + vb.s.var / 2u);
+    for (i = 0; i < 16u; i++)
+        for (l = 0; l < NLANE; l++) {
+            v = (g[l] >> (2u * i)) & 3u;
+            if (!v || !((lanes >> l) & 1u) || (v == 2u && e < 35u) || (v == 1u && (e < 65u || !vb_pct(40u + e / 3u))))
+                continue;
+            if (fill && i >= 12u && (l == LN_SNARE || l == LN_TOM || l == LN_CLAP))
+                continue;
+            vel = v == 3u ? 112u : v == 2u ? 92u : 62u;
+            if (l == LN_HATC || l == LN_HATO)
+                vel -= i & 1u ? 22u : i & 2u ? 10u : 0u;
+            vb_hit(i, l, vb_hum(vel * (70u + e * 3u / 10u) / 100u));
+        }
+    if (fill) {                                     /* a fill over the last beat: snare, toms, or both */
+        uint32_t kind = vb_below(3u);
+        for (i = 12u; i < 16u; i++) {
+            if (kind != 1u && (i != 13u || vb_pct(60)))
+                vb_hit(i, LN_SNARE, vb_hum(70u + 10u * (i - 12u)));
+            if (kind != 0u && (i == 12u || i == 14u || i == 15u))
+                vb_hit(i, LN_TOM, vb_hum(84u + 6u * (i - 12u)));
+        }
+        if (e >= 70u && vb_pct(50))
+            step_set_ratchet(&vb_o[15], 2u);
+    }
+    if (roll) {                                     /* the build's roll, louder bar by bar */
+        uint32_t every = roll == 1u ? 4u : roll == 2u ? 2u : 1u;
+        for (i = 0; i < 16u; i += every) {
+            vb_hit(i, LN_SNARE, vb_hum(64u + 12u * roll + i * 2u));
+            if (roll == 4u && !((vb_o[i].hit >> LN_KICK) & 1u))
+                step_set_ratchet(&vb_o[i], 2u);
+        }
+    }
+    if (c->type == VS_BUILD && left == 1u && (u->flags & VF_SIL))
+        for (i = 12u; i < 16u; i++)                 /* a beat of silence before the drop */
+            step_clear(&vb_o[i]);
+    if (c->type == VS_DROP && !vb.sbar) {           /* the drop's one: the crash (the open hat, accented), the kick */
+        vb_hit(0, LN_HATO, 120u);
+        vb_o[0].acc |= (uint8_t)(1u << LN_HATO | ((lanes & 1u) ? 1u << LN_KICK : 0u));
+        if (lanes & 1u)
+            vb_hit(0, LN_KICK, 120u);
+    }
+    if (u->grid == G_TRAP && e >= 45u)               /* trap: hat rolls (a step's ratchet x2 .. x4) */
+        for (i = 0; i < 2u; i++) {
+            uint32_t s = 2u + 4u * vb_below(4u) + (vb_pct(50) ? 1u : 0u);
+            if (vb_o[s].hit == 1u << LN_HATC || (!vb_o[s].hit && vb_pct(60))) {
+                vb_hit(s, LN_HATC, vb_hum(80u));
+                step_set_ratchet(&vb_o[s], 2u + vb_below(3u));
+            }
+        }
+}
+
+/* --------------------------------------------------------- the bass --- */
+/* the bass note: the chord's root + d degrees, in D1 .. C#2 (26..37), up an octave with up */
+static uint32_t vb_bn(int32_t d, int up)
+{
+    int32_t n = 24 + (int32_t)vb.root + vb_semi((int32_t)vb_chord() + d);
+    while (n < 26)
+        n += 12;
+    while (n > 37)
+        n -= 12;
+    return (uint32_t)(n + (up ? 12 : 0));
+}
+/* a bass note on step i, held to step to (TIEs; to > i + 1), slid into the next (slide) */
+static void vb_bput(uint32_t i, uint32_t note, uint32_t vel, uint32_t to, int slide)
+{
+    vb_put(i, note, vel);
+    vb_hold(i + 1u, to);
+    if (slide)
+        vb_o[(to > i + 1u ? to - 1u : i) & 15u].flags |= SF_SLIDE;
+}
+/* T2 (BRIEF 3.3): the styles. It follows the chord's root; meets the kick only where the style wants it */
+static void vb_bass(uint32_t e)
+{
+    const vb_sub_t *u = vb_sub();
+    const uint32_t kick = VB_GRID[u->grid % G_N][LN_KICK];
+    uint32_t i, n, m, r = vb_bn(0, 0);
+    int32_t d;
+    /* a section's cell stays (the stream of its type and, with VARIATION, its occurrence); the bar moves its notes */
+    vb_stream(VR_BASS, vb_cur()->type, vb.s.var > 50u ? vb.occ : 0u);
+    switch (u->bass) {
+    case BS_ROOT:                                   /* the root, syncopated around the beat */
+        m = e >= 60u ? 0x4849u : 0x0841u;           /* (0 3 6 11 14 / 0 6 11) */
+        for (i = 0; i < 16u; i++)
+            if ((m >> i) & 1u)
+                vb_bput(i, i == 11u && vb_pct(40) ? vb_bn(4, 0) : r, vb_hum(i ? 90u : 104u), i + 2u, 0);
+        break;
+    case BS_OFF:                                    /* the 8ths off the beat (more energy: the 16ths after them) */
+    case BS_HARD:                                   /* hardstyle's reverse bass: long off-beats */
+        for (i = 2u; i < 16u; i += 4u) {
+            vb_bput(i, r, vb_hum(100u), u->bass == BS_HARD ? i + 2u : i + 1u, 0);
+            if (u->bass == BS_OFF && e >= 70u)
+                vb_bput(i + 1u, r, vb_hum(80u), i + 2u, 0);
+        }
+        break;
+    case BS_ROLL:                                   /* rolling 16ths around the kick */
+    case BS_PSY:                                    /* psytrance: three after each kick */
+        for (i = 0; i < 16u; i++) {
+            if ((kick >> (2u * i)) & 3u || (u->bass == BS_ROLL && e < 60u && !(i & 2u)))
+                continue;
+            vb_bput(i, i == 15u && vb_pct(40) ? vb_bn(0, 1) : r, vb_hum(i % 4u == 2u ? 104u : 86u), i + 1u, 0);
+        }
+        break;
+    case BS_ACID:                                   /* 16ths, slides and accents, a cell a section */
+        for (i = 0; i < 16u; i++) {
+            if (!vb_pct(i % 4u == 0u ? 90 : 62))
+                continue;
+            n = vb_below(10u);
+            d = n < 4u ? 0 : n < 6u ? 7 : n < 7u ? 6 : n < 8u ? 4 : n < 9u ? 2 : -1;
+            vb_bput(i, d == 7 ? r + 12u : vb_bn(d == 7 ? 0 : d, 0), vb_pct(30) ? 127u : vb_hum(84u), i + 1u, vb_pct(25));
+        }
+        break;
+    case BS_WOB:                                    /* long notes; the LFO on the filter (vb_ctl_make) */
+        vb_bput(0, r, 110u, 8u, 0);
+        vb_bput(8, vb_pct(30) ? vb_bn(vb_pct(50) ? 4 : -2, 0) : r, 104u, 16u, 0);
+        break;
+    case BS_SUB:                                    /* a long note behind the kick, a chord long */
+        if (!(vb.sbar % vb.cbars) || !((vb.act >> R_B) & 1u))
+            vb_bput(0, vb_bn(0, 0) < 30u ? vb_bn(0, 1) : vb_bn(0, 0), 110u, 16u, 0);
+        else
+            vb_hold(0, 16u);
+        break;
+    case BS_REESE:                                  /* long, detuned: three quarters, then a turn */
+        vb_bput(0, r, 110u, 12u, 0);
+        vb_bput(12, vb_pct(50) ? vb_bn(0, 1) : vb_bn(4, 0), 100u, 16u, vb_pct(30));
+        break;
+    case BS_OCT:                                    /* disco octaves on the 8ths */
+        for (i = 0; i < 16u; i += 2u)
+            vb_bput(i, i & 2u ? r + 12u : r, vb_hum(i & 2u ? 92u : 106u), i + 1u, 0);
+        break;
+    case BS_808:                                    /* the 808: on the kicks, held to the next, a glide now and then */
+        for (i = 0; i < 16u; i++)
+            if ((kick >> (2u * i)) & 3u) {
+                uint32_t to = i + 1u;
+                while (to < 16u && !((kick >> (2u * to)) & 3u))
+                    to++;
+                vb_bput(i, vb_pct(25) && i ? r + 12u : r, vb_hum(112u), to, vb_pct(30));
+            }
+        break;
+    case BS_SYNC:                                   /* syncopated 16ths, a cell a section */
+        m = vb_rnd() & 0x6D6Du;
+        m |= 1u;
+        for (i = 0; i < 16u; i++)
+            if ((m >> i) & 1u)
+                vb_bput(i, vb_pct(20) ? vb_bn(0, 1) : r, vb_hum(i & 1u ? 84u : 100u), i + 1u, 0);
+        break;
+    case BS_DUB:                                    /* a dub line: root, fifth, seventh, octave, with space */
+        {
+            static const int8_t DUB[8] = {0, 0, 4, 0, 6, 4, 2, 7};
+            static const uint8_t AT[8] = {0, 3, 6, 8, 10, 11, 13, 14};
+            for (i = 0; i < 8u; i++)
+                if (i < 2u || vb_pct(60))
+                    vb_bput(AT[i], DUB[i] == 7 ? r + 12u : vb_bn(DUB[i], 0), vb_hum(100u), AT[i] + (i == 0u ? 2u : 1u), 0);
+        }
+        break;
+    case BS_RIFF:                                   /* jump-up: a bouncing riff, octaves and slides */
+        for (i = 0; i < 16u; i++)
+            if (!i || vb_pct(i % 3u == 0u ? 70 : 30))
+                vb_bput(i, vb_pct(45) ? r + 12u : r, vb_hum(100u), i + 1u, vb_pct(30));
+        break;
+    default:
+        break;
+    }
+}
+
+/* ------------------------------------------------------- the chords --- */
+/* the chord of degree c with nv notes (1, 3, 4, 5: 1-3-7-9), close around the middle note mid: each tone's pitch class
+ * folded into mid - 6 .. mid + 5, ascending (voice leading for free: the next chord lands next to it) */
+static uint32_t vb_voice(uint32_t c, uint32_t nv, int32_t mid, uint8_t *out)
+{
+    static const int8_t IV[4][4] = {{0, 0, 0, 0}, {0, 2, 4, 0}, {0, 2, 4, 6}, {0, 2, 6, 8}};
+    uint32_t n = nv <= 1u ? 1u : nv == 3u ? 3u : 4u, k, j, iv = nv <= 1u ? 0u : nv - 2u;
+    for (k = 0; k < n; k++) {
+        int32_t x = (int32_t)vb.root + vb_semi((int32_t)c + IV[iv][k]);
+        x = mid - 6 + (((x - (mid - 6)) % 12) + 12) % 12;
+        for (j = k; j > 0 && out[j - 1u] > x; j--)
+            out[j] = out[j - 1u];
+        out[j] = (uint8_t)x;
+    }
+    return n;
+}
+/* T3: the chord of the bar in its rhythm (PAD held over, STAB, PLUCK, GATE, PIANO, SKANK) */
+static void vb_chords(uint32_t e, int fresh)
+{
+    const vb_sub_t *u = vb_sub();
+    uint8_t ch[4];
+    const vb_sec_t *c = vb_cur();
+    uint32_t nv = u->voicing > 3u && (c->type == VS_DROP || c->type == VS_BUILD || ((vb.act | 1u << R_C) & 1u << R_L))
+                  ? 3u : u->voicing;                /* (the budget: three notes beside a lead, in the build and drop) */
+    uint32_t n = vb_voice(vb_chord(), nv, u->chords == CR_PAD ? 60 : 64, ch), i, k, m = 0;
+    static const uint16_t STAB[4] = {0x4444u, 0x2449u, 0x4924u, 0x1491u};   /* off-beats; x..x..x...x..x..; garage; .. */
+    vb_stream(VR_CHORD, vb_cur()->type, vb.s.var > 50u ? vb.occ : 0u);
+    switch (u->chords) {
+    case CR_PAD:                                    /* held: struck when it changes (or a phrase begins), else on */
+        if (fresh || !(vb.sbar % 8u) || (!(vb.sbar % vb.cbars) && vb_chord() != vb.prog[((vb.sbar - 1u) / vb.cbars) & 3u])) {
+            for (k = 0; k < n; k++)
+                vb_put(0, ch[k], vb_hum(88u));
+            vb_hold(1, 16u);
+        } else
+            vb_hold(0, 16u);
+        return;
+    case CR_STAB:
+        m = STAB[vb_below(4u)];
+        if (e < 45u)
+            m &= 0x5555u;
+        break;
+    case CR_PLUCK:
+        m = e >= 75u ? 0xB6DBu : 0x5555u;
+        break;
+    case CR_GATE:                                   /* the trance gate: x.xx.xx.x.xx.xx. */
+        m = 0x6D6Du;
+        break;
+    case CR_PIANO:                                  /* house piano, syncopated */
+        m = vb_pct(50) ? 0x1449u : 0x2489u;
+        break;
+    case CR_SKANK:
+        m = 0x1010u;
+        break;
+    default:
+        return;
+    }
+    for (i = 0; i < 16u; i++)
+        if ((m >> i) & 1u)
+            for (k = 0; k < n; k++)
+                vb_put(i, ch[k], vb_hum(i % 4u == 0u ? 96u : 82u));
+}
+
+/* --------------------------------------------------------- the lead --- */
+static int vb_ctone(int32_t d)                      /* scale degree d is a tone of the bar's chord */
+{
+    int32_t n = (int32_t)vb_nscale(), x = ((d - (int32_t)vb_chord()) % n + n) % n;
+    return x == 0 || x == 2 || x == 4;
+}
+/* T4: the motif in phrases of four (A A' A B), its notes onto the chord on the strong steps, C4 .. C6; in the build
+ * the first half only; in later drops, with VARIATION, an octave up */
+static void vb_lead(uint32_t e)
+{
+    const vb_sub_t *u = vb_sub();
+    const vb_sec_t *c = vb_cur();
+    uint32_t mb = vb.sbar % vb.mbars, ph = (vb.sbar / vb.mbars) & 3u, i, up;
+    int32_t shift = ph == 3u ? 2 : 0;
+    vb_stream(VR_LEAD, vb_cur()->type, vb.occ);
+    up = c->type == VS_DROP && vb.occ && vb.s.var >= 30u && vb_pct(vb.s.var);
+    for (i = 0; i < 16u; i++) {
+        uint32_t m = vb.mot[mb][i];
+        int32_t d;
+        if (!m)
+            continue;
+        if (c->type == VS_BUILD && i >= 8u)
+            break;
+        if (m == 64u) {
+            vb_hold(i, i + 1u);
+            continue;
+        }
+        d = (int32_t)(m & 63u) - 8 + shift + (ph == 1u && i >= 12u ? 1 : 0);
+        if (i % 4u == 0u && !vb_ctone(d))
+            d += vb_ctone(d + 1) ? 1 : -1;
+        if (u->lead == LS_STAB)
+            d = i % 8u ? 4 : 0;
+        {
+            int32_t x = 60 + (int32_t)vb.root + vb_semi(d) + (up ? 12 : 0) + (u->lead == LS_BLIP ? 12 : 0);
+            while (x > 84)
+                x -= 12;
+            while (x < 60)
+                x += 12;
+            vb_put(i, (uint32_t)x, (m & 128u) || i % 4u == 0u ? vb_hum(110u) : vb_hum(90u));
+            if (m & 128u)
+                vb_o[i].flags |= SF_SLIDE;
+        }
+    }
+    (void)e;
+}
+
+/* ---------------------------------------------------------- the arp --- */
+/* T5: the chord's tones over two octaves (C4 ..), UP DOWN UP-DOWN or at random (a cell a section), 16ths or 8ths; or
+ * (AR_LOOP) a CC0 break on SLICE: its slices in order, a few swapped */
+static void vb_arp(uint32_t e)
+{
+    const vb_sub_t *u = vb_sub();
+    uint32_t mode = u->arp & 0x7Fu, rate = u->arp & 0x80u ? 2u : 1u, i, k, n, len;
+    uint8_t ch[4], list[8];
+    vb_stream(VR_ARP, vb_cur()->type, vb.s.var > 50u ? vb.occ : 0u);
+    if (mode == AR_LOOP) {
+        for (i = 0; i < 16u; i++)
+            if (i % 2u == 0u || e >= 60u)
+                vb_put(i, 60u + (vb_pct(15) ? vb_below(16u) : i), vb_hum(i % 4u ? 92u : 110u));
+        return;
+    }
+    n = vb_voice(vb_chord(), 3, 66, ch);
+    for (len = 0, k = 0; k < 2u; k++)
+        for (i = 0; i < n; i++)
+            list[len++] = (uint8_t)(ch[i] + 12u * k);
+    for (i = 0; i < 16u; i += rate) {
+        uint32_t j = i / rate, x;
+        x = mode == AR_DOWN ? len - 1u - j % len : mode == AR_UPDN ? (j % (2u * len - 2u) < len ? j % (2u * len - 2u)
+                                                                       : 2u * len - 2u - j % (2u * len - 2u))
+          : mode == AR_RND ? vb_below(len) : j % len;
+        vb_put(i, list[x % len], vb_hum(i % 4u ? 80u : 100u));
+    }
+}
+
+/* ----------------------------------------------------------- the FX --- */
+/* T6: the riser through the build (its level and filter rise: vb_ctl_make), the impact and downlifter of the drop, a
+ * long atmosphere under intro and break */
+static void vb_fxt(uint32_t e)
+{
+    const vb_sec_t *c = vb_cur();
+    (void)e;
+    if (c->type == VS_BUILD) {
+        if (!vb.sbar)
+            vb_put(0, 72u, 100u);
+        vb_hold(vb.sbar ? 0u : 1u, vb_left() == 1u && (vb_sub()->flags & VF_SIL) ? 12u : 16u);
+    } else if (c->type == VS_DROP) {
+        if (!vb.sbar)
+            vb_put(0, 48u, 120u);
+        vb_hold(vb.sbar ? 0u : 1u, 16u);
+    } else {
+        if (!vb.sbar || !((vb.act >> R_F) & 1u))
+            vb_put(0, 60u, 70u);
+        vb_hold(1u, 16u);
+        if (vb.sbar && ((vb.act >> R_F) & 1u))
+            vb_hold(0, 1u);
+    }
+}
+
+/* ------------------------------------------------- the bar's control --- */
+static void vb_ramp(vb_ctl_t *c, uint32_t k, uint32_t id, int32_t v0, int32_t v1)
+{
+    uint32_t i;
+    const param_desc_t *d = param_desc_of(eng_idx(trk[k].eng_req), id);
+    for (i = 0; i < VB_NRAMP && c->rp[i].k < NTRK; i++)
+        ;
+    if (i == VB_NRAMP)
+        return;
+    c->rp[i].k = (uint8_t)k;
+    c->rp[i].id = (uint8_t)id;
+    c->rp[i].v0 = (int8_t)clamp(v0, d->min > -128 ? d->min : -128, d->max < 127 ? d->max : 127);
+    c->rp[i].v1 = (int8_t)clamp(v1, d->min > -128 ? d->min : -128, d->max < 127 ? d->max : 127);
+}
+static uint8_t vb_lvl[NTRK] __attribute__((section(".pool")));   /* each track's level for the song (VB_SND's) */
+/* what the staged bar does besides its notes (producer_isr.c applies it on its steps): CC 104 .. 109, the tempo, the
+ * FX layer's FILTER and THROW (the build's HPF sweep, techno's LPF closing, the throw in its last beat), an effect
+ * (REPEAT or REVERSE into the drop, TAPE STOP once into a break, DUB's throws, lo-fi's VINYL), the tracks' moves (the
+ * riser's level and filter, the downlifter, an acid line's filter, a filter house loop) */
+static void vb_ctl_make(uint32_t e, uint32_t e1)
+{
+    const vb_sub_t *u = vb_sub();
+    const vb_sec_t *c = vb_cur();
+    vb_ctl_t *k = &vb_ctl[vb.bar & 1u];
+    uint32_t left = vb_left(), i, len = c->bars ? c->bars : 1u, t6 = throw_id(&trk[R_F], 0);
+    int32_t h;
+    memset(k, 0, sizeof *k);
+    k->bar = vb.bar;
+    k->cc[0] = c->type;
+    k->cc[1] = (uint8_t)(e * 127u / 100u);
+    k->cc[2] = (uint8_t)(vb.sbar < 127u ? vb.sbar : 127u);
+    k->cc[3] = (uint8_t)(c->bars < 127u ? c->bars : 127u);
+    k->cc[4] = vb.s.genre;
+    k->cc[5] = vb.s.sub;
+    k->e1 = (uint8_t)(e1 * 127u / 100u);
+    k->bpm = vb.bpm;
+    k->fx = PF_N;
+    for (i = 0; i < VB_NRAMP; i++)
+        k->rp[i].k = 0xFFu;
+    vb_stream(VR_FX, vb.nsec, vb.sbar);
+    if (c->type == VS_BUILD) {
+        h = 25 + 45 * (int32_t)vb.s.energy / 100;   /* the sweep: HPF up (techno: the LPF closing) */
+        if (u->form == FO_T)
+            h = -h;
+        k->flt0 = (int8_t)(h * (int32_t)vb.sbar / (int32_t)len);
+        k->flt1 = (int8_t)(h * (int32_t)(vb.sbar + 1u) / (int32_t)len);
+        vb_ramp(k, R_F, P_LEVEL, 20 + 90 * (int32_t)vb.sbar / (int32_t)len, 20 + 90 * (int32_t)(vb.sbar + 1u) / (int32_t)len);
+        vb_ramp(k, R_F, t6, 10 + 100 * (int32_t)vb.sbar / (int32_t)len, 10 + 100 * (int32_t)(vb.sbar + 1u) / (int32_t)len);
+        if (left == 1u) {                           /* the last beat: a reverb throw, a stutter or the reverse */
+            k->thr = (int8_t)(40 + e / 2u);
+            k->thr_at = 12;
+            if (!(u->flags & VF_SIL) && vb_pct(70)) {
+                k->fx = vb_pct(50) && vb.bpm >= 81u ? PF_REV : PF_R16;
+                k->fx_at = 12;
+                k->fx_to = 15;
+            }
+        }
+    } else if (c->type == VS_DROP && vb.sbar < 2u) {   /* the downlifter */
+        vb_ramp(k, R_F, P_LEVEL, vb.sbar ? 60 : 110, vb.sbar ? 0 : 60);
+        vb_ramp(k, R_F, t6, vb.sbar ? 50 : 110, vb.sbar ? 0 : 50);
+    } else {
+        vb_ramp(k, R_F, P_LEVEL, vb_lvl[R_F] / 2, vb_lvl[R_F] / 2);
+        vb_ramp(k, R_F, t6, 40, 40);
+    }
+    if ((u->flags & VF_TAPE) && !vb.tape && left == 1u && vb.sec + 1u < vb.nplan &&
+        vb.plan[vb.sec + 1u].type == VS_BREAK && c->type == VS_DROP) {   /* TAPE STOP, once, into the first break */
+        k->fx = PF_TAPE;
+        k->fx_at = 12;
+        k->fx_to = 15;
+        vb.tape = 1;
+    }
+    if ((u->flags & VF_DUB) && (c->type == VS_GROOVE || c->type == VS_BREAK) && (vb.sbar & 1u) && vb_pct(60)) {
+        k->fx = PF_DUB;                             /* dub: the delay thrown */
+        k->fx_at = 12;
+        k->fx_to = 15;
+    }
+    if ((u->flags & VF_VINYL) && k->fx == PF_N) {
+        k->fx = PF_VIN;
+        k->fx_to = 15;
+    }
+    if (u->flags & VF_ACIDB) {                      /* the acid line's filter: up over 8 bars, back down */
+        uint32_t p = vb.sbar & 7u, t2 = throw_id(&trk[R_B], 0);
+        int32_t a = p < 4u ? 30 + 12 * (int32_t)p : 78 - 12 * (int32_t)(p - 4u);
+        vb_ramp(k, R_B, t2, a + (int32_t)e / 4, a + (int32_t)e / 4 + (p < 4u ? 12 : -12));
+    }
+    if (u->flags & VF_FILT) {                       /* filter house: the loop's LPF opens over 8 bars */
+        uint32_t p = vb.sbar & 7u, t3 = throw_id(&trk[R_C], 0);
+        vb_ramp(k, R_C, t3, 20 + 12 * (int32_t)p, 32 + 12 * (int32_t)p);
+    }
+    if (u->bass == BS_WOB) {                        /* the wobble's rate: the LFO in time, faster with energy */
+        static const uint8_t RATE[4] = {5, 6, 8, 7};   /* 1/4 1/8 1/16 8T (N_LSYNC) */
+        uint32_t r = RATE[(e >= 70u ? 1u : 0u) + vb_below(e >= 70u ? 3u : 2u)];
+        vb_ramp(k, R_B, P_LSYNC, (int32_t)r, (int32_t)r);
+    }
+    if (c->type == VS_BREAK)                        /* the break's pad: more of the hall */
+        vb_ramp(k, R_C, P_REV, 90, 90);
+    else
+        vb_ramp(k, R_C, P_REV, 45, 45);
+}
+
+/* --------------------------------------------------------- staging --- */
+static const uint8_t VB_GATE[NTRK] = {64, 96, 64, 110, 56, 127};   /* each role's GATE (a PAD's notes go on as TIEs) */
+static uint32_t vb_gate(uint32_t k)
+{
+    const vb_sub_t *u = vb_sub();
+    if (k == R_C)
+        return u->chords == CR_PAD ? 127u : u->chords == CR_SKANK || u->chords == CR_GATE ? 36u : u->chords == CR_PIANO
+               ? 80u : 52u;
+    if (k == R_B)
+        return u->bass == BS_OCT || u->bass == BS_SYNC || u->bass == BS_ROOT ? 70u : u->bass == BS_ACID ? 90u : 110u;
+    return VB_GATE[k];
+}
+/* ------------------------------------------------ the voice budget --- */
+/* (BRIEF 3.1) never more voices at once than the budget (core.h VOICE_BUDGET: 8 with one core): at each step of the
+ * staged bar, what sounds: the drum lanes struck within their ring (a lane is one voice; a closed hat chokes the open
+ * one), the bass, lead, arp and FX one voice each (MONO / LEGATO) while a note or its tail lasts, each chord note while
+ * it or its tail lasts (a note struck again keeps its voice); the bar before rings on into it, and the bar keeps room
+ * for the next one's kick and bass. Over: the most recent note sounding at the first step over goes, the arp's first,
+ * then the chords' top note, the percussion (TOM RIM BELL HAT OP), the FX's, the lead's, the chord; what still does not
+ * fit (the bar before ringing on), the step's new closed hat, clap or snare. The rings and tails are the sounds'
+ * measured ones (producer_tables.c), in quarter steps at the tempo, a swung step's late start and a ratchet's last hit
+ * added */
+#define VB_BUDGET NVOICE
+static uint16_t vb_tq[NTRK] __attribute__((section(".pool")));   /* each role's tail past its note's end */
+static uint16_t vb_lq[NLANE] __attribute__((section(".pool")));  /* each drum lane's ring */
+#define VB_CHV 8u                                   /* chord voices tracked: a chord's notes and the last one's tails */
+static struct {
+    int16_t lane[NLANE], mono[NTRK], ch[VB_CHV];    /* where what sounds into the next bar ends (quarter steps from its
+                                                     * start; <= 0 nothing) */
+    uint8_t chn[VB_CHV];                            /* the chord notes' pitches */
+} vb_vc __attribute__((section(".pool")));
+static uint32_t vb_q(uint32_t ms)                   /* ms -> quarter steps at the tempo, up */
+{
+    uint32_t qs = div_samples(2) / 4u;
+    return (ms * (FS / 1000u) + qs - 1u) / (qs ? qs : 1u);
+}
+static void vb_tails(void)                          /* the song's sounds' tails at its tempo and swing (vb_load) */
+{
+    uint32_t k, l, i, sw = (4u * (uint32_t)song.g[G_SWING] + 249u) / 250u;   /* (a swung step's late start: seq.c
+                                                                                * swing_step_len, in quarter steps) */
+    for (k = 0; k < NTRK; k++)
+        vb_tq[k] = (uint16_t)(vb_q(16u * VB_SND[vb.snd[k] % NELEM(VB_SND)].tail) + sw);
+    for (l = 0; l < NLANE; l++)
+        vb_lq[l] = (uint16_t)(vb_q(1000u) + sw);
+    for (i = 0; i < NELEM(VB_KIT); i++)
+        if (VB_KIT[i].snd == vb.snd[R_D])
+            for (l = 0; l < NLANE; l++)
+                vb_lq[l] = (uint16_t)(vb_q(32u * VB_KIT[i].ring[l]) + sw);
+    memset(&vb_vc, 0, sizeof vb_vc);
+}
+/* a note on step s of o: where it ends (quarter steps): its TIEs after it, then the GATE of its last step */
+static int32_t vb_end(const step_t *o, uint32_t s, uint32_t gate)
+{
+    uint32_t e = s + 1u;
+    while (e < 16u && o[e].time == ST_TIE)
+        e++;
+    return (int32_t)(4u * (e - 1u) + (gate * 4u + 127u) / 128u);
+}
+/* the voices at each step: the first step from `from` on over the budget (VB_NONE none); fin: what sounds into the next
+ * bar. Steps 16..19 are the next bar's first beat: what rings into it and the kick and bass it will strike (the two the
+ * next bar cannot take: what else it strikes there it takes itself) */
+#define VB_NONE 32u
+static uint8_t vb_onl __attribute__((section(".pool")));   /* the lanes that took a voice of their own at the step
+                                                     * returned */
+static uint32_t vb_over(step_t *const *dst, uint32_t from, int fin)
+{
+    int16_t lane[NLANE], mono[NTRK], ch[VB_CHV];
+    uint8_t chn[VB_CHV];
+    uint32_t s, k, l, i, j, n;
+    memcpy(lane, vb_vc.lane, sizeof lane);
+    memcpy(mono, vb_vc.mono, sizeof mono);
+    memcpy(ch, vb_vc.ch, sizeof ch);
+    memcpy(chn, vb_vc.chn, sizeof chn);
+    for (k = R_B; k < NTRK; k++)                    /* (the bar opening on TIEs: what it holds goes on) */
+        if (dst[k][0].time == ST_TIE) {
+            int32_t e = vb_end(dst[k], 0, vb_gate(k)) + (k == R_C ? 0 : vb_tq[k]);
+            if (k == R_C) {
+                for (i = 0; i < VB_CHV; i++)
+                    if (ch[i] > 0)
+                        ch[i] = (int16_t)(e + vb_tq[k]);
+            } else if (mono[k] > 0)
+                mono[k] = (int16_t)e;
+        }
+    for (s = 0; s < 16u; s++) {
+        int32_t q = (int32_t)(4u * s);
+        const step_t *d = &dst[R_D][s];
+        vb_onl = 0;
+        if (d->time == ST_NOTE)
+            for (l = 0; l < NLANE; l++)
+                if ((d->hit >> l) & 1u) {
+                    if (lane[l] < q)
+                        vb_onl |= (uint8_t)(1u << l);
+                    lane[l] = (int16_t)(q + vb_lq[l] + (step_ratchet(d) > 1u ? 3 : 0));   /* (RATCH: its last hit) */
+                    if (l == LN_HATC && lane[LN_HATO] > q + 1)
+                        lane[LN_HATO] = (int16_t)(q + 1);   /* (the closed hat chokes the open one: after this step's
+                                                             * voices started) */
+                }
+        for (k = R_B; k < NTRK; k++) {
+            const step_t *o = &dst[k][s];
+            int32_t e;
+            if (o->time != ST_NOTE || !o->n)
+                continue;
+            e = vb_end(dst[k], s, vb_gate(k)) + vb_tq[k];
+            if (k != R_C) {
+                mono[k] = (int16_t)e;
+                continue;
+            }
+            for (i = 0; i < o->n && i < 4u; i++) {   /* a chord note: its voice again, or a free one */
+                for (j = 0; j < VB_CHV && !(ch[j] > q && chn[j] == o->note[i]); j++)
+                    ;
+                if (j == VB_CHV)
+                    for (j = 0; j < VB_CHV && ch[j] > q; j++)
+                        ;
+                if (j == VB_CHV)                    /* (no slot: the earliest ending one) */
+                    for (j = 0, l = 1; l < VB_CHV; l++)
+                        if (ch[l] < ch[j])
+                            j = l;
+                ch[j] = (int16_t)e;
+                chn[j] = o->note[i];
+            }
+        }
+        for (n = 0, l = 0; l < NLANE; l++)          /* (what ends on this step still holds its voice while the step's
+                                                     * new ones start) */
+            n += lane[l] >= q;
+        for (k = R_B; k < NTRK; k++)
+            n += k != R_C && mono[k] >= q;
+        for (i = 0; i < VB_CHV; i++)
+            n += ch[i] >= q;
+        if (n > VB_BUDGET && !fin && s >= from)
+            return s;
+    }
+    if (!fin && from < 20u) {
+        uint32_t kick = 1, bass = vb_sub()->bass != BS_NONE;   /* (whatever this bar plays: the next may start them) */
+        for (s = from > 16u ? from : 16u; s < 20u; s++) {   /* (the next bar's first beat) */
+            int32_t q = (int32_t)(4u * s);
+            for (n = kick, l = 0; l < NLANE; l++)
+                n += lane[l] >= q && (l != LN_KICK || !kick);
+            for (k = R_B; k < NTRK; k++)
+                n += k != R_C && (k == R_B ? bass || mono[k] >= q : mono[k] >= q);
+            for (i = 0; i < VB_CHV; i++)
+                n += ch[i] >= q;
+            if (n > VB_BUDGET)
+                return s;
+        }
+    }
+    if (fin) {
+        for (l = 0; l < NLANE; l++)
+            vb_vc.lane[l] = (int16_t)(lane[l] - 64);
+        for (k = 0; k < NTRK; k++)
+            vb_vc.mono[k] = (int16_t)(mono[k] - 64);
+        for (i = 0; i < VB_CHV; i++) {
+            vb_vc.ch[i] = (int16_t)(ch[i] - 64);
+            vb_vc.chn[i] = chn[i];
+        }
+    }
+    return VB_NONE;
+}
+/* the most recent note-on of role k at or before step s (16..19: the next bar's) that still sounds at s (-1 none);
+ * a drum step's: of the lanes `lanes` */
+static int32_t vb_last(step_t *const *dst, uint32_t k, uint32_t s, uint32_t lanes)
+{
+    int32_t i, e;
+    uint32_t l;
+    for (i = (int32_t)(s < 16u ? s : 15u); i >= 0; i--) {
+        const step_t *o = &dst[k][i];
+        if (o->time != ST_NOTE)
+            continue;
+        if (k == R_D ? (o->hit & lanes) != 0u : o->n != 0u) {
+            if (k == R_D) {
+                for (e = 0, l = 0; l < NLANE; l++)
+                    if (((o->hit & lanes) >> l) & 1u && 4 * i + vb_lq[l] > e)
+                        e = 4 * i + vb_lq[l];
+            } else
+                e = vb_end(dst[k], (uint32_t)i, vb_gate(k)) + vb_tq[k];
+            if (e >= 4 * (int32_t)s)
+                return i;
+            if (k != R_D)
+                return -1;
+        }
+    }
+    return -1;
+}
+static void vb_budget(step_t *const *dst)
+{
+    static const uint8_t PERC = 1u << LN_TOM | 1u << LN_RIM | 1u << LN_BELL | 1u << LN_HATO;
+    uint32_t s, guard, from = 0;
+    int32_t i;
+    for (guard = 0; guard < 64u && (s = vb_over(dst, from, 0)) < 20u; guard++) {
+        if ((i = vb_last(dst, R_A, s, 0)) >= 0)
+            step_clear(&dst[R_A][i]);
+        else if ((i = vb_last(dst, R_C, s, 0)) >= 0 && dst[R_C][i].n > 1u)
+            dst[R_C][i].n--;
+        else if ((i = vb_last(dst, R_D, s, PERC)) >= 0) {
+            uint32_t l = 0;                         /* (of its percussion, the lane that rings into step s) */
+            while (!((dst[R_D][i].hit & PERC) >> l & 1u) || 4 * i + vb_lq[l] < 4 * (int32_t)s)
+                l++;
+            dst[R_D][i].hit &= (uint8_t)~(1u << l);
+            if (!dst[R_D][i].hit)
+                dst[R_D][i].time = ST_REST;
+        } else if ((i = vb_last(dst, R_F, s, 0)) >= 0)
+            step_clear(&dst[R_F][i]);
+        else if ((i = vb_last(dst, R_L, s, 0)) >= 0)
+            step_clear(&dst[R_L][i]);
+        else if ((i = vb_last(dst, R_C, s, 0)) >= 0)
+            step_clear(&dst[R_C][i]);
+        else if (s < 16u && (vb_onl & (1u << LN_HATC | 1u << LN_CLAP | 1u << LN_SNARE))) {
+            uint32_t l = vb_onl & 1u << LN_HATC ? LN_HATC : vb_onl & 1u << LN_CLAP ? LN_CLAP : LN_SNARE;
+            dst[R_D][s].hit &= (uint8_t)~(1u << l);  /* (the last resort: that step's new hat, clap or snare; never
+                                                     * the kick) */
+            if (!dst[R_D][s].hit)
+                dst[R_D][s].time = ST_REST;
+        } else
+            from = s + 1u;                          /* (what the bar before rings on: nothing of this bar to take) */
+    }
+    (void)vb_over(dst, 16, 1);
+}
+
+/* the staged bar's steps of every track: into dst[k] (launch_q's, or the tracks' own at PLAY) */
+static void vb_write(step_t *const *dst)
+{
+    uint32_t e = vb_energy(), m = vb_roles(e), k;
+    int fresh;
+    for (k = 0; k < NTRK; k++) {
+        vb_o = dst[k];
+        vb_clear();
+        if (!((m >> k) & 1u))
+            continue;
+        fresh = !vb.sbar || !((vb.act >> k) & 1u);
+        switch (k) {
+        case R_D: vb_drums(e); break;
+        case R_B: vb_bass(e); break;
+        case R_C: vb_chords(e, fresh); break;
+        case R_L: vb_lead(e); break;
+        case R_A: vb_arp(e); break;
+        default: vb_fxt(e); break;
+        }
+        if (fresh && vb_o[0].time == ST_TIE)        /* (a TIE with nothing before it: silent; the PAD starts) */
+            vb_o[0].time = ST_REST;
+    }
+    vb_budget(dst);
+    {   /* the energy at the bar's end: the next bar's start */
+        uint32_t e1 = e;
+        if (vb.sbar + 1u < vb_cur()->bars) {
+            vb.sbar++;
+            e1 = vb_energy();
+            vb.sbar--;
+        }
+        vb_ctl_make(e, e1);
+    }
+    vb.act = (uint8_t)m;
+}
+/* the tracks' time for the producer's patterns: 16 steps of 1/16, forward, the role's GATE, no swing of their own */
+static void vb_time(int16_t *tv, uint32_t k)
+{
+    tv[0] = 16;
+    tv[1] = 2;
+    tv[2] = 0;
+    tv[3] = (int16_t)vb_gate(k);
+    tv[4] = DIR_FWD;
+}
+/* playing: the next bar into launch_q, armed for the end of the bar playing (LOOP: 16 steps, its pass) */
+static void vb_stage(void)
+{
+    step_t *dst[NTRK];
+    uint32_t k;
+    for (k = 0; k < NTRK; k++)
+        dst[k] = launch_q[k].step;
+    vb_write(dst);
+    for (k = 0; k < NTRK; k++) {
+        launch_t *q = &launch_q[k];
+        int16_t tv[5];
+        vb_time(tv, k);
+        memcpy(q->time, tv, sizeof q->time);
+        q->motion.count = 0;
+        q->motion.on = 0;
+        q->mode = LAUNCH_LOOP;
+        q->reps = 0;
+        q->id = PAT_NONE;
+        q->slot = 0;
+        q->adv = 0;
+        q->mlost = 0;
+        q->at = 0;
+        RING_PUBLISH();
+        q->armed = 1;
+    }
+}
+
+/* the next section (the bar after the last of one): live requests, the knobs, ENDLESS's next cycle and style */
+static void vb_next(void);
+static void vb_advance(void)
+{
+    vb.bar++;
+    if (vb.req & (VQ_DROP | VQ_BREAK)) {            /* DROP NOW / BREAK NOW: the section ends here */
+        vb.plan[vb.sec].bars = (uint8_t)(vb.sbar + 1u);
+        vb.sbar = (uint8_t)(vb.plan[vb.sec].bars - 1u);
+    }
+    if (++vb.sbar < vb_cur()->bars)
+        return;
+    vb.sbar = 0;
+    if ((vb.req & VQ_HOLD) && !(vb.req & (VQ_DROP | VQ_BREAK)))
+        return;                                     /* HOLD: the section again */
+    vb.nsec++;
+    vb_next();
+}
+static void vb_next(void)
+{
+    uint32_t i, j, t, d = VB_PLAN;
+    if (vb.req & (VQ_DROP | VQ_BREAK)) {            /* the rest of the plan from its next DROP, a BUILD (and BREAK) before */
+        uint32_t brk = (vb.req & VQ_BREAK) != 0u, build = brk || vb_cur()->type == VS_BREAK || vb_cur()->type == VS_INTRO
+                       ? 8u : 4u;
+        vb_sec_t rest[VB_PLAN];
+        uint32_t n = 0;
+        for (i = vb.sec + 1u; i < vb.nplan; i++)
+            if (vb.plan[i].type == VS_DROP) {
+                d = i;
+                break;
+            }
+        if (d < VB_PLAN)
+            for (i = d; i < vb.nplan && n < VB_PLAN - 3u; i++)
+                rest[n++] = vb.plan[i];
+        vb.nplan = (uint8_t)(vb.sec + 1u);
+        if (brk)
+            vb_sec_put(vb.nplan++, VS_BREAK, 8u);
+        vb_sec_put(vb.nplan++, VS_BUILD, build);
+        if (!n) {
+            vb_sec_put(vb.nplan++, VS_DROP, 16u);
+            if (vb.s.len != VL_ENDLESS)
+                vb_sec_put(vb.nplan++, VS_OUTRO, 8u);
+        }
+        for (i = 0; i < n && vb.nplan < VB_PLAN; i++)
+            vb.plan[vb.nplan++] = rest[i];
+        vb.req &= (uint8_t)~(VQ_DROP | VQ_BREAK);
+    }
+    vb.sec++;
+    if (vb.s.len == VL_ENDLESS && vb.sec + 1u >= vb.nplan)
+        vb_more();
+    t = vb_cur()->type;
+    for (i = 0, j = 0; i < vb.sec; i++)
+        j += vb.plan[i].type == t;
+    vb.occ = (uint8_t)j;
+    if (vb.chg) {                                   /* ENERGY, VARIATION: from this section on */
+        vb.s.energy = vb.k.energy;
+        vb.s.var = vb.k.var;
+        vb.chg = 0;
+    }
+}
+
+/* ------------------------------------------------------------ owning --- */
+static project_store_t vb_keep __attribute__((section(".vbox")));   /* the GROOVEBOX's music, packed (SKF4); after
+                                                                     * .bss (app.ld: the pool keeps its 8 KiB spare) */
+static int vb_owns(void) { return vb.own; }
+/* the GROOVEBOX's music kept (its changed patterns into the pool, as the autosave keeps them; the project in RAM), the
+ * tracks the producer's: no list, no SONG, no automation, on no pattern. 0 refused (PATTERNS FULL: said) */
+static int vb_take(void)
+{
+    int kr;
+    if (vb.own)
+        return 1;
+    if ((kr = keep_all()) != 0) {
+        ui_way(kr == 1 ? "PATTERNS FULL" : "SAVE ERROR", kr == 1 ? WAY_PATTERNS : "");
+        return 0;
+    }
+    project_capture(&proj_scratch);
+    vb.kept = proj_pack2(&vb_keep, &proj_scratch, PROJ_SKF) != 0;
+    (void)stage_cancel();
+    fm1_irq_off();
+    launch_drop();
+    memset(&motion, 0, sizeof motion);
+    memset(motion_active, 0, sizeof motion_active);
+    motion_base_valid = 0;
+    lists.song = SONG_OFF;
+    memset(trk_pid, 0, sizeof trk_pid);
+    fm1_irq_on();
+    undo_clear();
+    vb.own = 1;
+    return 1;
+}
+/* back to the GROOVEBOX, stopped: its music as it was */
+static void vb_give(void)
+{
+    if (!vb.own || song.playing)
+        return;
+    vb_run = 0;
+    vb_resend = 2;
+    if (vb.kept) {
+        int n = proj_import(&proj_scratch, &vb_keep, sizeof vb_keep);
+        if (n) {
+            proj_bound(&proj_scratch);
+            (void)project_restore_runtime(&proj_scratch);
+        }
+    }
+    vb.own = vb.kept = 0;
+    sync_reload = 1;
+    ui.force = 1;
+}
+
+/* ------------------------------------------------------- the tracks --- */
+/* track k: engine en's preset pre as PRESETS loads it (no undo) at level lvl, and what the role sets of the rest */
+static void vb_sound(uint32_t k, uint32_t en, uint32_t pre, uint32_t lvl)
+{
+    track_t *t = &trk[k];
+    const engine_t *e = ENGINES[en % NENGINES];
+    uint32_t pi = e->npresets ? pre % e->npresets : 0u, kit;
+    fm1_irq_off();
+    t->eng_req = (uint8_t)(en % NENGINES);
+    t->user = 0;
+    t->preset = (uint8_t)pi;
+    preset_fill(t->p, e, pi);
+    kit = t->eng_req == ENGI_DRUMX ? DRUMX_PKIT[pi % NELEM(DRUMX_PKIT)] : 0u;
+    if (kit)
+        memcpy(dx_kit, DX_KITS[kit - 1u], sizeof dx_kit);
+    t->p[P_LEVEL] = vb_lvl[k] = (uint8_t)lvl;
+    t->p[P_PAN] = (int16_t)(k == R_A ? 18 : k == R_L ? -8 : 0);
+    t->p[P_AMODE] = 0;
+    t->p[P_SLCR] = 0;
+    t->p[P_CHRD] = 0;
+    t->p[P_DIR] = DIR_FWD;
+    t->p[P_ROOT] = vb.root;
+    t->p[P_SCALE] = vb.scale;
+    t->p[P_QUANT] = k == R_L ? QN_WHITE : QN_OFF;   /* (the white keys play the lead in the song's scale) */
+    t->p[P_TRANS] = 0;
+    if (k != R_C && k != R_D && !e->oneshot)
+        t->p[P_VOICE] = V_LEGATO;                   /* (one voice: the budget) */
+    {   /* the voice budget (8 at once, core.h): releases no longer than the role can carry, the kit's long lanes shorter */
+        static const uint8_t REL[NTRK] = {127, 40, 70, 60, 40, 90};
+        static const int8_t LDEC[NLANE] = {0, -8, -12, -8, -24, -20, -12, -32};
+        uint32_t r = k == R_C && vb_sub()->chords != CR_PAD ? 48u : REL[k], l;
+        if (t->p[P_REL] > (int16_t)r)
+            t->p[P_REL] = (int16_t)r;
+        if (t->eng_req == ENGI_DRUM)
+            for (l = 0; l < NLANE; l++)
+                t->p[P_LDECAY0 + l] = LDEC[l];
+    }
+    t->p[P_DKSRC] = (int16_t)((vb_sub()->flags & VF_4) && (k == R_B || k == R_C || k == R_A) ? 1 : 0);
+    t->p[P_DKAMT] = (int16_t)(k == R_B ? 70 + vb.s.energy / 4u : 50 + vb.s.energy / 4u);
+    t->p[P_DKREL] = 60;
+    if (k == R_C)
+        t->p[P_DLY] = (int16_t)((vb_sub()->dly & 15u) * 8u);
+    if (k == R_B && vb_sub()->bass == BS_WOB) {     /* the wobble: the LFO on the filter, in time */
+        t->p[P_LD_FLT] = 52;
+        t->p[P_LSYNC] = 6;
+        t->p[P_LTRIG] = 0;
+    }
+    fm6_track_loaded(t);
+    panic_req |= (uint8_t)(1u << k);
+    fm1_irq_on();
+}
+/* a new song into the tracks, stopped: its sounds, the globals it sets (tempo, swing, delay, reverb), its first bar */
+static void vb_load(void)
+{
+    const vb_sub_t *u = vb_sub();
+    step_t *dst[NTRK];
+    uint32_t k;
+    int16_t tv[5];
+    for (k = 0; k < NTRK; k++) {
+        const vb_snd_t *s = &VB_SND[vb.snd[k] % NELEM(VB_SND)];
+        vb_sound(k, s->eng, s->pre, s->lvl);
+    }
+    song.g[G_BPM] = vb.bpm;                          /* (the tails in steps at it, and its swing) */
+    song.g[G_SWING] = u->swing;
+    vb_tails();
+    song.g[G_DTIME] = (int16_t)(u->dly >> 4);
+    song.g[G_DFDBK] = (int16_t)(u->flags & VF_DUB ? 92 : 55);
+    song.g[G_RTYPE] = (int16_t)(u->flags & VF_DUB ? 1 : u->form == FO_A || u->form == FO_H || u->form == FO_D ? 2 : 0);
+    song.g[G_RSIZE] = (int16_t)(u->form == FO_A ? 120 : 90);
+    sel_set(R_L);                                   /* (the keys: the lead) */
+    vb.bar = 0;
+    vb.sec = vb.sbar = 0;
+    vb.nsec = 0;
+    vb.occ = 0;
+    vb.act = 0;
+    vb.req &= VQ_HOLD;
+    vb.tape = 0;
+    vb.sub_bars = 0;
+    for (k = 0; k < NTRK; k++) {
+        dst[k] = trk[k].step;
+        vb_time(tv, k);
+        trk[k].p[P_SLEN] = tv[0];
+        trk[k].p[P_SDIV] = tv[1];
+        trk[k].p[P_SSWING] = tv[2];
+        trk[k].p[P_SGATE] = tv[3];
+        trk[k].p[P_DIR] = tv[4];
+    }
+    vb_write(dst);
+    for (k = 16; k < NSTEP; k++) {                  /* (the rest of the 64: empty) */
+        uint32_t j;
+        for (j = 0; j < NTRK; j++)
+            step_clear(&trk[j].step[k]);
+    }
+}
+
+/* ---------------------------------------------------- the transport --- */
+/* PLAY in the VIZZBOX: the knobs' song from its first bar (0: refused, said) */
+static int vb_start(void)
+{
+    if (song.playing || !vb_take())
+        return 0;
+    vb.s = vb.k;
+    vb_song();
+    vb_load();
+    vb_seen = 0;
+    vb_run = 1;
+    transport_req = 1;
+    ui.force = 1;
+    return 1;
+}
+/* each pass of the main loop (ui_input): the next bar once the last came in; what went out goes (nobody keeps it); the
+ * song's end */
+static void vb_poll(void)
+{
+    uint32_t k, armed = 0;
+    if (!vb.own || !vb_run)
+        return;
+    for (k = 0; k < NTRK; k++) {
+        launch_q[k].done = 0;
+        armed |= launch_q[k].armed;
+    }
+    if (!song.playing || transport_req || armed)
+        return;
+    if (vb.s.len != VL_ENDLESS && vb.sec + 1u >= vb.nplan && vb.sbar + 1u >= vb_cur()->bars) {
+        vb_ctl[(vb.bar + 1u) & 1u].bar = vb.bar + 1u;   /* (the song is over: the ISR stops at the next bar) */
+        vb_ctl[(vb.bar + 1u) & 1u].end = 1;
+        return;
+    }
+    vb_advance();
+    vb_stage();
+}
diff --git a/firmware/src/producer_isr.c b/firmware/src/producer_isr.c
new file mode 100644
index 0000000..b2d4703
--- /dev/null
+++ b/firmware/src/producer_isr.c
@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox) The producer's part in the audio ISR (producer.c is the rest, in the main loop). The main loop writes each
+ * bar ahead: the tracks' patterns into launch_q (launch.c, LOOP: the ISR swaps them in on the bar line) and what else
+ * that bar does into vb_ctl[bar & 1]. Here, at each 1/16 step (launch_steps, counted before the tracks tick), that is
+ * put into effect: the tempo, a track's parameter moving over the bar (a filter opening, a riser's level), the FX
+ * layer's FILTER and THROW macros and one of its effects (perform.c), and the song's state as MIDI (CC 104..109 on
+ * channel 16, docs/VIZZBOX-MIDI.md): all six at each bar's first step, before its notes (after Vizz's CC 103:
+ * seq_mute_block runs first; at PLAY right after Start and those), CC 105 on a step it changed on; all six again when
+ * SEQ MIDI OUT turns on or USB comes up; CC 104 0 at the stop (seq_stop) and once when the producer lets go of the
+ * tracks. While it does not run (vb_run 0) nothing at all: Skiff's sound and MIDI as they were. Included by seq.c */
+#define VB_CH 15u                                   /* MIDI channel 16 */
+#define VB_CC 104u                                  /* CC 104 .. 109: section, energy, its bar, its length, genre,
+                                                     * subgenre */
+#define VB_NRAMP 6u
+typedef struct {
+    uint32_t bar;                                   /* the bar from PLAY it is for */
+    uint8_t cc[6];                                  /* CC 104 .. 109 at its first step (105: its energy then) */
+    uint8_t e1;                                     /* CC 105 at its last step: a line from cc[1] */
+    uint8_t bpm;                                    /* the tempo from its first step */
+    int8_t flt0, flt1;                              /* FILTER (perf_k[0]: -100 LPF .. 100 HPF) at its first step, its last */
+    int8_t thr;                                     /* THROW (perf_k[2]) from step thr_at on (0: none) */
+    uint8_t thr_at;
+    uint8_t fx, fx_at, fx_to;                       /* an FX layer effect (PF_*; PF_N none) on steps fx_at .. fx_to */
+    uint8_t end;                                    /* the song is over: stop on its first step */
+    struct { uint8_t k, id; int8_t v0, v1; } rp[VB_NRAMP];   /* track k's parameter id: v0 on the first step .. v1 on
+                                                     * the last (k 0xFF: none) */
+} vb_ctl_t;
+static vb_ctl_t vb_ctl[2] __attribute__((section(".pool")));
+static volatile uint8_t vb_run __attribute__((section(".pool")));                     /* main: the producer plays the tracks (set before PLAY) */
+static uint8_t vb_mode __attribute__((section(".pool")));                             /* main: 1 the VIZZBOX (its screen, its controls), 0 the GROOVEBOX */
+static volatile uint8_t vb_resend __attribute__((section(".pool")));                  /* main: 1 the six again; 2 CC 104 0 once (it let go) */
+static uint32_t vb_seen __attribute__((section(".pool")));   /* launch_steps + 1 of the step put into effect last */
+static uint8_t vb_out __attribute__((section(".pool")));     /* SEQ MIDI OUT and USB as when the six went last */
+static uint8_t vb_e __attribute__((section(".pool")));       /* CC 105 sent last */
+static uint8_t vb_fxon __attribute__((section(".pool")));    /* the effect held + 1 (0: none) */
+static void seq_stop(void);
+
+static void vb_cc(uint32_t n, uint32_t v)
+{
+    if (seq_midi_on)
+        midi_out_event(0x0Bu | (0xB0u | VB_CH) << 8 | n << 16 | (v & 0x7Fu) << 24);
+}
+static int32_t vb_line(int32_t a, int32_t b, uint32_t s) { return a + (b - a) * (int32_t)s / 15; }
+static void vb_hold_fx(uint32_t e)                  /* the FX layer's effect e held (PF_N: none) */
+{
+    if (vb_fxon && vb_fxon - 1u != e)
+        perf_press(vb_fxon - 1u, 0);
+    if (e < PF_N && vb_fxon != e + 1u)
+        perf_press(e, 1);
+    vb_fxon = (uint8_t)(e < PF_N ? e + 1u : 0u);
+}
+
+/* each block, after launch_clock and the mutes, before the tracks tick */
+static __attribute__((noinline)) void vb_isr(void)
+{
+    uint32_t st = launch_steps, s = st & 15u, o, i, e;
+    const vb_ctl_t *c = &vb_ctl[(st >> 4) & 1u];
+    if (vb_resend == 2u) {                          /* (let go: CC 104 0, once) */
+        vb_resend = 0;
+        vb_cc(VB_CC, 0);
+    }
+    if (!vb_run || !song.playing || c->bar != st >> 4)
+        return;                                     /* (a bar not written in time: as the last) */
+    o = 1u | (seq_midi_on ? 2u : 0u) | (usb.config ? 4u : 0u);
+    if (vb_seen != st + 1u) {                       /* a new step */
+        vb_seen = st + 1u;
+        if (!s && c->end) {
+            seq_stop();
+            return;
+        }
+        if (!s && c->bpm && !song.g[G_CLOCK])
+            song.g[G_BPM] = c->bpm;
+        perf_k[0] = (int16_t)vb_line(c->flt0, c->flt1, s);
+        perf_k[2] = (int16_t)(c->thr && s >= c->thr_at ? c->thr : 0);
+        vb_hold_fx(c->fx < PF_N && s >= c->fx_at && s <= c->fx_to ? c->fx : PF_N);
+        for (i = 0; i < VB_NRAMP; i++)
+            if (c->rp[i].k < NTRK)
+                trk[c->rp[i].k].p[c->rp[i].id] = (int16_t)vb_line(c->rp[i].v0, c->rp[i].v1, s);
+        e = (uint32_t)vb_line(c->cc[1], c->e1, s);
+        if (!s || vb_out != o || vb_resend) {       /* the bar's first step (or SEQ MIDI OUT on, USB up): all six */
+            for (i = 0; i < 6u; i++)
+                vb_cc(VB_CC + i, i == 1u ? e : c->cc[i]);
+            vb_out = (uint8_t)o;
+            vb_resend = 0;
+            vb_e = (uint8_t)e;
+        } else if (e != vb_e) {
+            vb_cc(VB_CC + 1u, e);
+            vb_e = (uint8_t)e;
+        }
+    } else if (vb_out != o || vb_resend) {          /* (SEQ MIDI OUT on, USB up between two steps: all six now) */
+        e = vb_e;
+        for (i = 0; i < 6u; i++)
+            vb_cc(VB_CC + i, i == 1u ? e : c->cc[i]);
+        vb_out = (uint8_t)o;
+        vb_resend = 0;
+    }
+}
+/* the transport stops (seq_stop): CC 104 0, the FX layer's macros and effect let go */
+static void vb_isr_stop(void)
+{
+    if (!vb_run)
+        return;
+    if (song.playing)
+        vb_cc(VB_CC, 0);
+    vb_hold_fx(PF_N);
+    perf_k[0] = perf_k[2] = 0;
+    vb_seen = 0;
