diff --git a/tools/vizzbox_pick.py b/tools/vizzbox_pick.py
new file mode 100644
index 0000000..712a214
--- /dev/null
+++ b/tools/vizzbox_pick.py
@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""(Vizzbox) The producer's sound lists from the measurements (BRIEF-VIZZBOX.md 3.4: chosen by rendering and measuring,
+not by guessing): tools/vizzbox_sounds renders every factory sound in every role, tools/vizzbox_sounds.py measures
+them (DIR/measured.tsv); this picks each list's candidates and writes them into firmware/src/producer_tables.c between
+its GENERATED markers: VB_SND (engine, preset, the level that brings it to its role's loudness, its tail), VB_KIT
+(each drum kit's lanes: how long each rings) and VB_LIST.
+  vizzbox_pick.py DIR [LANES.tsv]      (LANES.tsv: the kits' lane rings, ms, from tools/vizzbox_sounds LANES)
+A list is a role and a colour: the sounds allowed by name (the colour), of those the ones whose measurements fit the
+role (a tail the voice budget can carry, enough fundamental for a bass, the level reachable at P_LEVEL 127), at most
+four, the best fit first. A list left with fewer than two says so and fails."""
+import csv
+import re
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+TABLES = ROOT / "firmware" / "src" / "producer_tables.c"
+
+# role: (the measurement's role, the tail it may have (ms), centroid range (Hz), least low share)
+RULE = {"drums": ("drums", 99999, (0, 99999), 0.0),
+        "bass": ("bass", 500, (0, 400), 0.5),      # (mono: a tail holds its one voice a little longer)
+        "chords": ("chords", 800, (200, 2000), 0.0),
+        "stabs": ("chords", 250, (200, 2000), 0.0),
+        "lead": ("lead", 250, (450, 2600), 0.0),
+        "arp": ("arp", 400, (380, 2600), 0.0),
+        "loop": ("arp", 400, (0, 99999), 0.0),
+        "fx": ("fx", 99999, (0, 99999), 0.0)}
+# the lists in producer_tables.c's order: (role rule, colour, the names allowed)
+LISTS = [
+    ("drums", "house: Felucca's own kit, tight, punchy", ["DRUM KIT", "TIGHT KIT", "CRISP KIT"]),
+    ("drums", "techno: tight, studio, the DRUM-X factory kit", ["TIGHT KIT", "STUDIO KIT", "FACTORY KIT", "DRUM KIT"]),
+    ("drums", "808", ["NEON KIT", "BOOM KIT", "ELECTRO KIT"]),
+    ("drums", "lo-fi, boom bap", ["LOFI KIT", "RHYTHM BOX", "DEEP DRUMS", "SOFT KIT"]),
+    ("drums", "percussion", ["PERC KIT", "TRIBAL KIT", "DRUM KIT"]),
+    ("drums", "hard", ["INDUSTRIAL", "WAR DRUMS", "TIGHT KIT"]),
+    ("drums", "breaks, drum & bass", ["SNAP KIT", "TIGHT KIT", "DRUM KIT"]),
+    ("drums", "deep, dub", ["DEEP KIT", "DEEP DRUMS", "SOFT KIT"]),
+    ("drums", "minimal: clicks", ["CLICK KIT", "GLITCH KIT", "HADRON KIT"]),
+    ("bass", "round", ["SQR BASS", "NIGHT BASS", "SUB SAW", "PD BASS", "FM BASS"]),
+    ("bass", "acid", ["ACID"]),
+    ("bass", "sub", ["SUB BASS", "PEDAL BASS", "TRI BASS", "WAVE BASS"]),
+    ("bass", "reese, growl", ["REESE", "GROWL BASS", "DARK MATTER", "DRIVE BASS"]),
+    ("bass", "drive, rolling", ["DRIVE BASS", "FAT BASS", "SQR BASS", "NIGHT BASS"]),
+    ("bass", "fm, pick", ["FM BASS", "PICK BASS", "DARK MATTER", "GROWL BASS"]),
+    ("bass", "soft", ["PEDAL BASS", "SUB SAW", "TRI BASS", "SUB BASS"]),
+    ("bass", "wobble", ["GROWL BASS", "REESE", "WOW BASS", "DRIVE BASS"]),
+    ("chords", "pads", ["PWM STR", "PD STRINGS", "STRINGS", "CHIP CHOIR", "SUNSET PAD", "SOFT PAD"]),
+    ("stabs", "plucks", ["SYNTH PLUCK", "NEUTRINO", "NYLON PICK", "PHOTON", "KOTO"]),
+    ("chords", "keys", ["TINE EP", "PIANO", "LOFI PIANO", "GLASS KEYS", "SOFT KEYS"]),
+    ("stabs", "stabs, brass", ["HERO BRASS", "SOFT KEYS", "PWM STR", "SYNTH PLUCK", "SINE KEY"]),
+    ("chords", "strings, choir", ["STRINGS", "PD STRINGS", "CHIP CHOIR", "MONK CHANT", "CHOIR AAH"]),
+    ("chords", "organ", ["PD ORGAN", "FULL ORGAN", "GOSPEL", "FM ORGAN"]),
+    ("lead", "saw", ["SAW LEAD", "NEON LEAD", "HARD SYNC", "PULSE LD"]),
+    ("lead", "rave, sync", ["RAVE", "SYNC LEAD", "TURBO SYNC", "HARD SYNC"]),
+    ("lead", "chip", ["PULSE LD", "STEP LEAD", "ARP 8BIT", "WAVE LEAD"]),
+    ("lead", "flute, sax", ["FLUTE", "SAX", "BONE FLUTE", "CLARINET"]),
+    ("lead", "phase", ["PD BRASS", "WIRE", "VOX LEAD", "NEUTRINO"]),
+    ("lead", "acid lead", ["ACID", "RESO", "WIRE", "HARD SYNC"]),
+    ("lead", "noise stabs, robot", ["ROBOT TALK", "QUANTA", "WIND SWEEP", "VOX LEAD"]),
+    ("arp", "synth", ["SYNTH PLUCK", "NEUTRINO", "NEON ARP", "ARP LEAD"]),
+    ("arp", "bells", ["MUSIC BOX", "RING BELL", "CHIP BELL", "NYLON PICK"]),
+    ("arp", "chip", ["ARP 8BIT", "PULSE LD", "STEP LEAD", "CHIP BELL"]),
+    ("loop", "breaks (SLICE)", ["FUNK BREAK", "BACK BREAK", "FAST BREAK", "CHOP"]),
+    ("arp", "plucked", ["NYLON PICK", "KOTO", "SYNTH PLUCK", "SOFT KEYS"]),
+    ("fx", "wind", ["WIND SWEEP", "WIND", "QUANTA", "CAVE WIND"]),
+    ("fx", "rain, ocean", ["OCEAN", "RAIN", "WHISPER", "WIND"]),
+    ("fx", "metal, plasma", ["PLASMA", "WIND SWEEP", "QUANTA", "METAL"]),
+]
+
+
+def main(d, lanes_path=None):
+    rows = list(csv.DictReader(open(Path(d) / "measured.tsv"), delimiter="\t"))
+    lanes = {}
+    if lanes_path:
+        for line in open(lanes_path):
+            p = line.split()
+            if len(p) >= 10 and p[0].isdigit():
+                lanes[(int(p[0]), int(p[1]))] = [int(x) for x in p[-8:]]
+    snd, lists, report, fail = [], [], [], 0
+    for role, colour, names in LISTS:
+        mrole, tmax, (c0, c1), low = RULE[role]
+        cand = []
+        for n in names:
+            for r in rows:
+                if r["name"] != n or r["role"] != mrole:
+                    continue
+                need = 100 + 2 * (float({"drums": -15, "bass": -17, "chords": -21, "lead": -19.5, "arp": -23,
+                                         "fx": -24}[mrole]) - float(r["rms"]))
+                tail = int(r["tail_ms"])
+                why = []
+                if need > 133.0:                   # (up to 3 dB under the role's loudness at LEVEL 127)
+                    why.append(f"too quiet (needs LEVEL {need:.0f})")
+                if tail < 0 or tail > tmax:
+                    why.append(f"tail {tail} ms")
+                if not c0 <= float(r["centroid"]) <= c1:
+                    why.append(f"centroid {r['centroid']} Hz")
+                if float(r["low"]) < low:
+                    why.append(f"low {r['low']}")
+                key = (int(r["engine"]), int(r["preset"]))
+                if why:
+                    report.append(f"  - {n} ({key[0]},{key[1]}): {', '.join(why)}")
+                    continue
+                if key not in [c[0] for c in cand]:
+                    cand.append((key, int(round(min(127.0, max(40.0, need)))), max(0, tail), n))
+                break
+        cand = cand[:4]
+        if len(cand) < (1 if colour == "acid" else 2):   # (ACID: the factory's one acid line)
+            print(f"list '{colour}' ({role}): only {len(cand)} sound(s) fit", file=sys.stderr)
+            fail = 1
+        ids = []
+        for key, lvl, tail, n in cand:
+            for i, s in enumerate(snd):
+                if s[0] == key and s[1] == lvl:
+                    ids.append(i)
+                    break
+            else:
+                snd.append((key, lvl, tail, n, mrole))
+                ids.append(len(snd) - 1)
+        lists.append((role, colour, ids))
+    out = ["/* BEGIN GENERATED by tools/vizzbox_pick.py from tools/vizzbox_sounds' measurements: do not edit */",
+           "static const vb_snd_t VB_SND[] = {"]
+    for (e, p), lvl, tail, n, mrole in snd:
+        out.append(f"    {{{e}, {p}, {lvl}, {min(255, (tail + 15) // 16)}}},   /* {n} ({mrole}) */")
+    out.append("};")
+    out.append("/* each drum kit of VB_SND (its index), its lanes' ring in 32 ms (KICK .. BELL) */")
+    out.append("static const vb_kit_t VB_KIT[] = {")
+    for i, ((e, p), lvl, tail, n, mrole) in enumerate(snd):
+        if mrole == "drums":
+            ln = lanes.get((e, p), [1000] * 8)
+            out.append(f"    {{{i}, {{{', '.join(str(min(255, (x + 31) // 32)) for x in ln)}}}}},   /* {n} */")
+    out.append("};")
+    out.append("static const uint8_t VB_LIST[][4] = {")
+    for i, (role, colour, ids) in enumerate(lists):
+        ids = ids + [0xFF] * (4 - len(ids))
+        out.append(f"    {{{', '.join(str(x) for x in ids)}}},   /* {i} {role}: {colour} */")
+    out.append("};")
+    out.append("/* END GENERATED */")
+    src = TABLES.read_text()
+    src = re.sub(r"/\* BEGIN GENERATED.*?/\* END GENERATED \*/", "\n".join(out), src, flags=re.S)
+    TABLES.write_text(src)
+    print("\n".join(out))
+    if report:
+        print("left out (measured):")
+        print("\n".join(report))
+    return fail
+
+
+if __name__ == "__main__":
+    sys.exit(main(*sys.argv[1:3]))
diff --git a/tools/vizzbox_render.c b/tools/vizzbox_render.c
new file mode 100644
index 0000000..305ecc6
--- /dev/null
+++ b/tools/vizzbox_render.c
@@ -0,0 +1,204 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox) tools/vizzbox_render: a whole song of the producer, as the unit plays it, to a WAV and a Standard MIDI File
+ * (BRIEF-VIZZBOX.md 8). It is the browser emulator's device (web/emu/felucca_web.c: the firmware's sources, the main
+ * loop every 15 ms, the audio ISR every I2S half) built natively with the producer (VIZZBOX=1): the VIZZBOX's knobs set,
+ * PLAY pressed, rendered until the song stops (ENDLESS: for SECS seconds), its tail rung out.
+ *   cc -O2 -ffp-contract=off -w -Ibuild/gen -Ifirmware/src -o build/host/vizzbox_render tools/vizzbox_render.c -lm
+ *   build/host/vizzbox_render GENRE SUBGENRE SEED ENERGY VARIATION LENGTH OUT    (LENGTH 0 SHORT, 1 NORMAL, 2 ENDLESS;
+ *                                                                               SEED in hex; OUT.wav, OUT.mid)
+ * env: SECS=n (ENDLESS's length, default 600), BPM=n (the TEMPO knob), CHAN=1 (sends the six tracks' channels as set).
+ * The MIDI file (format 0, 480 ticks a quarter, the song's tempo as tempo events) holds every channel message the unit
+ * sends over USB, in its order: the notes of T1..T6 on their channels, CC 102 and CC 103 (Vizz) and CC 104..109 on
+ * channel 16; not the realtime bytes (Clock, Start, Stop). Each message's time is the end of the 128-sample I2S half it
+ * was sent in (2.9 ms). Printed: the sections as CC 104 announced them (bar, time), the tempo, the key, the peak and RMS
+ * (dBFS), the voices the budget took (stolen) */
+#define VIZZBOX 1
+#include "../web/emu/felucca_web.c"
+#include <math.h>
+
+static FILE *wav, *mid;
+static uint8_t *mev;                              /* the MIDI track's events */
+static uint32_t mev_n, mev_cap, mev_tick;
+static uint64_t frames;                           /* rendered so far */
+static double peak, sumsq;
+static uint64_t sq_n;
+static double tick_acc;                           /* ticks, fractional */
+
+static void mput(uint8_t b)
+{
+    if (mev_n == mev_cap) {
+        mev_cap = mev_cap ? 2u * mev_cap : 65536u;
+        mev = realloc(mev, mev_cap);
+    }
+    mev[mev_n++] = b;
+}
+static void mvar(uint32_t v)                      /* a variable-length quantity */
+{
+    uint8_t b[5];
+    int n = 0;
+    b[n++] = (uint8_t)(v & 127u);
+    while (v >>= 7)
+        b[n++] = (uint8_t)(0x80u | (v & 127u));
+    while (n--)
+        mput(b[n]);
+}
+static void mevent(uint32_t tick, const uint8_t *d, uint32_t n)
+{
+    uint32_t i;
+    mvar(tick - mev_tick);
+    mev_tick = tick;
+    for (i = 0; i < n; i++)
+        mput(d[i]);
+}
+static void mtempo(uint32_t tick, uint32_t q)     /* q: a quarter's samples */
+{
+    uint32_t us = (uint32_t)((uint64_t)q * 1000000u / FS);
+    uint8_t d[6] = {0xFF, 0x51, 0x03, (uint8_t)(us >> 16), (uint8_t)(us >> 8), (uint8_t)us};
+    mevent(tick, d, 6);
+}
+
+static const char *const SEC[7] = {"(stop)", "INTRO", "GROOVE", "BUILD", "DROP", "BREAK", "OUTRO"};
+static uint32_t cc_last[6];
+static uint32_t cur_q;                            /* a quarter's samples as the sequencer counts them (4 x 1/16) */
+static void drain(void)                           /* the unit's MIDI OUT since the last call, at the current time */
+{
+    uint32_t q = 4u * div_samples(2);
+    if (q != cur_q) {                             /* (the file's tempo: the sequencer's own quarter, so its bars stay on
+                                                   * the file's beats; at 124 BPM 483.81 ms, not 483.87) */
+        cur_q = q;
+        mtempo((uint32_t)tick_acc, q);
+    }
+    while (mo_r != mo_w) {
+        uint32_t pkt = midi_out_q[mo_r % MQ], cin = pkt & 15u, st = (pkt >> 8) & 0xFFu;
+        uint8_t d[3] = {(uint8_t)st, (uint8_t)((pkt >> 16) & 0x7Fu), (uint8_t)((pkt >> 24) & 0x7Fu)};
+        mo_r++;
+        if (cin == 0xFu || st >= 0xF0u)
+            continue;                             /* (realtime: not in a file) */
+        mevent((uint32_t)tick_acc, d, (st & 0xE0u) == 0xC0u ? 2u : 3u);
+        if (st == 0xBFu && d[1] >= 104u && d[1] <= 109u) {
+            cc_last[d[1] - 104u] = d[2];
+            if (d[1] == 107u && !cc_last[2])        /* (a section's first bar) */
+                printf("  %6.1f s  %-6s %3u bars\n", (double)frames / FS, SEC[cc_last[0] % 7u], d[2]);
+        }
+    }
+}
+static void render(uint32_t n)
+{
+    uint32_t k;
+    while (n) {
+        uint32_t m = n < 128u ? n : 128u;
+        web_render(m);
+        for (k = 0; k < m; k++) {
+            float l = out_l[k], r = out_r[k];
+            int16_t s[2] = {(int16_t)(l > 0.99997f ? 32767 : l < -1.0f ? -32768 : lrintf(l * 32767.0f)),
+                            (int16_t)(r > 0.99997f ? 32767 : r < -1.0f ? -32768 : lrintf(r * 32767.0f))};
+            double a = fabs(l) > fabs(r) ? fabs(l) : fabs(r);
+            if (a > peak)
+                peak = a;
+            sumsq += (double)l * l + (double)r * r;
+            sq_n += 2u;
+            if (wav)
+                fwrite(s, sizeof s, 1, wav);
+        }
+        frames += m;
+        tick_acc += (double)m * 480.0 / (double)(cur_q ? cur_q : FS / 2u);
+        drain();
+        n -= m;
+    }
+}
+static void wav_head(FILE *f, uint32_t nframes)
+{
+    uint32_t v;
+    uint16_t a = 1, ch = 2, ba = 4, bits = 16;
+    uint32_t sr = FS, br = FS * 4u;
+    fseek(f, 0, SEEK_SET);
+    fwrite("RIFF", 1, 4, f);
+    v = 36u + nframes * 4u;
+    fwrite(&v, 4, 1, f);
+    fwrite("WAVEfmt ", 1, 8, f);
+    v = 16;
+    fwrite(&v, 4, 1, f);
+    fwrite(&a, 2, 1, f);
+    fwrite(&ch, 2, 1, f);
+    fwrite(&sr, 4, 1, f);
+    fwrite(&br, 4, 1, f);
+    fwrite(&ba, 2, 1, f);
+    fwrite(&bits, 2, 1, f);
+    fwrite("data", 1, 4, f);
+    v = nframes * 4u;
+    fwrite(&v, 4, 1, f);
+}
+static void mid_write(FILE *f)
+{
+    static const uint8_t HD[14] = {'M', 'T', 'h', 'd', 0, 0, 0, 6, 0, 0, 0, 1, 0x01, 0xE0};
+    static const uint8_t EOT[3] = {0xFF, 0x2F, 0x00};
+    uint32_t n;
+    mevent(mev_tick, EOT, 3);
+    n = mev_n;
+    fwrite(HD, 1, 14, f);
+    fwrite("MTrk", 1, 4, f);
+    fputc((int)(n >> 24), f);
+    fputc((int)(n >> 16), f);
+    fputc((int)(n >> 8), f);
+    fputc((int)n, f);
+    fwrite(mev, 1, n, f);
+}
+
+int main(int argc, char **argv)
+{
+    char path[512];
+    uint32_t secs = getenv("SECS") ? (uint32_t)atoi(getenv("SECS")) : 600u, t;
+    if (argc < 8) {
+        fprintf(stderr, "usage: vizzbox_render GENRE SUBGENRE SEED(hex) ENERGY VARIATION LENGTH OUT\n");
+        return 2;
+    }
+    snprintf(path, sizeof path, "%s.wav", argv[7]);
+    wav = fopen(path, "wb");
+    snprintf(path, sizeof path, "%s.mid", argv[7]);
+    mid = fopen(path, "wb");
+    if (!wav || !mid)
+        return 2;
+    wav_head(wav, 0);
+    web_nor_erase();
+    web_boot();
+    usb.config = 1;                               /* (a host is there: the MIDI goes out) */
+    web_master(1023);                             /* (MASTER all the way up) */
+    render(FS * 6u / 10u);
+    mo_r = mo_w;                                  /* (from PLAY on) */
+    vb.k.genre = (uint8_t)atoi(argv[1]);
+    vb.k.sub = (uint8_t)atoi(argv[2]);
+    vb.k.seed = (uint16_t)strtoul(argv[3], 0, 16);
+    vb.k.energy = (uint8_t)atoi(argv[4]);
+    vb.k.var = (uint8_t)atoi(argv[5]);
+    vb.k.len = (uint8_t)atoi(argv[6]);
+    vb.k.bpm = (uint8_t)(getenv("BPM") ? atoi(getenv("BPM")) : 0);
+    frames = 0;
+    peak = sumsq = 0;
+    sq_n = 0;
+    tick_acc = 0;
+    mev_n = mev_tick = 0;
+    cur_q = 0;
+    printf("vizzbox_render: %s / %s, seed %04X, energy %s, variation %s, %s\n", VB_GNAME[vb.k.genre % 10u],
+           VB_SNAME[(vb_sub0(vb.k.genre % 10u) + vb.k.sub) % 36u], vb.k.seed, argv[4], argv[5],
+           vb.k.len == 0 ? "SHORT" : vb.k.len == 1 ? "NORMAL" : "ENDLESS");
+    web_buttons(1u << B_PLAY);
+    render(FS / 20u);
+    web_buttons(0);
+    printf("  tempo %d BPM, key %s %s\n", song.g[G_BPM], N_NOTE[vb.root % 12u], N_SCALE[vb.scale % 16u]);
+    for (t = 0; song.playing && t < secs * 10u; t++)
+        render(FS / 10u);
+    if (song.playing) {                           /* (ENDLESS, or a song longer than SECS: stopped) */
+        web_buttons(1u << B_PLAY);
+        render(FS / 20u);
+        web_buttons(0);
+    }
+    render(FS * 3u);                              /* the tail */
+    printf("  %.1f s, peak %.2f dBFS, RMS %.2f dBFS, voices stolen %u\n", (double)frames / FS,
+           20.0 * log10(peak > 1e-9 ? peak : 1e-9), 10.0 * log10(sq_n ? sumsq / (double)sq_n + 1e-20 : 1e-20),
+           voice_kills);
+    wav_head(wav, (uint32_t)frames);
+    fclose(wav);
+    mid_write(mid);
+    fclose(mid);
+    return 0;
+}
diff --git a/tools/vizzbox_sounds.c b/tools/vizzbox_sounds.c
new file mode 100644
index 0000000..2aa2b5e
--- /dev/null
+++ b/tools/vizzbox_sounds.c
@@ -0,0 +1,261 @@
+/* SPDX-License-Identifier: GPL-3.0-only */
+/* (Vizzbox) tools/vizzbox_sounds: every factory sound played in each producer role as the producer would (BRIEF 3.4:
+ * the sounds chosen by rendering and measuring, not by guessing). The device of the browser emulator built natively
+ * (web/emu/felucca_web.c, VIZZBOX=1), a fresh one for each render (fork), the sound on the role's track as the producer
+ * loads it (producer.c vb_sound), a role's pattern for four bars at 124 BPM (bass: 8ths and a held note in E1 .. E2;
+ * chords: a triad held and as stabs, C3 .. C5; lead: a phrase, C4 .. C6; arp: 16ths of a chord; fx: a held note, an
+ * impact; drums: a groove on every lane), MASTER at half (linear: under the limiter), then until every voice is free.
+ *   build/host/vizzbox_sounds DIR > DIR/sounds.tsv    (a line a sound and role) and DIR/E_P_ROLE.wav
+ *   build/host/vizzbox_sounds DIR LANES > DIR/lanes.tsv    (each kit's lanes: how long a hit holds its voice, ms)
+ * Per line: engine, preset, name, tag, role, RMS and peak (dBFS, as at MASTER full: +6.0 dB), the most voices the track
+ * held at once, the tail (ms: the longest a voice lasted past its note's end, a hit past its strike; -1: one still
+ * sounding 4 s after the pattern) */
+#define VIZZBOX 1
+#include "../web/emu/felucca_web.c"
+#include <math.h>
+#include <unistd.h>
+#include <sys/wait.h>
+
+static const char *const ROLE[NTRK] = {"drums", "bass", "chords", "lead", "arp", "fx"};
+static const char *const TAGN[PT_N] = {"-", "BASS", "LEAD", "PAD", "KEYS", "PLUCK", "DRUM", "FX"};
+
+static void vs_note(step_t *s, uint32_t n, const uint8_t *notes, uint32_t vel)
+{
+    uint32_t i;
+    s->time = ST_NOTE;
+    s->n = (uint8_t)n;
+    for (i = 0; i < n; i++)
+        s->note[i] = notes[i];
+    s->vel = (uint8_t)vel;
+}
+/* the role's test pattern into track k (16 steps; bars 1-2 one way, 3-4 another: LEN 64) */
+static void pattern(uint32_t k)
+{
+    step_t *s = trk[k].step;
+    uint32_t i;
+    for (i = 0; i < NSTEP; i++)
+        step_clear(&s[i]);
+    trk[k].p[P_SLEN] = 64;
+    trk[k].p[P_SDIV] = 2;
+    trk[k].p[P_SGATE] = 96;
+    switch (k) {
+    case R_D:
+        for (i = 0; i < 64u; i++) {
+            if (i % 4u == 0u) s[i].hit |= 1u << 0;
+            if (i % 8u == 4u) s[i].hit |= 1u << 1 | 1u << 2;
+            if (i % 2u == 0u) s[i].hit |= 1u << 3;
+            if (i % 4u == 2u) s[i].hit |= 1u << 4;
+            if (i % 16u == 7u) s[i].hit |= 1u << 5 | 1u << 6;
+            if (i % 32u == 0u) s[i].hit |= 1u << 7;
+            if (s[i].hit) { s[i].time = ST_NOTE; s[i].vel = 100; }
+        }
+        break;
+    case R_B: {
+        static const uint8_t N[4] = {33, 33, 36, 31};
+        for (i = 0; i < 32u; i += 2u) vs_note(&s[i], 1, &N[(i / 8u) & 3u], 100);
+        vs_note(&s[32], 1, &N[0], 104);
+        for (i = 33; i < 48u; i++) s[i].time = ST_TIE;
+        for (i = 48; i < 64u; i += 4u) vs_note(&s[i], 1, &N[1], 96);
+        break;
+    }
+    case R_C: {
+        static const uint8_t C1[3] = {57, 60, 64}, C2[3] = {55, 60, 64};
+        vs_note(&s[0], 3, C1, 90);
+        for (i = 1; i < 16u; i++) s[i].time = ST_TIE;
+        vs_note(&s[16], 3, C2, 90);
+        for (i = 17; i < 32u; i++) s[i].time = ST_TIE;
+        for (i = 34; i < 64u; i += 4u) vs_note(&s[i], 3, (i / 16u) & 1u ? C2 : C1, 90);
+        break;
+    }
+    case R_L: {
+        static const uint8_t M[8] = {69, 72, 74, 72, 76, 74, 72, 67};
+        for (i = 0; i < 8u; i++) {
+            vs_note(&s[i * 8u], 1, &M[i], 100);
+            s[i * 8u + 1u].time = ST_TIE;
+            s[i * 8u + 2u].time = ST_TIE;
+            vs_note(&s[i * 8u + 4u], 1, &M[(i + 3u) & 7u], 90);
+        }
+        break;
+    }
+    case R_A: {
+        static const uint8_t A[4] = {64, 69, 72, 76};
+        for (i = 0; i < 64u; i++) vs_note(&s[i], 1, &A[i & 3u], i % 4u ? 80 : 100);
+        break;
+    }
+    default: {
+        static const uint8_t F[2] = {72, 48};
+        vs_note(&s[0], 1, &F[0], 100);
+        for (i = 1; i < 32u; i++) s[i].time = ST_TIE;
+        vs_note(&s[48], 1, &F[1], 120);
+        break;
+    }
+    }
+}
+static int busy(uint32_t k)
+{
+    uint32_t v, n = 0;
+    for (v = 0; v < NVOICE; v++)
+        n += trk[k].v[v].active && trk[k].v[v].stage != 4u;
+    return (int)n;
+}
+static void measure(uint32_t e, uint32_t pi, uint32_t k, const char *dir)
+{
+    const engine_t *E = ENGINES[e];
+    char path[512];
+    FILE *w;
+    double sum = 0, pk = 0;
+    uint64_t n = 0;
+    uint32_t i, j, vmax = 0, play = 4u * 4u * 4u * div_samples(2), t = 0, freed = 0, tail = 0, rel[NVOICE] = {0}, rmax = 0;
+    uint8_t was[NVOICE] = {0};
+    int16_t pcm[256];
+    vb.root = 0;
+    vb.scale = 2;
+    vb.s.genre = 0;
+    vb.ri = 0;
+    vb_sound(k, e, pi, 100);
+    trk[k].p[P_LEVEL] = 100;
+    trk[k].p[P_DKSRC] = 0;
+    pattern(k);
+    for (i = 0; i < 40u; i++)
+        web_render(128);                           /* (the engine switch's fade) */
+    snprintf(path, sizeof path, "%s/%u_%u_%s.wav", dir, e, pi, ROLE[k]);
+    w = fopen(path, "wb");
+    fseek(w, 44, SEEK_SET);
+    transport_req = 1;
+    for (i = 0; i < (play + 4u * FS) / 128u; i++) {   /* the pattern, then up to 4 s more */
+        web_render(128);
+        for (j = 0; j < 128u; j++) {
+            double l = out_l[j], r = out_r[j], a = fabs(l) > fabs(r) ? fabs(l) : fabs(r);
+            pcm[2 * j] = (int16_t)lrint(l * 32767.0);
+            pcm[2 * j + 1] = (int16_t)lrint(r * 32767.0);
+            if (t + j < play) {
+                sum += l * l + r * r;
+                n += 2;
+            }
+            if (a > pk)
+                pk = a;
+        }
+        fwrite(pcm, 4, 128, w);
+        t += 128u;
+        if ((uint32_t)busy(k) > vmax)
+            vmax = (uint32_t)busy(k);
+        for (j = 0; j < NVOICE; j++) {             /* each voice: from its release (gate off) until it is free */
+            const voice_t *v = &trk[k].v[j];
+            uint32_t st = v->active ? (v->gate ? 2u : 1u) : 0u;
+            if (was[j] == 2u && st == 1u)
+                rel[j] = t;
+            if (was[j] == 1u && st == 0u && (t - rel[j]) * 1000u / FS > rmax)
+                rmax = (t - rel[j]) * 1000u / FS;
+            was[j] = (uint8_t)st;
+        }
+        if (getenv("DEBUG") && i % 50u == 0u)
+            fprintf(stderr, "t %u playing %u busy %d v0 act %u stage %u gate %u env %d\n", t, song.playing, busy(k),
+                    trk[k].v[0].active, trk[k].v[0].stage, trk[k].v[0].gate, trk[k].v[0].env);
+        if (t >= play && song.playing)
+            transport_req = 2;
+        if (t >= play + 2048u && !busy(k)) {
+            freed = 1;
+            tail = rmax > (t - play) * 1000u / FS ? rmax : (t - play) * 1000u / FS;
+            break;
+        }
+    }
+    {   /* the WAV's header */
+        uint32_t frames = t, v;
+        uint16_t a = 1, ch = 2, ba = 4, bits = 16;
+        uint32_t sr = FS, br = FS * 4u;
+        fseek(w, 0, SEEK_SET);
+        fwrite("RIFF", 1, 4, w); v = 36u + frames * 4u; fwrite(&v, 4, 1, w);
+        fwrite("WAVEfmt ", 1, 8, w); v = 16; fwrite(&v, 4, 1, w);
+        fwrite(&a, 2, 1, w); fwrite(&ch, 2, 1, w); fwrite(&sr, 4, 1, w); fwrite(&br, 4, 1, w);
+        fwrite(&ba, 2, 1, w); fwrite(&bits, 2, 1, w);
+        fwrite("data", 1, 4, w); v = frames * 4u; fwrite(&v, 4, 1, w);
+    }
+    fclose(w);
+    printf("%u\t%u\t%s\t%s\t%s\t%.2f\t%.2f\t%u\t%d\n", e, pi, E->presets[pi].name, TAGN[E->presets[pi].tag % PT_N],
+           ROLE[k], 10.0 * log10(sum / (double)(n ? n : 1) + 1e-20) + 6.02, 20.0 * log10(pk + 1e-12) + 6.02, vmax,
+           freed ? (int)tail : -1);
+    fflush(stdout);
+}
+
+/* LANES: each drum kit's lanes, one hit each: the ms until the track's voices are free (the producer's lane decays
+ * on: producer.c vb_sound), a line a kit: engine preset name and the eight */
+static void lanes(void)
+{
+    uint32_t e, pi, l, i;
+    for (e = 0; e < NENGINES; e++)
+        for (pi = 0; ENGINES[e]->oneshot && pi < ENGINES[e]->npresets; pi++) {
+            printf("%u\t%u\t%s", e, pi, ENGINES[e]->presets[pi].name);
+            for (l = 0; l < NLANE; l++) {
+                pid_t p;
+                fflush(stdout);
+                p = fork();
+                if (!p) {
+                    uint32_t t = 0, k;
+                    vb_sound(R_D, e, pi, 100);
+                    for (i = 0; i < 40u; i++)
+                        web_render(128);
+                    for (k = 0; k < NSTEP; k++)
+                        step_clear(&trk[R_D].step[k]);
+                    trk[R_D].step[0].time = ST_NOTE;
+                    trk[R_D].step[0].hit = (uint8_t)(1u << l);
+                    trk[R_D].step[0].vel = 110;
+                    trk[R_D].p[P_SLEN] = 64;
+                    transport_req = 1;
+                    for (i = 0; i < 3000u; i++) {
+                        web_render(128);
+                        t += 128u;
+                        if (t > 1024u && !busy(R_D))
+                            break;
+                    }
+                    printf("\t%u", t * 1000u / FS);
+                    fflush(stdout);
+                    _exit(0);
+                }
+                waitpid(p, 0, 0);
+            }
+            printf("\n");
+        }
+}
+
+int main(int argc, char **argv)
+{
+    uint32_t e, pi, k;
+    if (argc < 2)
+        return 2;
+    web_nor_erase();
+    web_boot();
+    for (k = 0; k < 400u; k++)
+        web_render(128);
+    web_master(724);                               /* (half: 0.5 x full) */
+    for (k = 0; k < 20u; k++)
+        web_render(128);
+    vb_mode = 0;
+    printf("engine\tpreset\tname\ttag\trole\trms\tpeak\tvoices\ttail_ms\n");
+    fflush(stdout);
+    if (argc > 2 && !strcmp(argv[2], "LANES")) {
+        lanes();
+        return 0;
+    }
+    if (getenv("ONE")) {
+        measure((uint32_t)atoi(getenv("ONE")), (uint32_t)atoi(argv[2]), (uint32_t)atoi(argv[3]), argv[1]);
+        return 0;
+    }
+    for (e = 0; e < NENGINES; e++)
+        for (pi = 0; pi < ENGINES[e]->npresets; pi++)
+            for (k = 0; k < NTRK; k++) {
+                pid_t p;
+                if (!eng_allowed(k, e) || e == ENGI_DIGITAL || ENGINES[e]->presets[pi].name == 0)
+                    continue;
+                if ((k == R_D) != (ENGINES[e]->oneshot != 0) || (e == ENGI_SLICE && k != R_A))
+                    continue;                      /* (kits on the drums' track only; SLICE's breaks on the arp's, as
+                                                    * AR_LOOP plays them) */
+                p = fork();
+                if (!p) {
+                    song.g[G_BPM] = 124;
+                    measure(e, pi, k, argv[1]);
+                    _exit(0);
+                }
+                waitpid(p, 0, 0);
+            }
+    return 0;
+}
diff --git a/tools/vizzbox_sounds.py b/tools/vizzbox_sounds.py
new file mode 100644
index 0000000..cd448ff
--- /dev/null
+++ b/tools/vizzbox_sounds.py
@@ -0,0 +1,59 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""(Vizzbox) What each factory sound is like in each producer role: tools/vizzbox_sounds' renders measured (BRIEF 3.4).
+  vizzbox_sounds.py DIR        (DIR: what build/host/vizzbox_sounds DIR wrote: sounds.tsv and the WAVs)
+Adds to each line of DIR/sounds.tsv: the spectral centroid (Hz), the share of the energy below 120 Hz (low) and above
+5 kHz (high), and the level that brings the sound to its role's loudness (P_LEVEL: 112 is 0 dB, a step 0.5 dB) ->
+DIR/measured.tsv. The producer's lists (producer_tables.c VB_SND, VB_LIST) are chosen from it: see CHANGES.md."""
+import csv
+import sys
+import wave
+from pathlib import Path
+
+import numpy as np
+
+# each role's loudness alone at P_LEVEL (RMS over its pattern, dBFS at MASTER full): drums and bass carry the mix, the
+# chords under them, the lead over the chords, the arp and the FX underneath
+TARGET = {"drums": -15.0, "bass": -17.0, "chords": -21.0, "lead": -19.5, "arp": -23.0, "fx": -24.0}
+
+
+def analyse(path):
+    with wave.open(str(path)) as w:
+        x = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16).astype(np.float64) / 32768.0
+    x = x.reshape(-1, 2).mean(axis=1)
+    if not len(x) or not np.any(x):
+        return 0.0, 0.0, 0.0
+    n = 4096
+    frames = [x[i:i + n] * np.hanning(n) for i in range(0, len(x) - n, n // 2)]
+    spec = np.zeros(n // 2 + 1)
+    for f in frames:
+        spec += np.abs(np.fft.rfft(f)) ** 2
+    freqs = np.fft.rfftfreq(n, 1.0 / 44100)
+    tot = spec.sum() + 1e-20
+    cen = float((spec * freqs).sum() / tot)
+    low = float(spec[freqs < 120].sum() / tot)
+    high = float(spec[freqs > 5000].sum() / tot)
+    return cen, low, high
+
+
+def main(d):
+    d = Path(d)
+    rows = list(csv.DictReader(open(d / "sounds.tsv"), delimiter="\t"))
+    out = []
+    for r in rows:
+        cen, low, high = analyse(d / f"{r['engine']}_{r['preset']}_{r['role']}.wav")
+        rms = float(r["rms"])
+        lvl = int(round(100 + 2 * (TARGET[r["role"]] - rms)))
+        r.update(centroid=f"{cen:.0f}", low=f"{low:.2f}", high=f"{high:.2f}", level=str(max(40, min(127, lvl))))
+        out.append(r)
+    keys = list(out[0].keys())
+    with open(d / "measured.tsv", "w", newline="") as f:
+        w = csv.DictWriter(f, keys, delimiter="\t")
+        w.writeheader()
+        w.writerows(out)
+    for r in out:
+        print("\t".join(r[k] for k in keys))
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
