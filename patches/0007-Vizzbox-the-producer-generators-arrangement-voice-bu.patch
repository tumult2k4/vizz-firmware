+    {60, 90, 0, FO_A, 0, 5, G_AMBIENT, 7, BS_SUB, 11, 0, 7, 8, CR_PAD, 4, 21, LS_SPARSE, 26, AR_UP, 31, 36,
+     IO(R_C, R_F, R_L, R_B), 0x0E},
+    {85, 105, 30, FO_V, 0, 0, G_DOWNT, 3, BS_ROOT, 15, 6, 14, 2, CR_PIANO, 4, 19, LS_HOOK, 26, AR_NONE, 34, 36,
+     IO(R_C, R_D, R_B, R_L), 0x14},
+    {70, 80, 30, FO_A, VF_DUB, 1, G_ONEDROP, 7, BS_DUB, 15, 9, 10, 2, CR_SKANK, 3, 22, LS_SPARSE, 26, AR_NONE, 31, 36,
+     IO(R_D, R_B, R_C, R_L), 0x1C},
+    /* HARDSTYLE / HARDCORE */
+    {150, 155, 0, FO_H, VF_4 | VF_KO1 | VF_SIL, 6, G_HARDST, 5, BS_HARD, 13, 1, 5, 2, CR_PAD, 3, 21, LS_BIG, 24, AR_NONE,
+     30, 37, IO(R_D, R_B, R_C, R_L), 0x12},
+    {170, 190, 0, FO_T, VF_4 | VF_KO1 | VF_TAPE, 1, G_GABBER, 5, BS_NONE, 13, 0, 0, 4, CR_NONE, 1, 20, LS_BIG, 24, AR_NONE,
+     30, 37, IO(R_D, R_L, R_F, R_C), 0x11},
+};
+/* each genre's first subgenre (VB_SUB index) */
+static uint32_t vb_sub0(uint32_t g)
+{
+    uint32_t i, n = 0;
+    for (i = 0; i < g && i < 10u; i++)
+        n += VB_NSUB[i];
+    return n;
+}
