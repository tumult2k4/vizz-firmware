 }
 
+/* (Skiff fork, SEQ MIDI OUT) MENU > MIDI > SEQ MIDI OUT, ON by default: what the sequencer plays goes out on USB MIDI as
+ * the keys' notes do, on each track's channel (trk_midi_ch): its notes and drum hits (GM notes, DRUM_LANE_NOTE) with
+ * their velocity (accent 127, ratchets and flams as played), and on entering a step its index as CC SEQ_STEP_CC (0..63,
+ * for a visualizer: where each track is). With the INT clock also MIDI Clock (24 per beat) and Start / Stop, so a host
+ * can follow the tempo. ui_input.c copies the setting here every frame (ui.c SEQOUT_OFF); the audio ISR reads it.
+ * A host that echoes this back into the FM-1 plays every note twice: route it elsewhere */
+#ifndef SKIFF_SEQ_MIDI
+#define SKIFF_SEQ_MIDI 1
+#endif
+#define SEQ_STEP_CC 102u                            /* an undefined controller: harmless to a synth that hears it */
+static volatile uint8_t seq_midi_on = 1;
+#if SKIFF_SEQ_MIDI
+static void seq_midi_note(uint32_t ti, uint32_t note, uint32_t vel)
+{
+    uint32_t mc = trk_midi_ch(ti);
+    if (!seq_midi_on)
+        return;
+    if (vel)
+        midi_out_event(0x09u | (0x90u | mc) << 8 | (note & 0x7Fu) << 16 | (vel & 0x7Fu) << 24);
+    else
+        midi_out_event(0x08u | (0x80u | mc) << 8 | (note & 0x7Fu) << 16);
+}
+static void seq_midi_step(uint32_t ti, uint32_t idx)
+{
+    if (seq_midi_on)
+        midi_out_event(0x0Bu | (0xB0u | trk_midi_ch(ti)) << 8 | SEQ_STEP_CC << 16 | (idx & 0x7Fu) << 24);
+}
+static void seq_midi_alloff(uint32_t ti)            /* CC 123 All Notes Off: a panic dropped notes without their offs */
+{
+    if (seq_midi_on)
+        midi_out_event(0x0Bu | (0xB0u | trk_midi_ch(ti)) << 8 | 123u << 16);
+}
+#if !BOARD_SMK37                                    /* (the SMK sends its own clock to TRS: smk_clk_block) */
+static void seq_midi_rt(uint32_t st)                /* a realtime byte: Clock F8, Start FA, Stop FC (CIN F) */
+{
+    if (seq_midi_on)
+        midi_out_event(0x0Fu | st << 8);
+}
+#else
+#define seq_midi_rt(st) ((void)0)
+#endif
+#else
+#define seq_midi_note(ti, note, vel) ((void)0)
+#define seq_midi_step(ti, idx) ((void)0)
+#define seq_midi_rt(st) ((void)0)
+#define seq_midi_alloff(ti) ((void)0)
+#endif
+
