 {
     vb_mode = !(CPU2_BYTE & VB_MODE_BIT);
@@ -91,17 +92,114 @@ static vb_favs_t vb_fav __attribute__((section(".pool")));
 static uint8_t vb_fav_dirty __attribute__((section(".pool")));   /* changed: to be written once stopped */
 static uint8_t vb_fav_at __attribute__((section(".pool")));      /* the copy that holds the newest */
 static uint32_t vb_fav_crc(const vb_favs_t *f) { return st_crc32(f, (uint32_t)((const uint8_t *)&f->crc - (const uint8_t *)f)); }
+/* (1.1, BRIEF-VIZZBOX-1.1.md 3.9) what of the song the user had taken, kept with a favourite: a track's sound (a factory
+ * preset: its engine and preset; a user sound: its slot, so what lies there now plays), the eight of its parameters
+ * turned last, the buses. After the record in the same sectors (VB_XOFF), which the Vizzbox 1.0 never reads (it reads
+ * its record alone; Skiff 2.0.1 and Vizz 2.0 not even that): an entry a favourite with the song it goes with and a CRC
+ * of its own, so it counts while its favourite is that song, in either copy (one the 1.0 saved over has none). All
+ * zero: nothing taken, the favourite as in 1.0. Written with the record, while stopped */
+#define VB_XOFF 0x100u
+#define VB_NG 12u
+typedef struct {
+    vb_song_t r;                                    /* the favourite's song */
+    uint8_t eng[NTRK], pre[NTRK];                   /* the sound: engine + 1 and its preset; 0x80 the user sound in
+                                                     * slot pre; 0 none */
+    uint8_t id[NTRK][8];                            /* the parameters + 1, the latest first; 0 none */
+    int16_t v[NTRK][8];
+    uint32_t glo;                                   /* the buses: the globals of these bits, their values in g */
+    int16_t g[VB_NG];
+    uint32_t crc;
+} vb_xfav_t;
+_Static_assert(sizeof(vb_favs_t) <= VB_XOFF && VB_XOFF + VB_NFAV * sizeof(vb_xfav_t) <= ST_SECTOR, "a favourites' sector");
+static vb_xfav_t vb_xf[VB_NFAV] __attribute__((section(".vbox")));   /* (after .bss: vb_fav_load sets it) */
+static uint32_t vb_xcrc(const vb_xfav_t *x) { return st_crc32(x, sizeof *x - 4u) ^ 0x31584256u; }
 static void vb_fav_load(void)
 {
     vb_favs_t b;
-    uint32_t c;
+    vb_xfav_t x;
+    uint32_t c, i;
     memset(&vb_fav, 0xFF, sizeof vb_fav);
+    memset(vb_xf, 0, sizeof vb_xf);
     for (c = 0; c < 2u; c++)
         if (!st_read(VB_FAV_OFF + c * ST_SECTOR, &b, sizeof b) && b.magic == VB_FMAGIC && b.crc == vb_fav_crc(&b) &&
             (vb_fav.magic != VB_FMAGIC || b.seq - vb_fav.seq < 0x80000000u)) {
             vb_fav = b;
             vb_fav_at = (uint8_t)c;
         }
+    for (c = 0; c < 2u; c++)                        /* (the newer copy's last: it counts) */
+        for (i = 0; i < VB_NFAV; i++)
+            if (!st_read(VB_FAV_OFF + (c ^ vb_fav_at ^ 1u) * ST_SECTOR + VB_XOFF + i * sizeof x, &x, sizeof x) &&
+                x.crc == vb_xcrc(&x) && !memcmp(&x.r, &vb_fav.f[i], sizeof x.r))
+                vb_xf[i] = x;
+}
+/* favourite n: what the user has taken now, with its song */
+static void vb_xsave(uint32_t n)
+{
+    vb_xfav_t *x = &vb_xf[n];
+    const track_t *t;
+    uint32_t k, i, j, c, any = 0;
+    memset(x, 0, sizeof *x);
+    for (k = 0, t = trk; vb.own && k < NTRK; k++, t++) {
+        if ((vb_hand.snd >> k) & 1u) {
+            x->eng[k] = (uint8_t)(t->user ? 0x80u : t->eng_req + 1u);
+            x->pre[k] = (uint8_t)(t->user ? t->user - 1u : t->preset);
+        }
+        for (i = j = 0; i < 8u; i++)
+            if ((c = vb_hand.last[k][i]) != 0u && vb_mine(k, c - 1u)) {
+                x->id[k][j] = (uint8_t)c;
+                x->v[k][j++] = t->p[c - 1u];
+            }
+    }
+    for (i = j = 0; vb.own && i < G_COUNT && j < VB_NG; i++)
+        if ((vb_hand.glo >> i) & 1u) {
+            x->glo |= 1u << i;
+            x->g[j++] = song.g[i];
+        }
+    for (i = 0; i < sizeof *x - 4u; i++)
+        any |= ((const uint8_t *)x)[i];
+    if (any) {                                      /* (nothing taken: none, crc 0) */
+        x->r = vb_fav.f[n];
+        x->crc = vb_xcrc(x);
+    }
+}
+/* favourite n's: on the tracks it took, its sound and parameters in place of what the user had there, theirs again (a
+ * user sound's slot now empty: the producer's sound); its buses */
+static void vb_xload(uint32_t n)
+{
+    const vb_xfav_t *x = &vb_xf[n];
+    track_t *t;
+    uint32_t k, i, j, sel = song.sel;
+    for (k = 0, t = trk; k < NTRK; k++, t++) {
+        if (!x->eng[k] && !x->id[k][0])
+            continue;
+        vb_back(1u << k);
+        sel_set(k);
+        if (x->eng[k] == 0x80u)
+            (void)up_load(x->pre[k]);
+        else if (x->eng[k] && (x->eng[k] - 1u == t->eng_req || !select_engine(x->eng[k] - 1u)))
+            apply_preset(x->pre[k]);
+        sel_set(sel);
+        for (j = 8u; j--;)                          /* (the oldest first: the list as it was) */
+            if ((i = x->id[k][j]) != 0u) {
+                const param_desc_t *d = track_desc(t, i - 1u);
+                t->p[i - 1u] = (int16_t)clamp(x->v[k][j], d->min, d->max);
+                vb_grab(k, i - 1u);
+            }
+    }
+    for (i = j = 0; i < G_COUNT; i++)
+        if ((x->glo >> i) & 1u) {
+            song.g[i] = x->g[j++];
+            vb_hand.glo |= 1u << i;
+        }
+    sync_reload = 1;
+}
+/* (vb_take) favourite + 1 loaded while the GROOVEBOX played: what it took, once the tracks are the producer's */
+static uint8_t vb_xwait __attribute__((section(".pool")));
+static void vb_xtake(void)
+{
+    if (vb_xwait && vb_xf[vb_xwait - 1u].crc)
+        vb_xload(vb_xwait - 1u);
+    vb_xwait = 0;
 }
 static void vb_fav_poll(void)
 {
@@ -113,7 +211,7 @@ static void vb_fav_poll(void)
     vb_fav.magic = VB_FMAGIC;
     vb_fav.crc = vb_fav_crc(&vb_fav);
     off = VB_FAV_OFF + (vb_fav_at ^ 1u) * ST_SECTOR;
-    if (st_erase(off) || st_prog(off, &vb_fav, sizeof vb_fav))
+    if (st_erase(off) || st_prog(off, &vb_fav, sizeof vb_fav) || st_prog(off + VB_XOFF, vb_xf, sizeof vb_xf))
         ui_message("SAVE ERROR");
     else
         vb_fav_at ^= 1u;
@@ -228,10 +326,15 @@ static void vb_white(uint32_t pressed)
             continue;
         if (save) {
             vb_fav.f[n] = vb.own && song.playing ? vb.s : vb.k;
+            vb_xsave(n);
             vb_fav_dirty = 1;
             str_cpy(b, "FAVOURITE    SAVED", sizeof b);
         } else if (vb_fav.f[n].genre < 10u) {
             vb.k = vb_fav.f[n];
+            if (vb_xf[n].crc && !vb.own && song.playing)
+                vb_xwait = (uint8_t)(n + 1u);
+            else if (vb_xf[n].crc && vb_ready())
+                vb_xload(n);
             if (vb.own && song.playing)
                 vb.chg |= 7u;
             else
@@ -562,7 +665,7 @@ static void vb_favs(int32_t y)
     for (i = 0; i < VB_NFAV; i++) {
         const vb_song_t *f = &vb_fav.f[i];
         p = vb_num(b, i + 1u);
-        *p++ = ' ';
+        *p++ = vb_xf[i].crc ? '+' : ' ';             /* ((1.1) +: with sounds) */
         str_cpy(p, f->genre < 10u ? VB_SNAME[vb_ri(f)] : "-", 18);
         cv_text(8 + 116 * (int32_t)(i / 8u), y + 14 + 12 * (int32_t)(i % 8u), &AF_S, b, f->genre < 10u ? T_TEXT : T_DIM);
     }
diff --git a/tests/producer_test.c b/tests/producer_test.c
