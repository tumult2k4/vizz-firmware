+}
+typedef struct { vb_song_t want; uint32_t e, pr, id, ue; int16_t v, mix; } fb_t;
+static fb_t fb;
+/* case_fav_sounds's other half, a process of its own: the device booting on the flash in file f (fb after it) */
+static int fav_boot(const char *f)
+{
+    static const uint8_t ARP_P[10] = {P_ATK, P_DEC, P_SUS, P_REL, P_DIST, P_CHOR, P_DLY, P_REV, P_GLIDE, P_PAN};
+    FILE *fp = fopen(f, "rb");
+    uint32_t i, e, pr, id, ue;
+    int16_t v, mix;
+    vb_song_t want;
+    snprintf(tag, sizeof tag, "favourites with sounds: off and on");
+    if (!fp || fread(nor, 1, sizeof nor, fp) != sizeof nor || fread(&fb, 1, sizeof fb, fp) != sizeof fb)
+        return 2;
+    fclose(fp);
+    want = fb.want, e = fb.e, pr = fb.pr, id = fb.id, ue = fb.ue, v = fb.v, mix = fb.mix;
+    web_boot();
+    usb.config = 1;
+    web_master(1023);
+    run_s(0.6);
+    knobs(0, 0, 0x1111u, 90, 90, 1);
+    ok(!vb_hand.snd && !vb_hand.glo, "a fresh device: a hand");
+    sv_key(1u << B_GLO, 2);
+    ok(!memcmp(&vb.k, &want, sizeof want), "GLO + white key 3: not the song");
+    ok(vb.own && trk[R_L].eng_req == e && trk[R_L].preset == pr && ((vb_hand.snd >> R_L) & 1u),
+       "LEAD: not the favourite's sound, the user's (%u %u, was %u %u)", trk[R_L].eng_req, trk[R_L].preset, e, pr);
+    ok(trk[R_L].p[id] == v && vb_mine(R_L, id), "LEAD: LIVE KNOB 1 %d, kept %d", trk[R_L].p[id], v);
+    ok(trk[R_C].user == 6u && trk[R_C].eng_req == ue && ((vb_hand.snd >> R_C) & 1u), "CHORDS: not slot 6");
+    ok(song.g[G_DMIX] == mix && ((vb_hand.glo >> G_DMIX) & 1u), "the delay's MIX %d, kept %d", song.g[G_DMIX], mix);
+    for (i = 2u; i < 10u; i++)
+        ok(vb_mine(R_A, ARP_P[i]), "ARP %u: not the user's", ARP_P[i]);
+    ok(!vb_mine(R_A, ARP_P[0]) && !vb_mine(R_A, ARP_P[1]), "ARP: more than eight");
+    for (i = 0; i < NTRK; i++)
+        if (i != R_L && i != R_C)
+            ok(!((vb_hand.snd >> i) & 1u), "T%u's sound the user's", i + 1u);
+    press(1u << B_PLAY);
+    run_s(2.0);
+    web_enc(EN_K1, 1);                              /* a new style */
+    run_s(0.1);
+    ok(new_style(200.0), "no new style came");
+    ok(trk[R_L].eng_req == e && trk[R_L].preset == pr && trk[R_L].p[id] == v && trk[R_C].user == 6u &&
+       song.g[G_DMIX] == mix, "a new style over the favourite's");
+    printf("producer: %-40s %u checks, %d failed\n", tag, nchecks, fails);
+    return fails ? 1 : 0;
+}
+/* (1.1, 3.9) favourites with sounds: LEAD's sound chosen on KLANG (PRESETS), its LIVE KNOB 1 turned; CHORDS a user
+ * sound (slot 6, as PRESETS loads it); the delay's MIX on GLO; ARP ten parameters turned. SAVE + white key 3 keeps
+ * them with the song: the 1.0's record as it was, an entry after it (ARP: its eight latest). Off and on, a fresh
+ * device on that flash: GLO + white key 3 puts the song on the knobs and those sounds, values and the bus on the
+ * tracks, the user's (a new style leaves them). Then: a favourite with nothing taken leaves the hand as it is (as in
+ * 1.0); slot 6 holding another sound now: the favourite plays that one */
+static void case_fav_sounds(void)
+{
+    static const uint8_t ARP_P[10] = {P_ATK, P_DEC, P_SUS, P_REL, P_DIST, P_CHOR, P_DLY, P_REV, P_GLIDE, P_PAN};
+    uint32_t e, pr, id, i, ue, sel;
+    int16_t v, mix;
+    vb_song_t want;
+    snprintf(tag, sizeof tag, "favourites with sounds");
+    boot();
+    sel = song.sel;
+    sel_set(R_C);                                   /* (slot 6: the GROOVEBOX's T3 sound) */
+    ok(up_store(5, "PADX") == 0, "slot 6 not stored");
+    ue = trk[R_C].eng_req;
+    sel_set(sel);
+    knobs(2, 1, 0x7777u, 60, 40, 1);
+    press(1u << B_PLAY);
+    run_s(4.0);
+    press(1u << B_EDIT);                            /* KLANG, LEAD */
+    web_enc(EN_PRESET, 2);
+    run_s(0.3);
+    e = trk[R_L].eng_req;
+    pr = trk[R_L].preset;
+    id = vb_live.id[0];
+    web_enc(EN_K1, 5);
+    run_s(0.2);
+    v = trk[R_L].p[id];
+    sel_set(R_C);                                   /* CHORDS: the user sound (PRESETS: ui.c preset_go) */
+    ok(up_load(5) == 0, "slot 6 not loaded");
+    sel_set(R_L);
+    web_buttons(1u << B_GLO);                       /* the delay's MIX */
+    run_s(0.8);
+    web_enc(EN_K1, 6);
+    run_s(0.1);
+    web_buttons(0);
+    run_s(0.1);
+    mix = song.g[G_DMIX];
+    for (i = 0; i < 10u; i++) {                     /* ARP: ten turned (motion.c's way), the latest eight kept */
+        trk[R_A].p[ARP_P[i]] = (int16_t)(trk[R_A].p[ARP_P[i]] + (trk[R_A].p[ARP_P[i]] > 10 ? -3 : 3));
+        motion_capture(&trk[R_A], ARP_P[i], trk[R_A].p[ARP_P[i]]);
+    }
+    ok(vb_hand.snd == (1u << R_L | 1u << R_C) && ((vb_hand.glo >> G_DMIX) & 1u) && vb_mine(R_L, id),
+       "the hand before: %02x %08x", vb_hand.snd, vb_hand.glo);
+    sv_key(1u << B_SAVE, 2);
+    want = vb_fav.f[2];
+    ok(vb_xf[2].eng[R_L] == e + 1u && vb_xf[2].pre[R_L] == pr && vb_xf[2].eng[R_C] == 0x80u && vb_xf[2].pre[R_C] == 5u &&
+       !vb_xf[2].eng[R_B], "the sounds not kept: LEAD %02x %u, CHORDS %02x %u", vb_xf[2].eng[R_L], vb_xf[2].pre[R_L],
+       vb_xf[2].eng[R_C], vb_xf[2].pre[R_C]);
+    for (i = 0; i < 8u; i++)
+        ok(vb_xf[2].id[R_A][i] == ARP_P[9u - i] + 1u, "ARP's eight: %u. %u", i, vb_xf[2].id[R_A][i]);
+    press(1u << B_PLAY);                            /* STOP: written */
+    run_s(0.5);
+    {   /* the 1.0's reading: its record, its CRC, the song in it */
+        vb_favs_t r;
+        memcpy(&r, nor + 0x95000u + vb_fav_at * 0x1000u, sizeof r);
+        ok(r.magic == VB_FMAGIC && r.crc == vb_fav_crc(&r) && !memcmp(&r.f[2], &want, sizeof want),
+           "the 1.0's record: not as it was");
+    }
+    {   /* off and on: a new process, a device booting on that flash (tests: fav_boot) */
+        char path[] = "/tmp/vbfavXXXXXX";
+        int fd = mkstemp(path), st = 1;
+        pid_t pid;
+        fb = (fb_t){want, e, pr, id, ue, v, mix};
+        if (fd < 0 || write(fd, nor, sizeof nor) != (ssize_t)sizeof nor || write(fd, &fb, sizeof fb) != (ssize_t)sizeof fb)
+            ok(0, "no file for the flash");
+        if (fd >= 0)
+            close(fd);
+        fflush(stdout);
+        if (!(pid = fork())) {
+            execl("/proc/self/exe", "producer_test", "fav_boot", path, (char *)0);
