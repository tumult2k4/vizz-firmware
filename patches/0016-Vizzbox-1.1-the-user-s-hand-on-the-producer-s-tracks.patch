+}
+/* a parameter turned: by a CC through Skiff's map (CC 91 REVERB on T3's channel), a knob in the GROOVEBOX. The
+ * producer's moves leave it (its CHORDS' reverb each bar, more in a BREAK), go on with the others (the FX track's
+ * level); a new style keeps it; HOME + EDIT gives it back */
+static void case_hand_param(void)
+{
+    uint32_t i, kept = 1, moved = 0, id;
+    int16_t lv = 0, v;
+    snprintf(tag, sizeof tag, "hand: parameter");
+    boot();
+    knobs(0, 1, 0x1234u, 70, 40, 1);
+    press(1u << B_PLAY);
+    run_s(5.0);
+    web_midi(0xB2, 91, 100);                         /* CC 91 on channel 3: T3's REVERB */
+    run_s(0.1);
