+    ok(v == TP[P_REV].min + (100 * (TP[P_REV].max - TP[P_REV].min) + 63) / 127, "CC 91 100: T3's REVERB %d", v);
+    for (i = 0; i < 400u; i++) {                     /* 100 s: sections, a BREAK */
+        run_s(0.25);
+        kept &= trk[R_C].p[P_REV] == v;
+        moved += trk[R_F].p[P_LEVEL] != lv;
+        lv = trk[R_F].p[P_LEVEL];
+    }
+    ok(kept, "T3's REVERB moved by the producer (%d, was %d)", trk[R_C].p[P_REV], v);
+    ok(moved > 10u, "the FX track's level stood still (%u moves)", moved);
+    combo(1u << B_HOME, 1u << B_PLAY);              /* the GROOVEBOX: T2's HOME KNOB 1 */
+    while (song.sel != R_B) {
+        web_enc(EN_ALGO, song.sel > R_B ? -1 : 1);
+        run_s(0.05);
+    }
+    id = ENGINES[trk[R_B].eng_req % NENGINES]->knob[0];
+    web_enc(EN_K1, 5);
+    run_s(0.2);
+    ok(vb_mine(R_B, id), "HOME's KNOB 1 in the GROOVEBOX: not the user's");
+    combo(1u << B_HOME, 1u << B_PLAY);
+    web_enc(EN_K2, 1);                               /* SUBGENRE: a new style */
+    run_s(0.1);
+    ok(new_style(200.0), "no new style came");
+    ok(trk[R_C].p[P_REV] == v, "a new style took T3's REVERB");
+    combo(1u << B_HOME, 1u << B_EDIT);
+    ok(!vb_mine(R_C, P_REV) && !vb_mine(R_B, id), "HOME + EDIT: not back");
+    run_s(5.0);
+    ok(trk[R_C].p[P_REV] != v, "given back: the producer leaves T3's REVERB as the user had it");
+}
+/* the FX layer's FILTER held over the producer's sweep (in the GROOVEBOX, where its layers are): the user's value while
+ * held, then back over RETURN and on from there, no jump; LFO held (MOMENTARY) on the FX track's level the same; an
+ * effect the user holds: none of the producer's then */
+static void case_hand_perf(void)
+{
+    uint32_t i, k, fx = 0, prod = 0;
+    int32_t was, d, maxd = 0;
+    int16_t u;
+    snprintf(tag, sizeof tag, "hand: FX layer");
+    boot();
+    knobs(0, 1, 0x1234u, 70, 40, 1);
+    press(1u << B_PLAY);
+    for (i = 0; i < 2400u && !(vb_cur()->type == VS_BUILD && vb.sbar >= 1u); i++)
+        run_s(0.05);
+    ok(vb_cur()->type == VS_BUILD, "no BUILD in 2 min");
+    combo(1u << B_HOME, 1u << B_PLAY);
+    web_buttons(1u << B_FX);
+    run_s(0.7);
+    ok(layer_open() == LAYER_FX, "FX held: no layer");
+    web_enc(EN_K1, -40);
+    run_s(0.1);
+    u = perf_k[0];
+    for (i = 0; i < 40u; i++) {
+        run_s(0.05);
+        ok(perf_k[0] == u, "held: FILTER %d, the user's %d", perf_k[0], u);
+        if (perf_k[0] != u)
+            break;
+    }
+    web_buttons(0);
+    was = perf_k[0];
+    for (i = 0; i < 200u; i++) {                     /* back over RETURN, then the producer's line */
+        run_s(0.02);
+        d = perf_k[0] - was;
+        d = d < 0 ? -d : d;
+        maxd = d > maxd ? d : maxd;
+        was = perf_k[0];
+    }
+    ok(maxd <= 12, "let go: FILTER jumped by %d", (int)maxd);
+    ok(perf_k[0] > 0, "let go: the producer's HPF sweep not back (%d)", perf_k[0]);
+    for (k = 0; k < 27u && !(!key_black(k) && key_place(k) == PF_GATE); k++)
+        ;
+    web_buttons(1u << B_FX);                         /* GATE held through the BUILD's end */
+    run_s(0.1);
+    web_keys(1u << k);
+    for (i = 0; i < 600u && vb_cur()->type == VS_BUILD; i++) {
+        run_s(0.01);
+        fx |= perf_held & (PF_BIT(PF_M1) - 1u);
+        prod |= vb_fxon;
+    }
+    web_keys(0);
+    web_buttons(0);
+    run_s(0.2);
+    ok(fx == PF_BIT(PF_GATE), "the user's GATE held: other effects %05x", fx);
+    ok(!prod, "the user's GATE held: the producer held its own");
+    ok(!perf_held, "let go: effects still held %05x", perf_held);
+    ok(voice_kills == 0, "%u voices stolen", voice_kills);
+}
+/* the notes do not hang on the hand: the same song with and without a sound chosen, a parameter turned; what differs
+ * can only be notes missing (the voice budget thinning), never other ones */
+typedef struct { uint32_t n; uint64_t t[6000]; uint8_t ch[6000], note[6000]; } notes_t;
+static void notes_run(void *a)
+{
+    notes_t *o = a;
+    uint32_t i;
+    boot();
+    knobs(5, 1, 0x7777u, 90, 60, 1);
+    press(1u << B_PLAY);
+    run_s(8.0);
+    if (o->n) {                                      /* (the run with the hand) */
+        web_midi(0xC1, 5, 0);                        /* T2 another sound, T4's cutoff, T3's reverb */
+        web_midi(0xB3, 74, 20);
+        web_midi(0xB2, 91, 127);
+    }
+    run_s(80.0);
+    o->n = 0;
+    for (i = 0; i < nev && o->n < 6000u; i++)
+        if ((ev[i].st & 0xF0u) == 0x90u && ev[i].d2) {
+            o->t[o->n] = ev[i].t;
+            o->ch[o->n] = ev[i].st & 15u;
+            o->note[o->n++] = ev[i].d1;
+        }
+}
+static void case_hand_notes(void)
+{
+    static notes_t a, b;
+    uint32_t i, j = 0, other = 0;
+    snprintf(tag, sizeof tag, "hand: the notes");
+    a.n = 0;
+    b.n = 1;
+    ok(!spawn(notes_run, &a, sizeof a) && !spawn(notes_run, &b, sizeof b), "no answer");
+    for (i = 0; i < b.n; i++) {                      /* every note of the run with the hand in the one without */
+        while (j < a.n && a.t[j] < b.t[i])
+            j++;
+        {
+            uint32_t m = j, hit = 0;
+            for (; m < a.n && a.t[m] == b.t[i]; m++)
+                hit |= a.ch[m] == b.ch[i] && a.note[m] == b.note[i];
+            other += !hit;
+        }
