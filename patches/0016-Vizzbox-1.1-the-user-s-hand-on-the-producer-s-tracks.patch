+static void vb_hs_get(void)
+{
+    uint32_t k, i;
+    if (!vb_hs_ok)
+        return;
+    vb_hs_ok = 0;
+    fm1_irq_off();
+    for (k = 0; k < NTRK; k++) {
+        track_t *t = &trk[k];
+        for (i = 0; i < P_COUNT; i++)
+            if (vb_mine(k, i) || ((vb_hand.snd >> k) & 1u))
+                t->p[i] = vb_hs.p[k][i];
+        if ((vb_hand.snd >> k) & 1u) {
+            t->eng_req = vb_hs.eng[k];
+            t->preset = vb_hs.pre[k];
+            t->user = vb_hs.usr[k];
+            fm6_set_patch(k, vb_hs.fm[k]);
+            panic_req |= (uint8_t)(1u << k);
