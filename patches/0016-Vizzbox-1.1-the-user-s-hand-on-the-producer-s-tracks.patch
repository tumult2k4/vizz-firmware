+/* ---------------------------------------------------------------- (1.1) the user's hand (BRIEF-VIZZBOX-1.1.md 2) */
+static void combo(uint32_t held, uint32_t then)     /* held down, then the other too, both let go */
+{
+    web_buttons(held);
+    run_s(0.06);
+    web_buttons(held | then);
+    run_s(0.06);
+    web_buttons(0);
+    run_s(0.05);
+}
+static void black_with(uint32_t held, uint32_t place)   /* a button held + the black key of a place (0 .. 5) */
+{
+    uint32_t k;
+    for (k = 0; k < 27u && !(key_black(k) && key_place(k) == place); k++)
+        ;
+    web_buttons(held);
+    run_s(0.06);
+    web_keys(1u << k);
+    run_s(0.06);
+    web_keys(0);
+    run_s(0.04);
+    web_buttons(0);
+    run_s(0.05);
+}
+static int on_sound(uint32_t k)                     /* track k has the producer's sound for its role now */
+{
+    const vb_snd_t *d = &VB_SND[vb.snd[k] % NELEM(VB_SND)];
+    return trk[k].eng_req == d->eng % NENGINES && trk[k].preset == vb_pre(d->eng % NENGINES, d->pre) && !trk[k].user;
+}
+static int new_style(double max_s)                  /* a new style came in (its sounds on the tracks: vb_swap) */
+{
+    uint32_t ri = vb.ri;
+    double t;
+    for (t = 0; t < max_s && vb.ri == ri; t += 0.25)
+        run_s(0.25);
+    vb_swapped = 0;
+    for (; t < max_s + 10.0 && !vb_swapped; t += 0.05)
+        run_s(0.05);
+    run_s(0.2);
+    return vb.ri != ri;
+}
+/* a sound chosen: in the GROOVEBOX while it plays (PRESETS), by a MIDI Program Change. It stays over bars, sections, a
+ * new style, a favourite, ENDLESS's next subgenre, STOP and PLAY; HOME + its black key gives it back (the producer's
+ * sound now), HOME + EDIT every track */
+static void case_hand_sound(void)
+{
+    uint32_t e, pr, i;
+    snprintf(tag, sizeof tag, "hand: sound");
+    boot();
+    knobs(0, 1, 0x1234u, 70, 40, 1);
+    press(1u << B_PLAY);
+    run_s(10.0);
+    combo(1u << B_HOME, 1u << B_PLAY);              /* the GROOVEBOX, playing on */
+    ok(!vb_mode && song.playing, "into the GROOVEBOX: stopped");
+    while (song.sel != R_C) {
+        web_enc(EN_ALGO, song.sel > R_C ? -1 : 1);
+        run_s(0.05);
+    }
+    web_enc(EN_PRESET, 3);                           /* T3: another sound */
+    run_s(0.3);
+    e = trk[R_C].eng_req;
+    pr = trk[R_C].preset;
+    ok(vb_hand.snd == 1u << R_C, "PRESETS in the GROOVEBOX: the hand %02x", vb_hand.snd);
+    combo(1u << B_HOME, 1u << B_PLAY);              /* back */
+    ok(vb_mode, "back: not the VIZZBOX");
+    web_midi(0xC4, 2, 0);                            /* T5 (channel 5): a Program Change */
+    run_s(0.3);
+    ok(vb_hand.snd == (1u << R_C | 1u << R_A), "Program Change: the hand %02x", vb_hand.snd);
+    run_s(40.0);
+    ok(trk[R_C].eng_req == e && trk[R_C].preset == pr, "T3's sound went over the bars and sections");
+    web_enc(EN_K1, 1);                               /* GENRE: a new style */
+    run_s(0.1);
+    ok(new_style(200.0), "no new style came");
+    ok(trk[R_C].eng_req == e && trk[R_C].preset == pr, "a new style took T3's sound");
+    for (i = 0; i < NTRK; i++)
+        if (i != R_C && i != R_A)
+            ok(on_sound(i), "a new style: T%u not its sound", i + 1u);
+    ok(trk[R_C].p[P_SCALE] == vb.scale && trk[R_C].p[P_ROOT] == vb.root, "T3: not the song's key for the keys");
+    press(1u << B_PLAY);                             /* STOP, PLAY */
+    run_s(1.0);
+    press(1u << B_PLAY);
+    run_s(2.0);
+    ok(trk[R_C].eng_req == e && trk[R_C].preset == pr, "STOP and PLAY took T3's sound");
+    vb.sub_len = 0;                                  /* ENDLESS: its next subgenre after this DROP */
+    vb.s.len = vb.k.len = VL_ENDLESS;
+    ok(new_style(400.0), "ENDLESS: no next subgenre");
+    ok(trk[R_C].eng_req == e && trk[R_C].preset == pr, "ENDLESS's next subgenre took T3's sound");
+    black_with(1u << B_HOME, R_C);                   /* HOME + the third black key: T3 back */
+    ok(!(vb_hand.snd & 1u << R_C) && on_sound(R_C), "HOME + black key 3: T3 not back (hand %02x)", vb_hand.snd);
+    ok(!ui.menu && song.playing, "HOME + a black key: the MENU, or stopped");
+    ok((vb_hand.snd & 1u << R_A) != 0u, "HOME + black key 3 gave T5 back");
+    combo(1u << B_HOME, 1u << B_EDIT);               /* HOME + EDIT: all */
+    ok(!vb_hand.snd && on_sound(R_A), "HOME + EDIT: T5 not back");
+    ok(voice_kills == 0, "%u voices stolen", voice_kills);
+}
+/* the hand over a stay in the GROOVEBOX, stopped: its own music there meanwhile, the user's sound back at PLAY */
+static void case_hand_trip(void)
+{
+    uint32_t e, pr, ge, gp;
+    snprintf(tag, sizeof tag, "hand: the GROOVEBOX between");
