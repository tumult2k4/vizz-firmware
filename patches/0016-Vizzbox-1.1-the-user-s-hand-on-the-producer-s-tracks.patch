+static uint8_t vb_hs_ok __attribute__((section(".pool")));
+static void vb_hs_put(void)
+{
+    uint32_t k;
+    for (k = 0; k < NTRK; k++) {
+        memcpy(vb_hs.p[k], trk[k].p, sizeof vb_hs.p[k]);
+        vb_hs.eng[k] = trk[k].eng_req;
