+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""(Vizzbox) The demos (BRIEF-VIZZBOX.md 8): every subgenre's song rendered as the unit plays it (tools/vizzbox_render,
+LENGTH NORMAL), a part of about 60 s from a BUILD into its DROP as MP3 (128 kbps, ffmpeg), the whole song's MIDI file,
+and what can be measured checked on each: no clipping, the loudness, the notes outside the key, the sections, kick and
+bass not on top of each other all the time, the jump into the DROP, the silence before it, the riser in the BUILD.
+  vizzbox_demos.py RENDER OUT [SEED] [ENERGY] [VARIATION] [G S ...]
+RENDER: build/host/vizzbox_render; OUT: the demos' directory (OUT/README.md, OUT/NN-genre-subgenre.mp3 / .mid; the
+renders in OUT/.work, removed unless KEEP=1). SEED (hex, default 5EED), ENERGY 70, VARIATION 40; G S: only those.
+The table it prints (and writes into OUT/README.md between its GENERATED markers) is the demos' list."""
+import os
+import re
+import shutil
+import struct
+import subprocess
+import sys
+import wave
+from concurrent.futures import ThreadPoolExecutor
+from pathlib import Path
+
+import numpy as np
+
+NSUB = [6, 6, 3, 4, 3, 4, 2, 3, 3, 2]
+SEC = {"INTRO": 1, "GROOVE": 2, "BUILD": 3, "DROP": 4, "BREAK": 5, "OUTRO": 6}
+NAME = {v: k for k, v in SEC.items()}
+KICK, FS = 36, 44100
+PART = 60.0                                        # the demo's length, s
+
+
+def slug(s):
+    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
+
+
+def smf(path):
+    """a format 0 file's channel messages: (tick, status, d1, d2), its tempo changes (tick, us a quarter), its PPQ"""
+    d = Path(path).read_bytes()
+    ppq = struct.unpack(">H", d[12:14])[0]
+    i, end, tick, ev, tempo = 22, len(d), 0, [], []
+    while i < end:
+        v = 0
+        while True:
+            b = d[i]
+            i += 1
+            v = v << 7 | (b & 127)
+            if b < 128:
+                break
+        tick += v
+        st = d[i]
+        if st == 0xFF:
+            t, n = d[i + 1], d[i + 2]
+            if t == 0x51:
+                tempo.append((tick, d[i + 3] << 16 | d[i + 4] << 8 | d[i + 5]))
+            i += 3 + n
+            continue
+        n = 2 if st & 0xE0 == 0xC0 else 3
+        ev.append((tick, st, d[i + 1], d[i + 2] if n == 3 else 0))
+        i += n
+    return ev, tempo, ppq
+
+
+def sec_of(tick, tempo, ppq):
+    """a tick in seconds through the tempo map"""
+    t, last, us = 0.0, 0, 500000
+    for tk, u in tempo:
+        if tk >= tick:
+            break
+        t += (tk - last) * us / ppq / 1e6
+        last, us = tk, u
+    return t + (tick - last) * us / ppq / 1e6
+
+
+def render(job):
+    exe, work, g, s, seed, e, v = job
+    out = work / f"g{g}s{s}"
+    r = subprocess.run([exe, str(g), str(s), seed, str(e), str(v), "1", str(out)], capture_output=True, text=True,
+                       check=True)
+    return g, s, out, r.stdout
+
+
+def parse(txt):
+    m = re.search(r"vizzbox_render: (.+?) / (.+?), seed", txt)
+    info = {"genre": m.group(1), "sub": m.group(2)}
+    m = re.search(r"tempo (\d+) BPM, key (\S+ \S+) \(root (\d+), scale 0x([0-9A-F]+)\)", txt)
+    info.update(bpm=int(m.group(1)), key=m.group(2), root=int(m.group(3)), mask=int(m.group(4), 16))
+    info["sounds"] = dict(re.findall(r"^  (T\d) (.+)$", txt, re.M))
+    info["secs"] = [(float(t), SEC[n], int(b)) for t, n, b in re.findall(r"^\s+([\d.]+) s\s+(\w+)\s+(\d+) bars", txt, re.M)]
+    m = re.search(r"([\d.]+) s, peak (-?[\d.]+) dBFS, RMS (-?[\d.]+) dBFS, voices stolen (\d+)", txt)
+    info.update(length=float(m.group(1)), peak=float(m.group(2)), rms=float(m.group(3)), stolen=int(m.group(4)))
+    return info
+
+
+def db(x):
+    return 20.0 * np.log10(max(float(x), 1e-9))
+
+
+def rms(x):
+    return db(np.sqrt(np.mean(x.astype(np.float64) ** 2))) if len(x) else -180.0
+
+
+def checks(info, wavp, midp):
+    with wave.open(str(wavp)) as w:
+        x = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16).astype(np.float64).reshape(-1, 2) / 32768.0
+    ev, tempo, ppq = smf(midp)
+    bar = 240.0 / info["bpm"]
+    c = {}
+    # the notes outside the key: bass, chords, lead and arp (T5 a break on SLICE: its notes are slices; the FX not)
+    melodic = {2, 3, 4} | (set() if info["sounds"].get("T5", "").startswith("SLICE") else {5})
+    n_on = [(t, (st & 15) + 1, d1) for t, st, d1, d2 in ev if st & 0xF0 == 0x90 and d2]
+    mel = [d1 for t, ch, d1 in n_on if ch in melodic]
+    out = [d1 for d1 in mel if not (info["mask"] >> ((d1 - info["root"]) % 12)) & 1]
+    c["outside"] = (len(out), len(mel))
+    # kick and bass: of the kicks, how many the bass strikes with (the same 1/16)
+    q16 = ppq // 4
+    kicks = [t for t, ch, d1 in n_on if ch == 1 and d1 == KICK]
+    bass = {t // q16 for t, ch, d1 in n_on if ch == 2}
+    c["kickbass"] = (sum(1 for t in kicks if (t + q16 // 2) // q16 in bass or t // q16 in bass), len(kicks))
+    # the sections as CC 104 / CC 106 say them (the bar's first step: CC 106 0), in seconds
+    secs, cur, at = [], 0, {}
+    for t, st, d1, d2 in ev:
+        if st == 0xBF and d1 in (104, 106):
+            at[d1] = d2
+            if d1 == 106 and d2 == 0 and at.get(104):
+                secs.append((sec_of(t, tempo, ppq), at[104], 0))
+    info["secs_midi"] = secs
+    # the first DROP after a BUILD (form V has none: the first DROP; form A no DROP: the first BREAK): the jump into it,
+    # the quietest 1/16 in the beat before it, the riser in the section before it
+    drop = next((i for i in range(1, len(secs)) if secs[i][1] == 4 and secs[i - 1][1] == 3), None)
+    if drop is None:
+        drop = next((i for i in range(1, len(secs)) if secs[i][1] == 4), None)
+    if drop is None:
+        drop = next((i for i in range(1, len(secs)) if secs[i][1] == 5), None)
+    if drop is not None:
+        c["into"] = f"{NAME[secs[drop - 1][1]]} → {NAME[secs[drop][1]]}"
+        t0, tb = secs[drop][0], secs[drop - 1][0]
+        a = x[int((t0 - 4 * bar) * FS):int(t0 * FS)]
+        b = x[int(t0 * FS):int((t0 + 4 * bar) * FS)]
+        c["jump"] = rms(b) - rms(a)
+        last = x[int((t0 - bar / 4) * FS):int(t0 * FS)]
+        w16 = max(1, int(bar / 16 * FS))
+        c["gap"] = min(rms(last[i:i + w16]) for i in range(0, len(last) - w16 + 1, w16)) - rms(a)
+        fx = [t for t, ch, d1 in n_on if ch == 6 and tb - 0.005 <= sec_of(t, tempo, ppq) < t0 - 0.005]
+        c["riser"] = len(fx)
+        c["drop_t"], c["build_t"] = t0, tb
+    return c
+
+
+def part(info, c, wavp, mp3, tag):
+    """about 60 s from the BUILD into the DROP, on bar lines, faded in and out; its peak and RMS"""
+    bar = 240.0 / info["bpm"]
+    t0 = c.get("drop_t", 60.0)
+    before = round(0.6 * PART / bar)                # (60 %: the BUILD and what leads into it)
+    start = max(0.0, t0 - before * bar)
+    end = min(start + round(PART / bar) * bar, info["length"])
+    with wave.open(str(wavp)) as w:
+        w.setpos(int(start * FS))
+        x = np.frombuffer(w.readframes(int((end - start) * FS)), dtype=np.int16).astype(np.float64).reshape(-1, 2)
+    fi, fo = int(0.25 * FS), int(2.0 * FS)
+    env = np.ones(len(x))
+    env[:fi] = np.linspace(0.0, 1.0, fi)
+    env[-fo:] = np.minimum(env[-fo:], np.linspace(1.0, 0.0, fo))
+    y = np.clip(np.round(x * env[:, None]), -32768, 32767).astype(np.int16)
+    tmp = mp3.with_suffix(".part.wav")
+    with wave.open(str(tmp), "wb") as w:
+        w.setnchannels(2)
+        w.setsampwidth(2)
+        w.setframerate(FS)
+        w.writeframes(y.tobytes())
+    subprocess.run(["ffmpeg", "-v", "error", "-y", "-i", str(tmp), "-codec:a", "libmp3lame", "-b:a", "128k",
+                    "-metadata", f"title={tag}", "-metadata", "artist=Vizzbox", str(mp3)], check=True)
+    tmp.unlink()
+    z = y.astype(np.float64) / 32768.0
+    return start, end, db(np.max(np.abs(z))), rms(z)
+
+
+def main(argv):
+    exe, out = argv[0], Path(argv[1])
+    seed = argv[2] if len(argv) > 2 else "5EED"
+    e = int(argv[3]) if len(argv) > 3 else 70
+    v = int(argv[4]) if len(argv) > 4 else 40
+    pick = [(int(argv[i]), int(argv[i + 1])) for i in range(5, len(argv) - 1, 2)]
+    work = out / ".work"
+    work.mkdir(parents=True, exist_ok=True)
+    jobs = [(exe, work, g, s, seed, e, v) for g in range(10) for s in range(NSUB[g]) if not pick or (g, s) in pick]
+    with ThreadPoolExecutor(os.cpu_count() or 2) as pool:
+        done = list(pool.map(render, jobs))
+    rows, fail = [], 0
+    for g, s, base, txt in done:
+        info = parse(txt)
+        n = sum(NSUB[:g]) + s + 1
+        name = f"{n:02d}-{slug(info['genre'])}-{slug(info['sub'])}"
+        c = checks(info, base.with_suffix(".wav"), base.with_suffix(".mid"))
+        tag = f"Vizzbox - {info['genre']} / {info['sub']} (seed {seed})"
+        a, b, pk, rm = part(info, c, base.with_suffix(".wav"), out / f"{name}.mp3", tag)
+        shutil.copy(base.with_suffix(".mid"), out / f"{name}.mid")
+        rows.append((n, name, info, c, a, b, pk, rm))
+        bad = []
+        if info["peak"] >= -0.3:
+            bad.append("clips")
+        if info["stolen"]:
+            bad.append(f"{info['stolen']} voices stolen")
+        if c["outside"][0]:
+            bad.append(f"{c['outside'][0]} notes outside the key")
+        if "drop_t" not in c:
+            bad.append("no DROP or BREAK to lead into")
+        fail |= bool(bad)
+        print(f"{n:2d} {info['genre']} / {info['sub']}: {info['bpm']} BPM {info['key']}, part {a:.1f}..{b:.1f} s, "
+              f"peak {pk:.1f} RMS {rm:.1f} dBFS; song {info['length']:.0f} s peak {info['peak']:.1f}; kick+bass "
+              f"{c['kickbass'][0]}/{c['kickbass'][1]}; jump {c.get('jump', 0):+.1f} dB, gap {c.get('gap', 0):+.1f} dB, "
+              f"riser {c.get('riser', 0)} ({c.get('into', '-')})" + (f"  !! {', '.join(bad)}" if bad else ""))
+    rows.sort()
+    rm_all = [r[7] for r in rows]
+    med = float(np.median(rm_all))
+    lines = ["<!-- BEGIN GENERATED by tools/vizzbox_demos.py: do not edit -->",
+             f"Seed `{seed}`, ENERGIE {e}, VARIATION {v}, LÄNGE NORMAL. Spitze und RMS: der MP3-Ausschnitt (vor der "
+             f"Kodierung), dBFS. RMS über alle: {min(rm_all):.1f} bis {max(rm_all):.1f} dBFS, Median {med:.1f}.", "",
+             "| # | Genre | Subgenre | Seed | BPM | Tonart | Spitze | RMS | Ausschnitt | in | Song | Dateien |",
+             "| ---: | --- | --- | --- | ---: | --- | ---: | ---: | --- | --- | ---: | --- |"]
+    for n, name, info, c, a, b, pk, rm in rows:
+        lines.append(f"| {n} | {info['genre']} | {info['sub']} | `{seed}` | {info['bpm']} | {info['key']} | {pk:.1f} | "
+                     f"{rm:.1f} | {a // 60:.0f}:{a % 60:04.1f} – {b // 60:.0f}:{b % 60:04.1f} | {c.get('into', '–')} | "
+                     f"{info['length'] // 60:.0f}:{info['length'] % 60:02.0f} | [MP3]({name}.mp3) · [MIDI]({name}.mid) |")
+    lines += ["", "Geprüft am ganzen Song (Render und MIDI-Datei):", "",
+              "| # | Subgenre | Spitze Song | Stimmen gestohlen | Noten außerhalb der Tonart | Kick mit Bass | "
