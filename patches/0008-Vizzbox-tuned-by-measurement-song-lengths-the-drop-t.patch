+              "| ---: | --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | --- |"]
+    for n, name, info, c, a, b, pk, rm in rows:
+        k, kn = c["kickbass"]
+        o, on = c["outside"]
+        sec = " ".join(f"{'?IGBDRO'[t]}{bars}" for _, t, bars in info["secs"])
+        lines.append(f"| {n} | {info['sub']} | {info['peak']:.1f} | {info['stolen']} | {o} von {on} | "
+                     f"{k} von {kn} | {c.get('jump', 0):+.1f} dB | {c.get('gap', 0):+.1f} dB | {c.get('riser', 0)} | "
+                     f"{sec} |")
+    lines.append("<!-- END GENERATED -->")
+    with open(out / "levels.tsv", "w") as f:       # (tools/vizzbox_level.py reads it)
+        for n, name, info, c, a, b, pk, rm in rows:
+            f.write(f"{n - 1}\t{rm:.2f}\t{pk:.2f}\n")
+    readme = out / "README.md"
+    txt = readme.read_text() if readme.exists() else "# Vizzbox – Demos\n\n<!-- BEGIN GENERATED -->\n<!-- END GENERATED -->\n"
+    txt = re.sub(r"<!-- BEGIN GENERATED.*?<!-- END GENERATED -->", lambda m: "\n".join(lines), txt, flags=re.S)
+    readme.write_text(txt)
+    print(f"RMS {min(rm_all):.1f} .. {max(rm_all):.1f} dBFS, median {med:.1f}")
+    if os.environ.get("KEEP") != "1":
+        shutil.rmtree(work)
+    return 1 if fail else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
