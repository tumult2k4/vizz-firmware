index 0000000..db0887f
--- /dev/null
+++ b/tools/vizzbox_level.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-only
+"""(Vizzbox) The subgenres at one loudness (BRIEF-VIZZBOX.md 3.6: RMS within +-3 dB over all demos): each subgenre's
+demo part (tools/vizzbox_demos.py) measured for some seeds, the mean RMS (dB) brought to TARGET by a trim on all six
+tracks' levels (P_LEVEL steps of 0.5 dB, added to what is there; up by at most MAXUP), written into firmware/src/producer_tables.c between
+its LEVEL markers. Build build/host/vizzbox_render again after it and repeat until the trims stay.
+  vizzbox_level.py RENDER [SEED ...]        (default seeds 5EED 1234 BEEF)"""
+import re
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+TABLES = ROOT / "firmware" / "src" / "producer_tables.c"
+TARGET = -22.5
+MAXUP = 8                                          # (at most 4 dB up: past it the master limiter holds the loud parts
+                                                   # (fx.c LIM_T), more level would be more limiting and the roles
+                                                   # nearest P_LEVEL 127 would stop at it and leave the balance)
+
+
+def main(argv):
+    exe, seeds = argv[0], argv[1:] or ["5EED", "1234", "BEEF"]
+    rms = {}
+    for sd in seeds:
+        with tempfile.TemporaryDirectory() as d:
+            subprocess.run([sys.executable, str(ROOT / "tools" / "vizzbox_demos.py"), exe, d, sd], check=False,
+                           stdout=subprocess.DEVNULL)
+            for line in open(Path(d) / "levels.tsv"):
+                i, r, _ = line.split("\t")
+                rms.setdefault(int(i), []).append(float(r))
+    src = TABLES.read_text()
+    m = re.search(r"VB_TRIM\[36\] = \{(.*?)\};", src, re.S)
+    old = [int(x) for x in m.group(1).replace("\n", " ").split(",")]
+    new = []
+    for i in range(36):
+        mean = sum(rms[i]) / len(rms[i])
+        new.append(max(-40, min(MAXUP, old[i] + round(2.0 * (TARGET - mean)))))
+        print(f"{i:2d} RMS {mean:6.2f} ({' '.join(f'{x:.1f}' for x in rms[i])})  trim {old[i]:+d} -> {new[i]:+d}")
+    body, line = [], "static const int8_t VB_TRIM[36] = {"
+    for i, v in enumerate(new):
+        piece = f"{v}" + (", " if i < 35 else "};")
+        if len(line) + len(piece) > 119:
+            body.append(line.rstrip())
+            line = " " * 35
+        line += piece
+    body.append(line)
+    src = re.sub(r"static const int8_t VB_TRIM\[36\] = \{.*?\};", "\n".join(body), src, flags=re.S)
+    TABLES.write_text(src)
+    all_rms = [sum(v) / len(v) for v in rms.values()]
+    print(f"mean RMS {min(all_rms):.1f} .. {max(all_rms):.1f} dBFS (target {TARGET})")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))
