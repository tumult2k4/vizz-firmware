-/* PLAY and stop; SEQ MIDI OUT OFF; the GROOVEBOX */
+/* how many of CC 104 .. 109 (channel 16) came in order from event `from` on */
+static uint32_t six_at(uint32_t from)
+{
+    uint32_t i, n = 0;
+    for (i = from; i < nev && n < 6u; i++)
+        if (ev[i].st == 0xBFu && ev[i].d1 >= 104u && ev[i].d1 <= 109u) {
+            if (ev[i].d1 != 104u + n)
+                return n;
+            n++;
+        }
+    return n;
+}
+/* PLAY and stop; SEQ MIDI OUT OFF, then on while playing; USB coming up; the GROOVEBOX */
 static void case_transport(void)
 {
     uint32_t i, n103 = 0, fa = 0, first104 = 0, any = 0;
@@ -333,9 +345,20 @@ static void case_transport(void)
     for (i = 0, any = 0; i < nev; i++)
         any |= ev[i].st == 0xBFu && ev[i].d1 >= 104u && ev[i].d1 <= 109u;
     ok(!any, "SEQ MIDI OUT OFF: CC 104 .. 109 sent");
+    nev = 0;
+    CPU2_BYTE &= ~8u;                               /* SEQ MIDI OUT on while playing: the six at once (BRIEF 5) */
+    run_s(0.01);
+    ok(six_at(0) == 6u, "SEQ MIDI OUT turned on: %u of the six in 10 ms", six_at(0));
+    nev = 0;
+    usb.config = 0;                                 /* USB gone and back: the six at once */
+    run_s(0.01);
+    usb.config = 1;
+    nev = 0;
+    run_s(0.01);
+    ok(six_at(0) == 6u, "USB up again: %u of the six in 10 ms", six_at(0));
     press(1u << B_PLAY);
-    CPU2_BYTE &= ~8u;
     run_s(0.5);
+    nev = 0;
     web_buttons(1u << B_HOME);                      /* the GROOVEBOX: its own music, none of it */
     run_s(0.06);
     web_buttons(1u << B_HOME | 1u << B_PLAY);
@@ -343,6 +366,9 @@ static void case_transport(void)
     web_buttons(0);
     run_s(0.5);
     ok(!vb_mode, "HOME + PLAY: still the VIZZBOX");
+    for (i = 0, any = 0; i < nev; i++)
+        any += ev[i].st == 0xBFu && ev[i].d1 >= 104u && ev[i].d1 <= 109u ? (ev[i].d1 == 104u && !ev[i].d2 ? 1u : 100u) : 0u;
+    ok(any == 1u, "into the GROOVEBOX: not CC 104 0 once (%u)", any);
     nev = 0;
     press(1u << B_PLAY);
     run_s(20.0);
