+static uint32_t vb_tail_ms(uint32_t k)
+{
+    const track_t *t = &trk[k];
+    uint32_t ms, o;
+    if (t->eng_req == ENGI_FM6) {
+        const uint8_t *p = fm6_eff[k].p;
+        uint32_t car = fm6_carriers(fm6_eff[k].alg);
+        for (o = 0, ms = 0; o < 6u; o++)
+            if ((car >> o) & 1u) {
+                const uint8_t *op = p + o * FP_OP;
+                fm6_env_t e;
+                int32_t from = 16, l, q;
+                uint32_t i, m;
+                fm6_op_env_init(&e, op, 48, 127);   /* (a low note: the slowest rate scaling; full velocity) */
+                for (i = 0; i < 3u; i++)
+                    if ((l = ((fm6_scaleout(op[FP_L1 + i]) >> 1) << 6) + e.outlevel - 4256) > from)
+                        from = l;
+                q = ((op[FP_R1 + 3] * 41) >> 6) + e.rscale;
+                q = q > 63 ? 63 : q;
+                m = op[FP_L1 + 3] && ((fm6_scaleout(op[FP_L1 + 3]) >> 1) << 6) + e.outlevel - 4256 > 16 ? 12000u :
+                    (uint32_t)(((uint32_t)(from - 16) << 16) / ((4u + (q & 3)) << (2 + FM6_LG_N + (q >> 2)))) * FM6_N /
+                    (FS / 1000u);
+                ms = m > ms ? m : ms;
+            }
+    } else if (t->p[P_ESYNC])
+        ms = 60000u / (vb.bpm ? vb.bpm : 120u) * ESYNC_UNITS[esync_idx(t->p[P_REL])] / 96u * 185u / 100u;
+    else
+        ms = TIME_MS_X10[t->p[P_REL] & 127] * 185u / 1000u;
+    return (ms > 12000u ? 12000u : ms) + 40u;
+}
+static uint32_t vb_ring_ms(uint32_t l)              /* the drum track's lane l, the user's sound on it */
+{
+    const track_t *t = &trk[R_D];
+    const int16_t *p = t->p;
+    int32_t d;
+    uint32_t ms;
