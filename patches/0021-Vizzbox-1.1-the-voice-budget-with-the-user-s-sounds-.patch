+/* (1.1, BRIEF-VIZZBOX-1.1.md 7) a sound the user chose: how long its voices last past their note (producer.c vb_tail_ms,
+ * vb_ring_ms) never shorter than they do: every factory sound one note held 0.5 s on T1, then off, until its voices
+ * end; the kits each lane; DRUM's and DRUM-X's DECAY knob, a lane's DECAY, DRUM-X's MORPH moved */
+static uint32_t act1(void)
+{
+    uint32_t i, n = 0;
+    for (i = 0; i < NVOICE; i++)
+        n += trk[0].v[i].active && trk[0].v[i].stage != 4u;
+    return n;
+}
+static uint32_t ring_of(uint32_t note, double hold)  /* T1: a note held, then off: ms until its voices end */
+{
+    uint32_t ms = 0;
+    trk_note_on(&trk[0], note, 127);
+    run_s(hold);
+    trk_note_off(&trk[0], note);
+    while (act1() && ms < 20000u) {
+        run_s(0.01);
+        ms += 10u;
+    }
+    return ms;
+}
+static void case_tails(void)
+{
+    static const int8_t DV[4][3] = {{40, 0, 64}, {100, 0, 64}, {64, -30, 127}, {64, 40, 0}};   /* DECAY, a lane's, MORPH */
+    uint32_t e, p, l, v, n = 0, est, ms;
+    snprintf(tag, sizeof tag, "the tails of the user's sounds");
+    boot();
+    vb_mode_set(0);                                 /* (T1 free: the GROOVEBOX, stopped) */
+    run_s(0.2);
+    sel_set(0);
+    for (e = 0; e < NENGINES; e++) {
+        if (!eng_ok(e) || set_engine_of(&trk[0], e))
+            continue;
+        for (p = 0; p < ENGINES[e]->npresets; p++) {
+            apply_preset_to(&trk[0], p);
+            run_s(0.2);
+            if (e != ENGI_DRUM && e != ENGI_DRUMX) {
+                ms = ring_of(60, 0.5);
+                est = vb_tail_ms(0);
+                ok(est >= ms, "%s %s: %u ms, estimated %u", ENGINES[e]->name, ENGINES[e]->presets[p].name, ms, est);
+                n++;
+                continue;
+            }
+            for (v = 0; v < (p ? 1u : 5u); v++) {   /* (the first kit: the knobs moved too) */
+                if (v) {
+                    trk[0].p[P_E3] = DV[v - 1u][0];
+                    if (e == ENGI_DRUMX)
+                        trk[0].p[P_E0] = DV[v - 1u][2];
+                }
+                for (l = 0; l < NLANE; l++) {
+                    if (v)
+                        trk[0].p[P_LDECAY0 + l] = DV[v - 1u][1];
+                    run_s(0.05);
