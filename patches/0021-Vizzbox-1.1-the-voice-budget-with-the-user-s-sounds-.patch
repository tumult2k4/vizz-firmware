+static uint8_t vb_kpk[2] __attribute__((section(".pool")));
+static uint32_t vb_kup[4] __attribute__((section(".pool")));   /* when the last four keys were let go (fm1_ms) */
+static uint32_t vb_kwas __attribute__((section(".pool")));      /* the white keys held at the last look */
+static uint32_t vb_keys(void)
+{
+    const track_t *t = TSEL;
+    const engine_t *e = ENGINES[t->eng_req % NENGINES];
+    uint32_t k, n = 0, held = 0, tail;
+    if (!vb_mode || !vb.own)
+        return 0;
+    for (k = 0; k < 27u; k++)
+        if (((fm1_in.notes >> k) & 1u) && !key_black(k))
+            held |= 1u << k;
+    for (k = 0; k < 27u; k++)
+        if (((vb_kwas & ~held) >> k) & 1u) {        /* (let go: when) */
+            vb_kup[3] = vb_kup[2];
+            vb_kup[2] = vb_kup[1];
+            vb_kup[1] = vb_kup[0];
+            vb_kup[0] = fm1_ms | 1u;
+        }
+    vb_kwas = held;
+    if (song.sel != R_D && !e->oneshot && t->p[P_VOICE] != V_POLY)
+        return 0;
+    tail = song.sel == R_D ? 1000u : vb_tail_ms(song.sel);
+    for (k = 0; k < 27u; k++)
+        n += (held >> k) & 1u;
+    for (k = 0; k < 4u; k++)
+        n += vb_kup[k] && fm1_ms - vb_kup[k] < tail;
+    if (t->p[P_CHRD] != CH_OFF)
+        n *= t->p[P_CHRD] == CH_DIA7 ? 4u : 3u;
+    return n > 6u ? 6u : n;
+}
