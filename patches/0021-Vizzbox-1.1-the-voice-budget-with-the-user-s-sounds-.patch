+        d = (x->a[DXP_DECAY] > x->b[DXP_DECAY] ? x->a[DXP_DECAY] : x->b[DXP_DECAY]) + p[P_E3] - 64;
+        return dx_tau((uint32_t)clamp(d, 0, 127)) / 100u + 40u;
+    }
+    if (t->eng_req != ENGI_DRUM)
+        return vb_tail_ms(R_D) + 250u;               /* (another sound on the lanes: a lane note's length and its tail) */
+    {
+        const preset_t *pr = ENGINES[ENGI_DRUM]->presets;
+        uint32_t i = t->preset % NELEM(VB_DRING);
+        if (pr[i].e[0] != p[P_E0])                  /* (its KIT changed: a preset with that one) */
+            for (i = 0; i < NELEM(VB_DRING) && pr[i].e[0] != p[P_E0]; i++)
+                ;
+        if (i == NELEM(VB_DRING))
+            return 6000u;
+        ms = 64u * VB_DRING[i][l];
+        if (p[P_E1] < pr[i].e[1] || p[P_E6] != pr[i].e[6])
+            ms *= 2u;
+        d = p[P_E3] - pr[i].e[3] + p[P_LDECAY0 + l];
